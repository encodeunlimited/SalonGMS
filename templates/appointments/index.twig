{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex items-center justify-between" x-data="{ modalOpen: false }">
    <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Appointments</h2>
        <p class="text-sm text-gray-500 mt-1">Manage your schedule and bookings.</p>
    </div>
    {% if auth_user.role != 'cashier' %}
    <button @click="modalOpen = true" class="bg-salon-accent text-white px-5 py-3 rounded-lg text-sm font-medium hover:bg-yellow-600 shadow-sm transition-colors flex items-center">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        New Appointment
    </button>
    {% endif %}

    <!-- Alpine Modal -->
    <div x-show="modalOpen" x-cloak class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            
            <div x-show="modalOpen" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="modalOpen = false"></div>

            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

            <div x-show="modalOpen" x-transition class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                                Book New Appointment
                            </h3>
                            <div class="mt-4">
                                <!-- HTMX Form -->
                                <form hx-post="/web/appointments" hx-target="#appointment-table-body" hx-swap="afterbegin" @htmx:after-request="if($event.detail.elt === $el && $event.detail.successful && !$event.detail.xhr.response.includes('id=\'form-messages\'')) { modalOpen = false; $el.reset(); window.location.reload(); }">
                                    <div id="form-messages" class="mb-4"></div>
                                    <div class="mb-4">
                                        <label class="block text-sm font-medium text-gray-700">Customer</label>
                                        <select name="customer_id" required hx-get="/web/appointments/services" hx-target="#service_selection_wrapper" hx-swap="innerHTML" x-data x-init="new TomSelect($el, {
                                            maxOptions: 50,
                                            create: function(input, callback) {
                                                $dispatch('open-customer-modal', { input: input, callback: callback });
                                            },
                                            onFocus: function() { this.clear(); }
                                        })" class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent sm:text-sm">
                                            <option value="">Search by Name or Phone...</option>
                                            {% for customer in customers %}
                                                <option value="{{ customer.id }}">{{ customer.name }} - {{ customer.phone }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div id="service_selection_wrapper">
                                        <div class="mb-4">
                                            <label class="block text-sm font-medium text-gray-700">Service</label>
                                            <select id="service_id" name="service_id" required hx-get="/web/appointments/stylists" hx-target="#stylist_id" hx-swap="innerHTML"
                                                    x-data="{ tom: null }" 
                                                    x-init="if (!$el.tomselect) { tom = new TomSelect($el, {maxOptions: 50, onFocus: function() { this.clear(); }}); }"
                                                    @htmx:before-swap.window="if ($event.detail.target.id === 'service_id' && tom) { tom.destroy(); tom = null; }"
                                                    @htmx:after-swap.window="if ($event.detail.target.id === 'service_id') { tom = new TomSelect($el, {maxOptions: 50, onFocus: function() { this.clear(); }}); }"
                                                    class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                                <option value="">Select a service...</option>
                                                <optgroup label="Regular Services">
                                                    {% for service in services %}
                                                        <option value="{{ service.id }}">{{ service.name }}</option>
                                                    {% endfor %}
                                                </optgroup>
                                                {% if packages|length > 0 %}
                                                <optgroup label="Buy New Package (Select Initial Service)">
                                                    {% for package in packages %}
                                                        {% if package.services|length > 0 %}
                                                            {% for ps in package.services %}
                                                                <option value="pkg_{{ package.id }}_srv_{{ ps.id }}">{{ package.name }} - Initial: {{ ps.name }}</option>
                                                            {% endfor %}
                                                        {% endif %}
                                                    {% endfor %}
                                                </optgroup>
                                                {% endif %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="block text-sm font-medium text-gray-700">Stylist</label>
                                        <div id="stylist_id" class="mt-1 min-h-[50px]">
                                            <div class="text-sm text-gray-500 py-2">Select a service first to see available stylists...</div>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="block text-sm font-medium text-gray-700">Booking Type</label>
                                        <select name="booking_type" required class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                            {% for btype in booking_types %}
                                                <option value="{{ btype }}">{{ btype }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4 mb-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Date</label>
                                            <input type="date" name="date" required class="mt-1 focus:ring-salon-accent focus:border-salon-accent block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2 px-3 border">
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Time</label>
                                            <select name="time" required class="mt-1 focus:ring-salon-accent focus:border-salon-accent block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2 px-3 border">
                                                <option value="">Select time...</option>
                                                {% for hour in open_hour..close_hour %}
                                                    {% for min in ['00', '15', '30', '45'] %}
                                                        <option value="{{ '%02d'|format(hour) }}:{{ min }}">{{ '%02d'|format(hour) }}:{{ min }}</option>
                                                    {% endfor %}
                                                {% endfor %}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mt-5 sm:mt-6 sm:flex sm:flex-row-reverse">
                                        <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-5 py-3 bg-salon-dark text-base font-medium text-white hover:bg-salon-navy focus:outline-none sm:ml-3 sm:w-auto sm:text-sm">
                                            Save Appointment
                                            <!-- Spinner -->
                                            <svg class="animate-spin ml-2 h-5 w-5 text-white htmx-indicator" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                            </svg>
                                        </button>
                                        <button type="button" @click="modalOpen = false" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-5 py-3 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Calendar View -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 lg:col-span-2 h-[600px] overflow-hidden flex flex-col">
        <h3 class="text-base font-bold text-gray-900 mb-4 flex-shrink-0">Calendar</h3>
        <div id="calendar" class="flex-1 w-full h-full"></div>
    </div>

    <!-- Data Table View -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col h-[600px]" id="appointments-list-container">
        <div class="p-6 border-b border-gray-100 flex-shrink-0">
            <h3 class="text-base font-bold text-gray-900">Upcoming</h3>
        </div>
        <div class="flex-1 overflow-y-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 sticky top-0">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Client</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200" id="appointment-table-body">
                    {% for apt in appointments %}
                        {% include 'appointments/list_item.twig' with {'appointment': apt} %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="px-4 pb-4">
            {% include "partials/pagination.twig" with {'hx_url': '/web/appointments', 'hx_target': '#appointments-list-container', 'hx_select': '#appointments-list-container'} %}
        </div>
    </div>
</div>

<!-- Quick Customer Registration Modal -->
<div x-data="{ 
        showCustModal: false, 
        phone: '', 
        name: '',
        email: '',
        callback: null,
        submitForm() {
            if(!this.name) return;
            fetch('/web/api/customers', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: this.name, phone: this.phone, email: this.email })
            })
            .then(res => res.json())
            .then(data => {
                this.showCustModal = false;
                if(this.callback) {
                    // Resolve the Tom Select callback with the new customer ID and Text
                    this.callback({ value: data.id, text: data.name + ' - ' + (data.phone || '') });
                }
                this.name = ''; this.email = ''; this.phone = '';
            });
        }
     }" 
     @open-customer-modal.window="showCustModal = true; phone = $event.detail.input; callback = $event.detail.callback;"
     class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true" x-show="showCustModal" x-cloak>
    
    <div x-show="showCustModal" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div x-show="showCustModal" @click.away="showCustModal = false; if(callback) callback(false);" x-transition class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-md">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                            <h3 class="text-base font-semibold leading-6 text-gray-900 mb-4">Register New Customer</h3>
                            <form @submit.prevent="submitForm">
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700">Phone</label>
                                    <input type="text" x-model="phone" required class="mt-1 block w-full py-2 px-3 border border-gray-300 rounded-md shadow-sm sm:text-sm">
                                </div>
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700">Name</label>
                                    <input type="text" x-model="name" required class="mt-1 block w-full py-2 px-3 border border-gray-300 rounded-md shadow-sm sm:text-sm" placeholder="John Doe">
                                </div>
                                <div class="mb-4">
                                    <label class="block text-sm font-medium text-gray-700">Email (Optional)</label>
                                    <input type="email" x-model="email" class="mt-1 block w-full py-2 px-3 border border-gray-300 rounded-md shadow-sm sm:text-sm">
                                </div>
                                <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
                                    <button type="submit" class="inline-flex w-full justify-center rounded-md bg-salon-accent px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-yellow-600 sm:ml-3 sm:w-auto">Register & Select</button>
                                    <button type="button" @click="showCustModal = false; if(callback) callback(false);" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    var calendar;
    document.addEventListener("DOMContentLoaded", function() {
        var calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: sessionStorage.getItem('calendarView') || 'timeGridWeek',
            initialDate: sessionStorage.getItem('calendarDate') || new Date(),
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            height: '100%',
            slotMinTime: '08:00:00',
            slotMaxTime: '20:00:00',
            allDaySlot: false,
            // Fetching from DB
            events: [
                {% for apt in appointments %}
                {
                    title: '{{ apt.service|escape('js') }} - {{ apt.customer|escape('js') }}',
                    start: '{{ apt.date }}T{{ apt.time }}:00',
                    {% if apt.end_time %}end: '{{ apt.date }}T{{ apt.end_time }}:00',{% endif %}
                    backgroundColor: '#1e293b',
                    borderColor: '#1e293b',
                    extendedProps: {
                        id: '{{ apt.id }}',
                        customer: '{{ apt.customer|escape('js') }}',
                        customer_phone: '{{ apt.customer_phone|default('')|escape('js') }}',
                        customer_image: '{{ apt.customer_image|default('') }}',
                        service: '{{ apt.service|escape('js') }}',
                        stylist: '{{ apt.stylist|escape('js') }}',
                        stylist_image: '{{ apt.stylist_image|default('') }}',
                        booking_type: '{{ apt.booking_type|default('In Salon')|escape('js') }}',
                        status: '{{ apt.status|escape('js') }}',
                        invoice_id: '{{ apt.invoice_id|default('') }}'
                    }
                }{% if not loop.last %},{% endif %}
                {% endfor %}
            ],
            eventDidMount: function(info) {
                var props = info.event.extendedProps;
                var custImg = props.customer_image ? `<img src="${props.customer_image}" class="w-10 h-10 rounded-full object-cover border border-gray-200">` : `<div class="w-10 h-10 rounded-full bg-salon-dark text-white flex items-center justify-center font-bold text-lg">${props.customer.charAt(0).toUpperCase()}</div>`;
                var stylistImg = props.stylist_image ? `<img src="${props.stylist_image}" class="w-6 h-6 rounded-full object-cover border border-gray-200">` : `<div class="w-6 h-6 rounded-full bg-gray-300 text-gray-700 flex items-center justify-center font-bold text-xs">${props.stylist.charAt(0).toUpperCase()}</div>`;

                var buttonsHtml = '';
                {% if auth_user.role != 'cashier' %}
                if (props.status === 'scheduled' || props.status === 'pending') {
                    buttonsHtml = `<button hx-put="/web/appointments/${props.id}/status" hx-vals='{"status": "approved"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-blue-600 text-white rounded hover:bg-blue-700 shadow-sm transition-colors" title="Approve"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.514"></path></svg></button>
                                   <button class="p-1.5 inline-flex items-center justify-center bg-gray-100 text-gray-400 rounded cursor-not-allowed border border-gray-200" disabled title="Done"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></button>
                                   <button class="p-1.5 inline-flex items-center justify-center bg-gray-100 text-gray-400 rounded cursor-not-allowed border border-gray-200" disabled title="Paid"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></button>
                                   <button hx-put="/web/appointments/${props.id}/status" hx-vals='{"status": "cancelled"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-red-50 text-red-600 border border-red-200 rounded hover:bg-red-100 shadow-sm transition-colors" title="Cancel Appointment"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>`;
                } else if (props.status === 'approved') {
                    buttonsHtml = `<button class="p-1.5 inline-flex items-center justify-center bg-blue-50 text-blue-400 border border-blue-200 rounded cursor-default" disabled title="Approved"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.514"></path></svg></button>
                                   <button hx-put="/web/appointments/${props.id}/status" hx-vals='{"status": "done"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-emerald-500 text-white rounded hover:bg-emerald-600 shadow-sm transition-colors" title="Done"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></button>
                                   <button class="p-1.5 inline-flex items-center justify-center bg-gray-100 text-gray-400 rounded cursor-not-allowed border border-gray-200" disabled title="Paid"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></button>
                                   <button hx-put="/web/appointments/${props.id}/status" hx-vals='{"status": "cancelled"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-red-50 text-red-600 border border-red-200 rounded hover:bg-red-100 shadow-sm transition-colors" title="Cancel Appointment"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>`;
                } else if (props.status === 'done') {
                    buttonsHtml = `<button class="p-1.5 inline-flex items-center justify-center bg-emerald-50 text-emerald-500 border border-emerald-200 rounded cursor-default" disabled title="Done"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></button>
                                   <a href="/web/pos?appointment_id=${props.id}" class="p-1.5 inline-flex items-center justify-center bg-amber-500 text-white rounded hover:bg-amber-600 shadow-sm transition-colors" title="Paid"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></a>
                                   <button class="p-1.5 inline-flex items-center justify-center bg-gray-100 text-gray-400 rounded cursor-not-allowed border border-gray-200" disabled title="Cannot cancel a done appointment"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>`;
                } else if (props.status === 'paid') {
                    buttonsHtml = `<span class="inline-flex items-center justify-center p-1.5 rounded bg-gray-900 text-white shadow-sm" title="Completed"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>`;
                } else if (props.status === 'cancelled') {
                    buttonsHtml = `<span class="inline-flex items-center justify-center p-1.5 rounded bg-red-100 text-red-800 shadow-sm" title="Cancelled"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>`;
                } else {
                    buttonsHtml = `<span class="inline-flex items-center justify-center px-2 py-1.5 rounded text-xs font-medium bg-gray-100 text-gray-800">${props.status}</span>`;
                }
                {% else %}
                    buttonsHtml = `<span class="inline-flex items-center justify-center px-2 py-1.5 rounded text-xs font-medium bg-gray-100 text-gray-800">${props.status.charAt(0).toUpperCase() + props.status.slice(1)}</span>`;
                {% endif %}

                var waMessage = `Hello ${props.customer},\n\nYour appointment for ${props.service} on ${info.event.start ? info.event.start.toLocaleString() : 'the scheduled time'} is currently: ${props.status.toUpperCase()}.\n\nStylist: ${props.stylist}`;
                
                if (props.status === 'paid' && props.invoice_id) {
                    waMessage += `\n\nView your invoice here: ${window.location.origin}/web/invoices/download/${props.invoice_id}`;
                }
                
                waMessage += `\n\nThank you for choosing our Salon!`;
                waMessage = encodeURIComponent(waMessage);

                var rawPhone = props.customer_phone ? props.customer_phone.replace(/[^0-9]/g, '') : '';
                if (rawPhone.startsWith('0')) rawPhone = '94' + rawPhone.substring(1);
                
                var waLink = rawPhone ? `https://wa.me/${rawPhone}?text=${waMessage}` : '#';
                var waDisabled = !rawPhone ? 'opacity-50 cursor-not-allowed' : 'hover:bg-green-600';
                
                var tooltipContent = `
                    <div class="p-2 w-56 text-left font-sans">
                        <div class="flex items-center space-x-3 mb-2 border-b border-gray-100 pb-2">
                            ${custImg}
                            <div>
                                <div class="font-bold text-sm text-gray-900">${props.customer}</div>
                                <div class="text-[10px] text-gray-500 uppercase tracking-wide">${props.booking_type}</div>
                            </div>
                        </div>
                        <div class="mb-2">
                            <span class="text-[10px] font-semibold text-gray-400 uppercase">Service</span>
                            <div class="text-sm font-medium text-gray-800">${props.service}</div>
                        </div>
                        <div class="mb-2">
                            <span class="text-[10px] font-semibold text-gray-400 uppercase">Stylist</span>
                            <div class="flex items-center space-x-2 mt-1">
                                ${stylistImg}
                                <span class="text-sm text-gray-700">${props.stylist}</span>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-t border-gray-100">
                            <div class="flex items-center gap-1 justify-center mt-1">
                                ${buttonsHtml}
                                <a href="${waLink}" target="_blank" class="p-1.5 inline-flex items-center justify-center bg-green-500 text-white rounded shadow-sm transition-colors ${waDisabled}" ${!props.customer_phone ? 'onclick="event.preventDefault(); window.dispatchEvent(new CustomEvent(\'show-toast\', {detail: {type: \'error\', message: \'No phone number available\'}}));"' : ''} title="Send WhatsApp">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                                 </a>
                            </div>
                        </div>
                    </div>
                `;

                tippy(info.el, {
                    content: tooltipContent,
                    allowHTML: true,
                    theme: 'light',
                    placement: 'top',
                    interactive: true,
                    appendTo: document.body,
                    animation: 'scale',
                    duration: [200, 150],
                    onMount(instance) {
                        htmx.process(instance.popper);
                    }
                });
            }
        });
        calendar.render();
    });

    document.body.addEventListener('refresh-calendar', function() {
        if (calendar) {
            sessionStorage.setItem('calendarDate', calendar.getDate().toISOString());
            sessionStorage.setItem('calendarView', calendar.view.type);
        }
        window.location.reload();
    });
</script>
<style>
    /* FullCalendar Tweaks to match Inter font */
    .fc { font-family: 'Inter', sans-serif; }
    .fc-theme-standard td, .fc-theme-standard th { border-color: #f1f5f9; }
    .fc-theme-standard .fc-scrollgrid { border-color: #e2e8f0; }
    .fc .fc-button-primary {
        background-color: #0f172a;
        border-color: #0f172a;
    }
    .fc .fc-button-primary:not(:disabled):active, .fc .fc-button-primary:not(:disabled).fc-button-active {
        background-color: #1e293b;
        border-color: #1e293b;
    }
</style>
{% endblock %}

