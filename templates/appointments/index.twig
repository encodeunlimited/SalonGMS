{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex items-center justify-between" x-data="{ modalOpen: false }">
    <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Appointments</h2>
        <p class="text-sm text-gray-500 mt-1">Manage your schedule and bookings.</p>
    </div>
    <button @click="modalOpen = true" class="bg-salon-accent text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-yellow-600 shadow-sm transition-colors flex items-center">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        New Appointment
    </button>

    <!-- Alpine Modal -->
    <div x-show="modalOpen" class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true" style="display: none;">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            
            <div x-show="modalOpen" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="modalOpen = false"></div>

            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

            <div x-show="modalOpen" x-transition class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
                                Book New Appointment
                            </h3>
                            <div class="mt-4">
                                <!-- HTMX Form -->
                                <form hx-post="/web/appointments" hx-target="#appointment-table-body" hx-swap="afterbegin" @htmx:after-request="if($event.detail.successful && !$event.detail.xhr.response.includes('id=\'form-messages\'')) { modalOpen = false; $el.reset(); window.location.reload(); }">
                                    <div id="form-messages" class="mb-4"></div>
                                    <div class="mb-4">
                                        <label class="block text-sm font-medium text-gray-700">Customer Name</label>
                                        <input type="text" name="customer_name" required class="mt-1 focus:ring-salon-accent focus:border-salon-accent block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2 px-3 border" placeholder="Jane Doe">
                                    </div>
                                    <div class="mb-4">
                                        <label class="block text-sm font-medium text-gray-700">Service</label>
                                        <select name="service" class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                            <option>Haircut</option>
                                            <option>Coloring</option>
                                            <option>Manicure</option>
                                            <option>Spa</option>
                                        </select>
                                    </div>
                                    <div class="mb-4">
                                        <label class="block text-sm font-medium text-gray-700">Stylist</label>
                                        <select name="stylist" class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                            <option>Anna</option>
                                            <option>Marcus</option>
                                            <option>Elena</option>
                                        </select>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4 mb-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Date</label>
                                            <input type="date" name="date" required class="mt-1 focus:ring-salon-accent focus:border-salon-accent block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2 px-3 border">
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700">Time</label>
                                            <input type="time" name="time" required class="mt-1 focus:ring-salon-accent focus:border-salon-accent block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2 px-3 border">
                                        </div>
                                    </div>
                                    <div class="mt-5 sm:mt-6 sm:flex sm:flex-row-reverse">
                                        <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-salon-dark text-base font-medium text-white hover:bg-salon-navy focus:outline-none sm:ml-3 sm:w-auto sm:text-sm">
                                            Save Appointment
                                            <!-- Spinner -->
                                            <svg class="animate-spin ml-2 h-5 w-5 text-white htmx-indicator" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                            </svg>
                                        </button>
                                        <button type="button" @click="modalOpen = false" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Calendar View -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 lg:col-span-2 h-[600px] overflow-hidden flex flex-col">
        <h3 class="text-base font-bold text-gray-900 mb-4 flex-shrink-0">Calendar</h3>
        <div id="calendar" class="flex-1 w-full h-full"></div>
    </div>

    <!-- Data Table View -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col h-[600px]">
        <div class="p-6 border-b border-gray-100 flex-shrink-0">
            <h3 class="text-base font-bold text-gray-900">Upcoming</h3>
        </div>
        <div class="flex-1 overflow-y-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 sticky top-0">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Client</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200" id="appointment-table-body">
                    {% for apt in appointments %}
                        {% include 'appointments/list_item.twig' with {'appointment': apt} %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    var calendar;
    document.addEventListener("DOMContentLoaded", function() {
        var calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            height: '100%',
            slotMinTime: '08:00:00',
            slotMaxTime: '20:00:00',
            allDaySlot: false,
            // Fetching from DB
            events: [
                {% for apt in appointments %}
                {
                    title: '{{ apt.service|escape('js') }} - {{ apt.customer|escape('js') }}',
                    start: '{{ apt.date }}T{{ apt.time|date("H:i:s", timezone="UTC") }}',
                    backgroundColor: '#1e293b',
                    borderColor: '#1e293b'
                }{% if not loop.last %},{% endif %}
                {% endfor %}
            ]
        });
        calendar.render();
    });
</script>
<style>
    /* FullCalendar Tweaks to match Inter font */
    .fc { font-family: 'Inter', sans-serif; }
    .fc-theme-standard td, .fc-theme-standard th { border-color: #f1f5f9; }
    .fc-theme-standard .fc-scrollgrid { border-color: #e2e8f0; }
    .fc .fc-button-primary {
        background-color: #0f172a;
        border-color: #0f172a;
    }
    .fc .fc-button-primary:not(:disabled):active, .fc .fc-button-primary:not(:disabled).fc-button-active {
        background-color: #1e293b;
        border-color: #1e293b;
    }
</style>
{% endblock %}
