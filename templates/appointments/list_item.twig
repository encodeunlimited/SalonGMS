<tr class="hover:bg-slate-50 transition-colors">
    <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-medium text-gray-900">{{ appointment.time }}</div>
        <div class="text-xs text-gray-500">{{ appointment.date }}</div>
    </td>
    <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-bold text-gray-900">{{ appointment.customer }}</div>
        <div class="text-xs text-gray-500">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                {{ appointment.service }}
            </span>
            &bull; {{ appointment.stylist }}
        </div>
    </td>
</tr>
