<tr id="apt-{{ appointment.id }}" class="hover:bg-slate-50 transition-colors">
    <td class="px-6 py-5 whitespace-nowrap">
        <div class="text-sm font-medium text-gray-900">{{ appointment.time }}</div>
        <div class="text-xs text-gray-500">{{ appointment.date }}</div>
    </td>
    <td class="px-6 py-5 whitespace-nowrap">
        <div class="flex items-center">
            {% if appointment.customer_image %}
                <img src="{{ appointment.customer_image }}" alt="{{ appointment.customer }}" class="w-8 h-8 rounded-full object-cover mr-3 shadow-sm">
            {% else %}
                <div class="w-8 h-8 rounded-full bg-salon-dark text-white flex items-center justify-center font-bold text-xs mr-3 shadow-sm">
                    {{ appointment.customer|slice(0, 1)|upper }}
                </div>
            {% endif %}
            <div>
                <div class="text-sm font-bold text-gray-900">{{ appointment.customer }}</div>
                <div class="text-xs text-gray-500 mt-1 flex items-center">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 mr-2">
                        {{ appointment.service }}
                    </span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium mr-2 {% if appointment.booking_type == 'Home Visit' %}bg-purple-100 text-purple-800{% else %}bg-blue-100 text-blue-800{% endif %}">
                        {{ appointment.booking_type|default('In Salon') }}
                    </span>
                    <span class="flex items-center">
                        {% if appointment.stylist_image %}
                            <img src="{{ appointment.stylist_image }}" class="w-4 h-4 rounded-full mr-1 object-cover" title="{{ appointment.stylist }}">
                        {% else %}
                            <div class="w-4 h-4 rounded-full bg-gray-300 text-gray-700 flex items-center justify-center font-bold mr-1" style="font-size: 0.5rem;" title="{{ appointment.stylist }}">
                                {{ appointment.stylist|slice(0, 1)|upper }}
                            </div>
                        {% endif %}
                        {{ appointment.stylist }}
                    </span>
                </div>
            </div>
        </div>
    </td>
    <td class="px-6 py-5 whitespace-nowrap text-right">
        <div class="flex items-center gap-1 justify-end">
            {% if appointment.status == 'scheduled' or appointment.status == 'pending' %}
                <button hx-put="/web/appointments/{{ appointment.id }}/status" hx-vals='{"status": "approved"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-blue-600 text-white rounded hover:bg-blue-700 shadow-sm transition-colors" title="Approve"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.514"></path></svg></button>
                <button class="p-1.5 inline-flex items-center justify-center bg-gray-100 text-gray-400 rounded cursor-not-allowed border border-gray-200" disabled title="Done"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></button>
                <button class="p-1.5 inline-flex items-center justify-center bg-gray-100 text-gray-400 rounded cursor-not-allowed border border-gray-200" disabled title="Paid"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></button>
                <button hx-put="/web/appointments/{{ appointment.id }}/status" hx-vals='{"status": "cancelled"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-red-50 text-red-600 border border-red-200 rounded hover:bg-red-100 shadow-sm transition-colors" title="Cancel Appointment"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
            {% elseif appointment.status == 'approved' %}
                <button class="p-1.5 inline-flex items-center justify-center bg-blue-50 text-blue-400 border border-blue-200 rounded cursor-default" disabled title="Approved"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.514"></path></svg></button>
                <button hx-put="/web/appointments/{{ appointment.id }}/status" hx-vals='{"status": "done"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-emerald-500 text-white rounded hover:bg-emerald-600 shadow-sm transition-colors" title="Done"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></button>
                <button class="p-1.5 inline-flex items-center justify-center bg-gray-100 text-gray-400 rounded cursor-not-allowed border border-gray-200" disabled title="Paid"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></button>
                <button hx-put="/web/appointments/{{ appointment.id }}/status" hx-vals='{"status": "cancelled"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-red-50 text-red-600 border border-red-200 rounded hover:bg-red-100 shadow-sm transition-colors" title="Cancel Appointment"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
            {% elseif appointment.status == 'done' %}
                <button class="p-1.5 inline-flex items-center justify-center bg-emerald-50 text-emerald-500 border border-emerald-200 rounded cursor-default" disabled title="Done"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></button>
                <button hx-put="/web/appointments/{{ appointment.id }}/status" hx-vals='{"status": "paid"}' hx-swap="none" class="p-1.5 inline-flex items-center justify-center bg-amber-500 text-white rounded hover:bg-amber-600 shadow-sm transition-colors" title="Paid"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></button>
                <button class="p-1.5 inline-flex items-center justify-center bg-gray-100 text-gray-400 rounded cursor-not-allowed border border-gray-200" disabled title="Cannot cancel a done appointment"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
            {% elseif appointment.status == 'paid' %}
                <span class="inline-flex items-center justify-center p-1.5 rounded bg-gray-900 text-white shadow-sm" title="Completed"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
            {% elseif appointment.status == 'cancelled' %}
                <span class="inline-flex items-center justify-center p-1.5 rounded bg-red-100 text-red-800 shadow-sm" title="Cancelled"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
            {% else %}
                <span class="inline-flex items-center px-2 py-1.5 rounded text-xs font-medium bg-gray-100 text-gray-800">{{ appointment.status|capitalize }}</span>
            {% endif %}
            
            {% set waMessage = "Hello " ~ appointment.customer ~ ",\n\nYour appointment for " ~ appointment.service ~ " on " ~ appointment.date ~ " at " ~ appointment.time ~ " is currently: " ~ appointment.status|upper ~ ".\n\nStylist: " ~ appointment.stylist %}
            {% if appointment.status == 'paid' and appointment.invoice_id %}
                {% set waMessage = waMessage ~ "\n\nView your invoice here: https://ls.encodeunlimited.com/web/invoices/download/" ~ appointment.invoice_id %}
            {% endif %}
            {% set waMessage = waMessage ~ "\n\nThank you for choosing our Salon!" %}
            {% set cleanPhone = appointment.customer_phone|default('')|replace({' ': '', '-': '', '+': ''}) %}
            {% if cleanPhone starts with '0' %}
                {% set cleanPhone = '94' ~ cleanPhone|slice(1) %}
            {% endif %}
            
            <a href="{% if cleanPhone %}https://wa.me/{{ cleanPhone }}?text={{ waMessage|url_encode }}{% else %}#{% endif %}" target="_blank" class="p-1.5 inline-flex items-center justify-center bg-green-500 text-white rounded shadow-sm transition-colors {% if not cleanPhone %}opacity-50 cursor-not-allowed{% else %}hover:bg-green-600{% endif %}" {% if not cleanPhone %}onclick="event.preventDefault(); alert('No phone number available');"{% endif %} title="Send WhatsApp">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
        </div>
    </td>
</tr>

