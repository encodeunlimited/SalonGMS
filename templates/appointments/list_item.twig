<tr id="apt-{{ appointment.id }}" class="hover:bg-slate-50 transition-colors">
    <td class="px-6 py-5 whitespace-nowrap">
        <div class="text-sm font-medium text-gray-900">{{ appointment.time }}</div>
        <div class="text-xs text-gray-500">{{ appointment.date }}</div>
    </td>
    <td class="px-6 py-5 whitespace-nowrap">
        <div class="flex items-center">
            {% if appointment.customer_image %}
                <img src="{{ appointment.customer_image }}" alt="{{ appointment.customer }}" class="w-8 h-8 rounded-full object-cover mr-3 shadow-sm">
            {% else %}
                <div class="w-8 h-8 rounded-full bg-salon-dark text-white flex items-center justify-center font-bold text-xs mr-3 shadow-sm">
                    {{ appointment.customer|slice(0, 1)|upper }}
                </div>
            {% endif %}
            <div>
                <div class="text-sm font-bold text-gray-900">{{ appointment.customer }}</div>
                <div class="text-xs text-gray-500 mt-1 flex items-center">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 mr-2">
                        {{ appointment.service }}
                    </span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium mr-2 {% if appointment.booking_type == 'Home Visit' %}bg-purple-100 text-purple-800{% else %}bg-blue-100 text-blue-800{% endif %}">
                        {{ appointment.booking_type|default('In Salon') }}
                    </span>
                    <span class="flex items-center">
                        {% if appointment.stylist_image %}
                            <img src="{{ appointment.stylist_image }}" class="w-4 h-4 rounded-full mr-1 object-cover" title="{{ appointment.stylist }}">
                        {% else %}
                            <div class="w-4 h-4 rounded-full bg-gray-300 text-gray-700 flex items-center justify-center font-bold mr-1" style="font-size: 0.5rem;" title="{{ appointment.stylist }}">
                                {{ appointment.stylist|slice(0, 1)|upper }}
                            </div>
                        {% endif %}
                        {{ appointment.stylist }}
                    </span>
                </div>
            </div>
        </div>
    </td>
    <td class="px-6 py-5 whitespace-nowrap text-right">
        <div class="flex items-center gap-1 justify-end">
            {% if appointment.status == 'scheduled' or appointment.status == 'pending' %}
                <button hx-put="/web/appointments/{{ appointment.id }}/status" hx-vals='{"status": "approved"}' hx-target="closest tr" hx-swap="outerHTML" class="px-2 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700 shadow-sm transition-colors">Approve</button>
                <button class="px-2 py-1 bg-gray-100 text-gray-400 text-xs rounded cursor-not-allowed border border-gray-200" disabled>Done</button>
                <button class="px-2 py-1 bg-gray-100 text-gray-400 text-xs rounded cursor-not-allowed border border-gray-200" disabled>Paid</button>
            {% elseif appointment.status == 'approved' %}
                <button class="px-2 py-1 bg-blue-50 text-blue-400 border border-blue-200 text-xs rounded cursor-default" disabled>Approved</button>
                <button hx-put="/web/appointments/{{ appointment.id }}/status" hx-vals='{"status": "done"}' hx-target="closest tr" hx-swap="outerHTML" class="px-2 py-1 bg-emerald-500 text-white text-xs rounded hover:bg-emerald-600 shadow-sm transition-colors">Done</button>
                <button class="px-2 py-1 bg-gray-100 text-gray-400 text-xs rounded cursor-not-allowed border border-gray-200" disabled>Paid</button>
            {% elseif appointment.status == 'done' %}
                <button class="px-2 py-1 bg-emerald-50 text-emerald-500 border border-emerald-200 text-xs rounded cursor-default" disabled>Done</button>
                <button hx-put="/web/appointments/{{ appointment.id }}/status" hx-vals='{"status": "paid"}' hx-target="closest tr" hx-swap="outerHTML" class="px-2 py-1 bg-amber-500 text-white text-xs rounded hover:bg-amber-600 shadow-sm transition-colors">Paid</button>
            {% elseif appointment.status == 'paid' %}
                <span class="inline-flex items-center px-3 py-1 rounded text-xs font-bold bg-gray-900 text-white shadow-sm">Completed</span>
            {% else %}
                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800">{{ appointment.status|capitalize }}</span>
            {% endif %}
            
            {% set waMessage = "Hello " ~ appointment.customer ~ ",\n\nYour appointment for " ~ appointment.service ~ " on " ~ appointment.date ~ " at " ~ appointment.time ~ " is currently: " ~ appointment.status|upper ~ ".\n\nStylist: " ~ appointment.stylist ~ "\n\nThank you for choosing our Salon!" %}
            {% set cleanPhone = appointment.customer_phone|default('')|replace({' ': '', '-': '', '+': ''}) %}
            
            <a href="{% if cleanPhone %}https://wa.me/{{ cleanPhone }}?text={{ waMessage|url_encode }}{% else %}#{% endif %}" target="_blank" class="px-2 py-1 bg-green-500 text-white text-xs rounded shadow-sm transition-colors {% if not cleanPhone %}opacity-50 cursor-not-allowed{% else %}hover:bg-green-600{% endif %}" {% if not cleanPhone %}onclick="event.preventDefault(); alert('No phone number available');"{% endif %} title="Send WhatsApp">
                <svg class="w-3.5 h-3.5 inline-block" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
        </div>
    </td>
</tr>

