<div id="customer-invoices-container">
    <div class="mb-4">
        <div class="relative w-full max-w-md">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input type="search" name="search" value="{{ search }}" placeholder="Search invoices..." 
                   hx-get="/web/customers/{{ customer_id }}/invoices?sort={{ sort }}&dir={{ dir }}" 
                   hx-target="#customer-invoices-container" hx-select="#customer-invoices-container" hx-swap="outerHTML" 
                   hx-trigger="keyup changed delay:500ms, search"
                   class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors">
        </div>
    </div>

    {% if invoices|length > 0 %}
        <div class="overflow-x-auto rounded-xl border border-slate-100">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-100">
                        <th class="px-6 py-4 font-medium w-10 text-center">Select</th>
                        <th class="px-6 py-4 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/customers/{{ customer_id }}/invoices?sort=id&dir={{ sort == 'id' and dir == 'asc' ? 'desc' : 'asc' }}&search={{ search }}"
                            hx-target="#customer-invoices-container" hx-select="#customer-invoices-container" hx-swap="outerHTML">
                            Invoice ID {% if sort == 'id' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-4 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/customers/{{ customer_id }}/invoices?sort=created_at&dir={{ sort == 'created_at' and dir == 'asc' ? 'desc' : 'asc' }}&search={{ search }}"
                            hx-target="#customer-invoices-container" hx-select="#customer-invoices-container" hx-swap="outerHTML">
                            Date {% if sort == 'created_at' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-4 font-medium text-slate-500">Service Info</th>
                        <th class="px-6 py-4 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/customers/{{ customer_id }}/invoices?sort=total_amount&dir={{ sort == 'total_amount' and dir == 'asc' ? 'desc' : 'asc' }}&search={{ search }}"
                            hx-target="#customer-invoices-container" hx-select="#customer-invoices-container" hx-swap="outerHTML">
                            Amount {% if sort == 'total_amount' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-4 font-medium text-center cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/customers/{{ customer_id }}/invoices?sort=status&dir={{ sort == 'status' and dir == 'asc' ? 'desc' : 'asc' }}&search={{ search }}"
                            hx-target="#customer-invoices-container" hx-select="#customer-invoices-container" hx-swap="outerHTML">
                            Status {% if sort == 'status' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-4 font-medium text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    {% for invoice in invoices %}
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 text-center">
                                {% if invoice.status != 'paid' %}
                                    <input type="checkbox" 
                                           @change="toggleInvoice({{ invoice.id }}, '{{ invoice.total_amount }}')"
                                           class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer">
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-sm font-medium text-slate-900">#{{ "%05d"|format(invoice.id) }}</td>
                            <td class="px-6 py-4 text-sm text-slate-500">{{ invoice.created_at|date("M j, Y h:i A") }}</td>
                            <td class="px-6 py-4 text-sm text-slate-600 truncate max-w-[200px]" title="{{ invoice.service_names }}">
                                {{ invoice.service_names|default('Custom Invoice') }}
                            </td>
                            <td class="px-6 py-4 text-sm font-bold text-slate-900">QAR {{ invoice.total_amount|number_format(2) }}</td>
                            <td class="px-6 py-4 text-center">
                                {% if invoice.status == 'paid' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
                                {% elseif invoice.status == 'unpaid' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Unpaid</span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800 capitalize">{{ invoice.status }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                {% if invoice.status != 'paid' %}
                                    <button @click="showPaymentModal = true; selectedInvoice = {{ invoice.id }}; selectedInvoices = [{{ invoice.id }}]; totalAmount = {{ invoice.total_amount }};" 
                                            class="inline-flex items-center justify-center p-2 bg-yellow-50 text-yellow-600 rounded-md hover:bg-yellow-100 transition-colors" title="Pay Now">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                    </button>
                                {% endif %}
                                {% set invUrl = base_url ~ '/web/invoices/download/' ~ invoice.id %}
                                {% if customer is defined and customer.phone %}
                                <a href="https://wa.me/{{ customer.phone|default('')|replace({'+': '', ' ': '', '-': ''}) }}?text={{ ('Hello ' ~ customer.name ~ ', this is regarding your invoice #INV-' ~ '%05d'|format(invoice.id) ~ ' for QAR ' ~ invoice.total_amount|number_format(2) ~ '. View your invoice here: ' ~ invUrl ~ '\n\nThank you!')|url_encode }}"
                                   target="_blank" class="inline-flex items-center justify-center p-2 bg-green-50 text-green-600 rounded-md hover:bg-green-100 transition-colors" title="Send WhatsApp">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                                </a>
                                {% endif %}
                                <a href="#" onclick="window.open('/web/invoices/download/{{ invoice.id }}', 'receipt', 'width=400,height=600'); return false;" 
                                   class="inline-flex items-center justify-center p-2 bg-slate-50 text-slate-600 rounded-md hover:bg-slate-100 transition-colors" title="Print/View Invoice">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            
            {% if pagination.total_pages > 1 %}
            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
                <p class="text-sm text-slate-700">
                    Showing <span class="font-medium">{{ (pagination.page - 1) * pagination.limit + 1 }}</span> to 
                    <span class="font-medium">{{ min(pagination.page * pagination.limit, pagination.total) }}</span> of 
                    <span class="font-medium">{{ pagination.total }}</span> results
                </p>
                <div class="flex gap-1">
                    {% for p in 1..pagination.total_pages %}
                        <button hx-get="/web/customers/{{ customer_id }}/invoices?page={{ p }}&sort={{ sort }}&dir={{ dir }}&search={{ search }}"
                                hx-target="#customer-invoices-container" hx-select="#customer-invoices-container" hx-swap="outerHTML"
                                class="px-3 py-1 text-sm border rounded-md transition-colors {% if pagination.page == p %}bg-indigo-600 text-white border-indigo-600{% else %}bg-white text-slate-700 border-slate-300 hover:bg-slate-50{% endif %}">
                            {{ p }}
                        </button>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    {% else %}
        <div class="p-12 text-center border border-slate-100 rounded-xl bg-white">
            <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <h3 class="text-lg font-medium text-slate-900 mb-1">No invoices found</h3>
            <p class="text-slate-500">No invoices match your criteria.</p>
        </div>
    {% endif %}
</div>
