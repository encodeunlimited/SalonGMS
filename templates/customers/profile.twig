{% extends "layout.twig" %}

{% block content %}
<div class="container mx-auto px-4 py-8 max-w-6xl">
    
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Customer Profile</h1>
            <p class="text-gray-500 mt-1">View history, appointments, and billing for {{ customer.name }}</p>
        </div>
        <a href="/web/customers" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg transition-colors font-medium">
            &larr; Back to Customers
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Column: Profile Card & Stats -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Profile Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <div class="flex flex-col items-center text-center">
                    {% if customer.profile_image %}
                        <img src="{{ customer.profile_image }}" alt="{{ customer.name }}" class="w-24 h-24 rounded-full object-cover mb-4 border-4 border-gray-50 shadow-sm">
                    {% else %}
                        <div class="w-24 h-24 rounded-full bg-salon-dark text-white flex items-center justify-center font-bold text-3xl mb-4 border-4 border-gray-50 shadow-sm">
                            {{ customer.name|slice(0, 1)|upper }}
                        </div>
                    {% endif %}
                    
                    <h2 class="text-xl font-bold text-gray-900">{{ customer.name }}</h2>
                    <p class="text-gray-500 text-sm mb-4">Customer since {{ customer.created_at|date("M Y") }}</p>
                    
                    <div class="w-full text-left space-y-3 mt-4 pt-4 border-t border-gray-100">
                        <div class="flex items-start">
                            <svg class="w-5 h-5 text-gray-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            <div>
                                <p class="text-sm font-medium text-gray-900">Email</p>
                                <p class="text-sm text-gray-500">{{ customer.email|default('Not provided') }}</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <svg class="w-5 h-5 text-gray-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            <div>
                                <p class="text-sm font-medium text-gray-900">Phone</p>
                                <p class="text-sm text-gray-500">{{ customer.phone|default('Not provided') }}</p>
                            </div>
                        </div>
                        <div class="flex items-start">
                            <svg class="w-5 h-5 text-gray-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            <div>
                                <p class="text-sm font-medium text-gray-900">Notes</p>
                                <p class="text-sm text-gray-500">{{ customer.notes|default('No notes available.') }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Quick Stats -->
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Total Spent</p>
                    <p class="text-2xl font-bold text-gray-900">${{ stats.total_spent|number_format(2) }}</p>
                </div>
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Pending</p>
                    <p class="text-2xl font-bold {% if stats.pending_amount > 0 %}text-red-500{% else %}text-green-500{% endif %}">
                        ${{ stats.pending_amount|number_format(2) }}
                    </p>
                </div>
                <div class="col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Appointments</p>
                    <p class="text-2xl font-bold text-gray-900">{{ stats.total_appointments }}</p>
                </div>
            </div>
        </div>
        
        <!-- Right Column: Tabs for Appointments & Invoices -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden" x-data="{ tab: 'appointments' }">
                
                <!-- Tab Headers -->
                <div class="flex border-b border-gray-100 px-2 bg-gray-50/50">
                    <button @click="tab = 'appointments'" 
                            :class="{ 'border-salon-primary text-salon-primary': tab === 'appointments', 'border-transparent text-gray-500 hover:text-gray-700': tab !== 'appointments' }"
                            class="px-6 py-4 border-b-2 font-medium text-sm transition-colors">
                        Appointment History
                    </button>
                    <button @click="tab = 'billing'" 
                            :class="{ 'border-salon-primary text-salon-primary': tab === 'billing', 'border-transparent text-gray-500 hover:text-gray-700': tab !== 'billing' }"
                            class="px-6 py-4 border-b-2 font-medium text-sm transition-colors flex items-center">
                        Billing & Payments
                        {% if stats.pending_amount > 0 %}
                            <span class="ml-2 bg-red-100 text-red-600 px-2 py-0.5 rounded-full text-xs font-bold">${{ stats.pending_amount|number_format(2) }}</span>
                        {% endif %}
                    </button>
                </div>
                
                <!-- Appointments Tab -->
                <div x-show="tab === 'appointments'" class="p-0">
                    {% if appointments|length > 0 %}
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-gray-50/50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
                                        <th class="px-6 py-3 font-medium">Date & Time</th>
                                        <th class="px-6 py-3 font-medium">Service</th>
                                        <th class="px-6 py-3 font-medium">Stylist</th>
                                        <th class="px-6 py-3 font-medium">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    {% for apt in appointments %}
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-6 py-4">
                                                <div class="font-medium text-gray-900">{{ apt.date|date("M j, Y") }}</div>
                                                <div class="text-xs text-gray-500">{{ apt.time|date("g:i A") }}</div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="font-medium text-gray-800">{{ apt.service }}</span>
                                                <div class="text-xs text-gray-500">{{ apt.booking_type }}</div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div class="flex items-center">
                                                    {% if apt.stylist_image %}
                                                        <img src="{{ apt.stylist_image }}" alt="{{ apt.stylist }}" class="w-6 h-6 rounded-full object-cover mr-2">
                                                    {% endif %}
                                                    <span class="text-gray-600">{{ apt.stylist }}</span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4">
                                                {% if apt.status == 'paid' or apt.status == 'completed' %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
                                                {% elseif apt.status == 'done' %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">Done</span>
                                                {% elseif apt.status == 'approved' %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Approved</span>
                                                {% elseif apt.status == 'cancelled' %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Cancelled</span>
                                                {% else %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 capitalize">{{ apt.status }}</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="p-12 text-center">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                            <h3 class="text-lg font-medium text-gray-900 mb-1">No appointments yet</h3>
                            <p class="text-gray-500">This customer hasn't booked any appointments.</p>
                        </div>
                    {% endif %}
                </div>
                
                <!-- Billing Tab -->
                <div x-show="tab === 'billing'" class="p-0 relative" x-cloak style="display: none;" x-data="{ showPaymentModal: false, selectedInvoice: null, paymentMethod: 'Cash', tenderAmount: '', totalAmount: 0 }">
                    {% if unbilled_appointments|length > 0 %}
                    <div class="p-6 border-b border-gray-100 bg-yellow-50/50">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-lg font-medium text-gray-900">Unbilled Completed Appointments</h3>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">Requires Invoicing</span>
                        </div>
                        <form hx-post="/web/customers/{{ customer.id }}/bulk-invoice" hx-swap="none">
                            <div class="overflow-hidden rounded-lg border border-gray-200 shadow-sm mb-4">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-gray-50 text-xs uppercase tracking-wider text-gray-500 border-b border-gray-200">
                                            <th class="px-4 py-3 font-medium w-10 text-center">Select</th>
                                            <th class="px-4 py-3 font-medium">Date & Time</th>
                                            <th class="px-4 py-3 font-medium">Service</th>
                                            <th class="px-4 py-3 font-medium">Stylist</th>
                                            <th class="px-4 py-3 font-medium text-right">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 bg-white">
                                        {% for apt in unbilled_appointments %}
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-4 py-3 text-center">
                                                <input type="checkbox" name="appointment_ids[]" value="{{ apt.id }}" checked class="w-4 h-4 rounded border-gray-300 text-salon-accent focus:ring-salon-accent cursor-pointer">
                                            </td>
                                            <td class="px-4 py-3 text-sm text-gray-600">{{ apt.date|date("M j, Y") }} <span class="text-gray-400">at</span> {{ apt.time }}</td>
                                            <td class="px-4 py-3 font-medium text-gray-800">{{ apt.service }}</td>
                                            <td class="px-4 py-3 text-sm text-gray-600">{{ apt.stylist }}</td>
                                            <td class="px-4 py-3 font-bold text-gray-900 text-right">${{ apt.service_price|number_format(2) }}</td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <div class="flex justify-end">
                                <button type="submit" class="inline-flex items-center px-4 py-2 bg-salon-accent text-white text-sm font-medium rounded-md hover:bg-yellow-600 transition-colors shadow-sm">
                                    Generate Bulk Invoice
                                </button>
                            </div>
                        </form>
                    </div>
                    {% endif %}
                    
                    {% if invoices|length > 0 %}
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-gray-50/50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
                                        <th class="px-6 py-3 font-medium">Invoice ID</th>
                                        <th class="px-6 py-3 font-medium">Date</th>
                                        <th class="px-6 py-3 font-medium">Service Info</th>
                                        <th class="px-6 py-3 font-medium">Amount</th>
                                        <th class="px-6 py-3 font-medium text-center">Status</th>
                                        <th class="px-6 py-3 font-medium text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    {% for invoice in invoices %}
                                        <tr class="hover:bg-gray-50 transition-colors">
                                            <td class="px-6 py-4 font-mono text-sm text-gray-600">
                                                #INV-{{ "%05d"|format(invoice.id) }}
                                            </td>
                                            <td class="px-6 py-4 text-sm text-gray-600">
                                                {{ invoice.created_at|date("M j, Y") }}
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="text-sm font-medium text-gray-800">{{ invoice.service|default('General Service') }}</span>
                                                {% if invoice.payment_method %}
                                                    <div class="text-xs text-gray-500">Paid via {{ invoice.payment_method }}</div>
                                                {% endif %}
                                            </td>
                                            <td class="px-6 py-4 font-bold text-gray-900">
                                                ${{ invoice.total_amount|number_format(2) }}
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                {% if invoice.status == 'paid' %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
                                                {% else %}
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">Unpaid</span>
                                                {% endif %}
                                            </td>
                                            <td class="px-6 py-4 text-right space-x-2">
                                                <a href="https://wa.me/{{ customer.phone|default('')|replace({'+': '', ' ': '', '-': ''}) }}?text={{ 'Hello ' ~ customer.name ~ ', this is regarding your invoice #INV-' ~ '%05d'|format(invoice.id) ~ ' for $' ~ invoice.total_amount|number_format(2) ~ '. Thank you!'|url_encode }}" 
                                                   target="_blank"
                                                   class="inline-flex items-center justify-center p-2 bg-green-50 text-green-600 rounded-md hover:bg-green-100 transition-colors" title="Send WhatsApp">
                                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                                                </a>
                                                {% if invoice.status != 'paid' %}
                                                    <button @click="selectedInvoice = {{ invoice.id }}; totalAmount = {{ invoice.total_amount }}; showPaymentModal = true;" 
                                                            class="inline-flex items-center justify-center px-3 py-2 bg-salon-primary text-white text-xs font-medium rounded-md hover:bg-salon-dark transition-colors">
                                                        Pay Now
                                                    </button>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="p-12 text-center">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"></path></svg>
                            </div>
                            <h3 class="text-lg font-medium text-gray-900 mb-1">No billing history</h3>
                            <p class="text-gray-500">There are no invoices for this customer yet.</p>
                        </div>
                    {% endif %}

                    <!-- Payment Modal -->
                    <div x-show="showPaymentModal" class="fixed inset-0 z-50 overflow-y-auto" style="display: none;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                            <!-- Background overlay -->
                            <div x-show="showPaymentModal" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="showPaymentModal = false"></div>

                            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

                            <!-- Modal panel -->
                            <div x-show="showPaymentModal" 
                                 x-transition:enter="ease-out duration-300" 
                                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
                                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
                                 x-transition:leave="ease-in duration-200" 
                                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" 
                                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
                                 class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">
                                
                                <form :action="'/web/invoices/' + selectedInvoice + '/pay'" method="POST" hx-post="javascript:void(0)" hx-trigger="submit">
                                    <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                                        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4" id="modal-title">Pay Remaining Balance</h3>
                                        
                                        <div class="mb-4">
                                            <p class="text-sm text-gray-500">Amount Due: <span class="font-bold text-gray-900" x-text="'$' + totalAmount.toFixed(2)"></span></p>
                                        </div>
                                        
                                        <div class="mb-4">
                                            <label class="block text-sm font-medium text-gray-700 mb-2">Payment Method</label>
                                            <select x-model="paymentMethod" name="payment_method" class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm rounded-md">
                                                <option value="Cash">Cash</option>
                                                <option value="Card">Card</option>
                                                <option value="Bank Transfer">Bank Transfer</option>
                                            </select>
                                        </div>

                                        <div class="mb-4" x-show="paymentMethod === 'Cash'">
                                            <label class="block text-sm font-medium text-gray-700 mb-2">Tender Amount</label>
                                            <div class="relative rounded-md shadow-sm">
                                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                                    <span class="text-gray-500 sm:text-sm">$</span>
                                                </div>
                                                <input type="number" x-model="tenderAmount" name="tender_amount" step="0.01" class="!pl-10 focus:ring-salon-accent focus:border-salon-accent block w-full sm:text-sm border-gray-300 rounded-md" placeholder="0.00">
                                            </div>
                                            <p class="text-sm text-gray-500 mt-2" x-show="tenderAmount !== '' && (parseFloat(tenderAmount) - totalAmount) > 0">
                                                Change Due: <span class="font-medium text-gray-900" x-text="'$' + (parseFloat(tenderAmount) - totalAmount).toFixed(2)"></span>
                                            </p>
                                            <input type="hidden" name="change_amount" :value="(tenderAmount !== '' && (parseFloat(tenderAmount) - totalAmount) > 0) ? (parseFloat(tenderAmount) - totalAmount).toFixed(2) : 0">
                                        </div>
                                    </div>
                                    <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                                        <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-salon-primary text-base font-medium text-white hover:bg-salon-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-salon-accent sm:ml-3 sm:w-auto sm:text-sm">
                                            Confirm Payment
                                        </button>
                                        <button type="button" @click="showPaymentModal = false" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-salon-accent sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}
