<tr class="hover:bg-gray-50 transition-colors">
    <td class="px-6 py-4 whitespace-nowrap">
        <div class="flex items-center">
            <div class="w-8 h-8 rounded-full bg-salon-accent text-white flex items-center justify-center font-bold text-xs mr-3">
                {{ customer.name|slice(0, 1)|upper }}
            </div>
            <span class="font-medium text-gray-900">{{ customer.name }}</span>
        </div>
    </td>
    <td class="px-6 py-4 text-gray-600">{{ customer.email|default('-') }}</td>
    <td class="px-6 py-4 text-gray-600">{{ customer.phone|default('-') }}</td>
    <td class="px-6 py-4 text-gray-500">{{ customer.created_at|default('now'|date("M j, Y")) }}</td>
    <td class="px-6 py-4 text-right">
        <button class="text-gray-400 hover:text-salon-accent transition-colors">
            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        </button>
    </td>
</tr>
