<tr id="customer-row-{{ customer.id }}" class="hover:bg-gray-50 transition-colors">
    <td class="px-6 py-5 whitespace-nowrap">
        <div class="flex items-center">
            {% if customer.profile_image %}
                <img src="{{ customer.profile_image }}" alt="{{ customer.name }}" class="w-8 h-8 rounded-full object-cover mr-3 shadow-sm">
            {% else %}
                <div class="w-8 h-8 rounded-full bg-salon-dark text-white flex items-center justify-center font-bold text-xs mr-3 shadow-sm">
                    {{ customer.name|slice(0, 1)|upper }}
                </div>
            {% endif %}
            <span class="font-medium text-gray-900">{{ customer.name }}</span>
        </div>
    </td>
    <td class="px-6 py-5 text-gray-500 whitespace-nowrap">{{ customer.email|default('-') }}</td>
    <td class="px-6 py-5 text-gray-500 whitespace-nowrap">{{ customer.phone|default('-') }}</td>
    <td class="px-6 py-5 text-gray-500 whitespace-nowrap">
        {% if customer.created_at %}
            {{ customer.created_at|date("M j, Y") }}
        {% else %}
            -
        {% endif %}
    </td>
    <td class="px-6 py-5 text-right">
        <a href="/web/customers/{{ customer.id }}/profile" class="text-gray-400 hover:text-blue-500 transition-colors mr-2" title="View Profile">
            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
        </a>
        <button hx-get="/web/customers/{{ customer.id }}/edit" hx-target="#modal-container" class="text-gray-400 hover:text-salon-accent transition-colors" title="Edit Customer">
            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        </button>
        {% if auth_user.role == 'admin' %}
        <button hx-delete="/web/customers/{{ customer.id }}" 
                hx-confirm="Are you sure you want to delete this customer? This action cannot be undone." 
                hx-target="closest tr" 
                hx-swap="outerHTML" 
                title="Delete Customer"
                class="text-gray-400 hover:text-red-500 transition-colors ml-2">
            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
        </button>
        {% endif %}
    </td>
</tr>

