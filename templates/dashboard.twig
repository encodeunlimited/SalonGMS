{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Overview</h2>
        <p class="text-sm text-gray-500 mt-1">Here's what's happening at your salon today.</p>
    </div>
    <!-- Example Action Button -->
    <button class="bg-salon-dark text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-salon-navy shadow-sm transition-colors flex items-center">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
        Export Report
    </button>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center">
        <div class="p-3 rounded-lg bg-green-50 text-green-600 mr-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <h3 class="text-sm font-medium text-gray-500">Today's Revenue</h3>
            <p class="text-2xl font-bold text-gray-900 mt-1">${{ kpi.revenue_today|number_format(2) }}</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center">
        <div class="p-3 rounded-lg bg-blue-50 text-blue-600 mr-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        </div>
        <div>
            <h3 class="text-sm font-medium text-gray-500">Appointments</h3>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ kpi.appointments_today }}</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center">
        <div class="p-3 rounded-lg bg-purple-50 text-purple-600 mr-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
        <div>
            <h3 class="text-sm font-medium text-gray-500">Active Stylists</h3>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ kpi.active_stylists }}</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 flex items-center">
        <div class="p-3 rounded-lg bg-yellow-50 text-yellow-600 mr-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path></svg>
        </div>
        <div>
            <h3 class="text-sm font-medium text-gray-500">New Customers</h3>
            <p class="text-2xl font-bold text-gray-900 mt-1">{{ kpi.new_customers }}</p>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Chart -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 lg:col-span-2">
        <h3 class="text-base font-bold text-gray-900 mb-4">Weekly Revenue</h3>
        <div id="revenue-chart"></div>
    </div>
    
    <!-- Donut Chart -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
        <h3 class="text-base font-bold text-gray-900 mb-4">Services Breakdown</h3>
        <div id="services-chart" class="flex justify-center mt-6"></div>
    </div>
</div>

<!-- Appointments & Payments Section -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
    
    <!-- Left Column: Appointments (Today & Tomorrow) -->
    <div class="lg:col-span-2 space-y-6">
        
        <!-- Today's Appointments -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                <h3 class="text-base font-bold text-gray-900">Today's Appointments</h3>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ today_appointments|length }}</span>
            </div>
            {% if today_appointments|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-white text-xs uppercase tracking-wider text-gray-500 border-b border-gray-100">
                                <th class="px-6 py-3 font-medium">Time</th>
                                <th class="px-6 py-3 font-medium">Customer</th>
                                <th class="px-6 py-3 font-medium">Service</th>
                                <th class="px-6 py-3 font-medium">Stylist</th>
                                <th class="px-6 py-3 font-medium text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for apt in today_appointments %}
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4 text-sm font-medium text-gray-900 whitespace-nowrap">{{ apt.time|date("g:i A") }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-700 font-medium">{{ apt.customer }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-500">{{ apt.service }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-500">{{ apt.stylist }}</td>
                                    <td class="px-6 py-4 text-right">
                                        {% if apt.status == 'scheduled' or apt.status == 'pending' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Scheduled</span>
                                        {% elseif apt.status == 'approved' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Approved</span>
                                        {% elseif apt.status == 'done' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Done</span>
                                        {% elseif apt.status == 'paid' or apt.status == 'completed' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
                                        {% elseif apt.status == 'cancelled' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Cancelled</span>
                                        {% else %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 capitalize">{{ apt.status }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="p-8 text-center text-gray-500 text-sm">No appointments scheduled for today.</div>
            {% endif %}
        </div>

        <!-- Tomorrow's Appointments -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                <h3 class="text-base font-bold text-gray-900">Tomorrow's Appointments</h3>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ tomorrow_appointments|length }}</span>
            </div>
            {% if tomorrow_appointments|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-white text-xs uppercase tracking-wider text-gray-500 border-b border-gray-100">
                                <th class="px-6 py-3 font-medium">Time</th>
                                <th class="px-6 py-3 font-medium">Customer</th>
                                <th class="px-6 py-3 font-medium">Service</th>
                                <th class="px-6 py-3 font-medium text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for apt in tomorrow_appointments %}
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-6 py-4 text-sm font-medium text-gray-900 whitespace-nowrap">{{ apt.time|date("g:i A") }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-700 font-medium">{{ apt.customer }}</td>
                                    <td class="px-6 py-4 text-sm text-gray-500">{{ apt.service }}</td>
                                    <td class="px-6 py-4 text-right">
                                        {% if apt.status == 'scheduled' or apt.status == 'pending' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Scheduled</span>
                                        {% elseif apt.status == 'approved' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Approved</span>
                                        {% else %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 capitalize">{{ apt.status }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="p-8 text-center text-gray-500 text-sm">No appointments scheduled for tomorrow.</div>
            {% endif %}
        </div>
    </div>

    <!-- Right Column: Pending Payments -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                <h3 class="text-base font-bold text-gray-900">Payment Pending</h3>
                <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ pending_payments|length }}</span>
            </div>
            <ul class="divide-y divide-gray-100 max-h-[800px] overflow-y-auto">
                {% for payment in pending_payments %}
                    <li class="p-4 flex items-center justify-between hover:bg-gray-50 transition-colors">
                        <div class="flex items-center overflow-hidden">
                            {% if payment.profile_image %}
                                <img src="{{ payment.profile_image }}" class="w-10 h-10 rounded-full object-cover mr-3 flex-shrink-0" alt="">
                            {% else %}
                                <div class="w-10 h-10 rounded-full bg-salon-dark text-white flex items-center justify-center font-bold text-lg mr-3 flex-shrink-0">
                                    {{ payment.customer_name|slice(0, 1)|upper }}
                                </div>
                            {% endif %}
                            <div class="truncate mr-2">
                                <p class="text-sm font-medium text-gray-900 truncate">{{ payment.customer_name }}</p>
                                <p class="text-xs text-gray-500 truncate">#INV-{{ "%05d"|format(payment.id) }}</p>
                            </div>
                        </div>
                        <div class="text-right flex-shrink-0 flex flex-col items-end">
                            <p class="text-sm font-bold text-red-600">${{ payment.total_amount|number_format(2) }}</p>
                            <a href="/web/customers/{{ payment.customer_id }}/profile" class="text-xs font-medium text-salon-primary hover:text-salon-dark mt-1">Pay Now &rarr;</a>
                        </div>
                    </li>
                {% else %}
                    <li class="p-8 text-center text-gray-500 text-sm">All invoices are paid up!</li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Revenue Bar Chart
        var revenueOptions = {
            series: [{
                name: 'Revenue',
                data: {{ charts.weekly_revenue|raw }}
            }],
            chart: {
                type: 'bar',
                height: 300,
                toolbar: { show: false },
                fontFamily: 'Inter, sans-serif'
            },
            plotOptions: {
                bar: {
                    borderRadius: 4,
                    columnWidth: '40%',
                }
            },
            colors: ['#0f172a'],
            dataLabels: { enabled: false },
            xaxis: {
                categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                axisBorder: { show: false },
                axisTicks: { show: false }
            },
            yaxis: {
                labels: { formatter: function (value) { return "$" + value; } }
            },
            grid: {
                borderColor: '#f1f5f9',
                strokeDashArray: 4,
                yaxis: { lines: { show: true } }
            }
        };

        var revenueChart = new ApexCharts(document.querySelector("#revenue-chart"), revenueOptions);
        revenueChart.render();

        // Services Donut Chart
        var servicesOptions = {
            series: {{ charts.services_series|raw }},
            chart: {
                type: 'donut',
                height: 320,
                fontFamily: 'Inter, sans-serif'
            },
            labels: {{ charts.services_labels|raw }},
            colors: ['#0f172a', '#d4af37', '#94a3b8', '#475569'],
            plotOptions: {
                pie: {
                    donut: { size: '70%' }
                }
            },
            dataLabels: { enabled: false },
            legend: { position: 'bottom' }
        };

        var servicesChart = new ApexCharts(document.querySelector("#services-chart"), servicesOptions);
        servicesChart.render();
    });
</script>
{% endblock %}
