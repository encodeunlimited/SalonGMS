                        <div class="flex items-center overflow-hidden">
                            <div class="w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mr-3 flex-shrink-0">
                                <i data-lucide="package-minus" class="w-5 h-5"></i>
                            </div>
                            <div class="truncate mr-2">
                                <p class="text-sm font-medium text-slate-900 truncate">{{ item.name }}</p>
                                <p class="text-xs text-rose-600 font-bold truncate">Low Stock: {{ item.quantity }} left</p>
