    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Colors from Tailwind Slate/Indigo
        const chartColors = {
            primary: '#4f46e5', // indigo-600
            secondary: '#cbd5e1', // slate-300
            slate900: '#0f172a',
            success: '#10b981', // emerald-500
            warning: '#f59e0b', // amber-500
            danger: '#f43f5e', // rose-500
            info: '#3b82f6', // blue-500
            muted: '#94a3b8' // slate-400
        };

        // Revenue Bar Chart
        var revenueOptions = {
            series: [{
                name: 'Revenue',
                data: {{ charts.weekly_revenue|raw }}
            }],
            chart: {
                type: 'bar',
                height: 300,
                toolbar: { show: false },
                fontFamily: 'Inter, sans-serif'
            },
            plotOptions: {
                bar: {
                    borderRadius: 4,
                    columnWidth: '40%',
                }
            },
            colors: [chartColors.primary],
            dataLabels: { enabled: false },
            xaxis: {
                categories: {{ charts.weekly_revenue_labels|raw }},
                axisBorder: { show: false },
                axisTicks: { show: false },
                labels: { style: { colors: chartColors.muted } }
            },
            yaxis: {
                labels: { 
                    formatter: function (value) { return "QAR " + value; },
                    style: { colors: chartColors.muted }
                }
            },
            grid: {
                borderColor: '#f1f5f9',
                strokeDashArray: 4,
                yaxis: { lines: { show: true } }
            }
        };

        var revenueChart = new ApexCharts(document.querySelector("#revenue-chart"), revenueOptions);
        revenueChart.render();

        // Services Donut Chart
        var servicesOptions = {
            series: {{ charts.services_series|raw }},
            chart: {
                type: 'donut',
                height: 320,
                fontFamily: 'Inter, sans-serif'
            },
            labels: {{ charts.services_labels|raw }},
            colors: [chartColors.primary, chartColors.info, chartColors.warning, chartColors.slate900],
            plotOptions: {
                pie: {
                    donut: { size: '70%' }
                }
            },
            dataLabels: { enabled: false },
            legend: { position: 'bottom', labels: { colors: chartColors.slate900 } }
        };

        var servicesChart = new ApexCharts(document.querySelector("#services-chart"), servicesOptions);
        servicesChart.render();

        // Appointments Status Pie Chart
        var aptStatusOptions = {
            series: {{ charts.apt_status_series|raw }},
            chart: {
                type: 'pie',
                height: 320,
                fontFamily: 'Inter, sans-serif'
            },
            labels: {{ charts.apt_status_labels|raw }},
            colors: [chartColors.success, chartColors.warning, chartColors.danger, chartColors.muted, chartColors.info],
            dataLabels: { enabled: true },
            legend: { position: 'bottom', labels: { colors: chartColors.slate900 } }
        };

        var aptStatusChart = new ApexCharts(document.querySelector("#apt-status-chart"), aptStatusOptions);
        aptStatusChart.render();
    });
</script>
{% endblock %}
