                <span class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-black uppercase tracking-wider">{{ tomorrow_appointments|length }}</span>
            </div>
            {% if tomorrow_appointments|length > 0 %}
