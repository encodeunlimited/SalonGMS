            {% endif %}
        </div>

        <!-- Tomorrow's Appointments -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                <h3 class="text-base font-bold text-slate-900">Tomorrow's Appointments</h3>
                <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ tomorrow_appointments|length }}</span>
            </div>
            {% if tomorrow_appointments|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="text-xs text-slate-500 bg-slate-50/50 uppercase font-bold tracking-wider">
                                <th class="px-6 py-3 font-medium">Time</th>
                                <th class="px-6 py-3 font-medium">Customer</th>
                                <th class="px-6 py-3 font-medium">Service</th>
                                <th class="px-6 py-3 font-medium text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            {% for apt in tomorrow_appointments %}
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="px-6 py-4 text-sm font-medium text-slate-900 whitespace-nowrap">{{ apt.time|date("g:i A") }}</td>
                                    <td class="px-6 py-4 text-sm text-slate-700 font-medium">{{ apt.customer }}</td>
                                    <td class="px-6 py-4 text-sm text-slate-500">{{ apt.service }}</td>
                                    <td class="px-6 py-4 text-right">
                                        {% if apt.status == 'scheduled' or apt.status == 'pending' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Scheduled</span>
                                        {% elseif apt.status == 'approved' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Approved</span>
