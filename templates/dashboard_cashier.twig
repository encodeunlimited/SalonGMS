                {% for item in expiry_alerts %}
                    <li class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors">
                        <div class="flex items-center overflow-hidden">
                            <div class="w-10 h-10 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mr-3 flex-shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <div class="truncate mr-2">
                                <p class="text-sm font-medium text-slate-900 truncate">{{ item.name }}</p>
                                <p class="text-xs text-orange-600 font-bold truncate">Expiring: {{ item.expiry_date|date("M d, Y") }}</p>
                            </div>
                        </div>
                        <a href="/web/inventory" class="text-xs font-medium text-indigo-600 hover:text-indigo-700">Manage &rarr;</a>
                    </li>
                {% endfor %}
                {% if low_stock_alerts|length == 0 and expiry_alerts|length == 0 %}
                    <li class="p-8 text-center text-slate-500 text-sm">Inventory is healthy!</li>
                {% endif %}
            </ul>
        </div>

        <!-- Today's Birthdays -->
        {# <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 bg-pink-50 flex justify-between items-center">
                <h3 class="text-base font-bold text-slate-900 flex items-center">
                    <svg class="w-5 h-5 text-pink-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.701 2.701 0 00-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M21 21v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7h18zm-3-9v-2a2 2 0 00-2-2H8a2 2 0 00-2 2v2h12z"></path></svg>
                    Today's Birthdays
                </h3>
                <span class="bg-pink-100 text-pink-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ todays_birthdays|length }}</span>
            </div>
            <ul class="divide-y divide-gray-100 max-h-[300px] overflow-y-auto">
                {% for customer in todays_birthdays %}
                    <li class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors">
                        <div class="flex items-center overflow-hidden">
                            {% if customer.profile_image %}
                                <img src="{{ customer.profile_image }}" class="w-10 h-10 rounded-full object-cover mr-3 flex-shrink-0" alt="">
                            {% else %}
                                <div class="w-10 h-10 rounded-full bg-pink-100 text-pink-600 flex items-center justify-center font-bold text-lg mr-3 flex-shrink-0">
                                    {{ customer.name|slice(0, 1)|upper }}
                                </div>
                            {% endif %}
                            <div class="truncate mr-2">
                                <p class="text-sm font-medium text-slate-900 truncate">{{ customer.name }}</p>
                                <p class="text-xs text-slate-500 truncate">{{ customer.phone }}</p>
                            </div>
                        </div>
                        <a href="/web/customers/{{ customer.id }}/profile" class="text-xs font-medium text-indigo-600 hover:text-indigo-700">Profile &rarr;</a>
                    </li>
                {% else %}
                    <li class="p-8 text-center text-slate-500 text-sm">No birthdays today.</li>
                {% endfor %}
            </ul>
        </div> #}

    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var revenueOptions = {
            series: [{ name: 'Revenue', data: {{ charts.weekly_revenue|raw }} }],
            chart: { type: 'bar', height: 300, toolbar: { show: false }, fontFamily: 'Inter, sans-serif' },
            plotOptions: { bar: { borderRadius: 4, columnWidth: '40%' } },
            colors: ['#0f172a'],
            dataLabels: { enabled: false },
            xaxis: { categories: {{ charts.weekly_revenue_labels|raw }}, axisBorder: { show: false }, axisTicks: { show: false } },
            yaxis: { labels: { formatter: function(v) { return "QAR " + v; } } },
            grid: { borderColor: '#f1f5f9', strokeDashArray: 4, yaxis: { lines: { show: true } } }
        };
        new ApexCharts(document.querySelector("#revenue-chart"), revenueOptions).render();

        var servicesOptions = {
            series: {{ charts.services_series|raw }},
            chart: { type: 'donut', height: 320, fontFamily: 'Inter, sans-serif' },
            labels: {{ charts.services_labels|raw }},
            colors: ['#0f172a', '#d4af37', '#94a3b8', '#475569'],
            plotOptions: { pie: { donut: { size: '70%' } } },
            dataLabels: { enabled: false },
            legend: { position: 'bottom' }
        };
        new ApexCharts(document.querySelector("#services-chart"), servicesOptions).render();

        var aptStatusOptions = {
            series: {{ charts.apt_status_series|raw }},
            chart: { type: 'pie', height: 320, fontFamily: 'Inter, sans-serif' },
            labels: {{ charts.apt_status_labels|raw }},
            colors: ['#10b981', '#f59e0b', '#ef4444', '#6b7280', '#3b82f6'],
            dataLabels: { enabled: true },
            legend: { position: 'bottom' }
        };
        new ApexCharts(document.querySelector("#apt-status-chart"), aptStatusOptions).render();
    });
</script>
{% endblock %}
