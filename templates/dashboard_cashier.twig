{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Daily Overview</h2>
        <p class="text-sm text-slate-500 mt-1">Here's what's happening at your salon today.</p>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    <!-- Revenue -->
    <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-blue-100 mb-1 uppercase">Revenue Today</p>
                <h2 class="text-3xl font-black mb-2">QAR {{ kpi.revenue_today|number_format(0) }}</h2>
                <p class="text-[10px] text-blue-200 font-medium">Cash: QAR {{ kpi.cash_today|number_format(0) }} | Card: QAR {{ kpi.card_today|number_format(0) }}</p>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="dollar-sign" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>

    <!-- Expenses -->
    <div class="bg-gradient-to-r from-rose-500 to-red-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-rose-100 mb-1 uppercase">Expenses Today</p>
                <h2 class="text-3xl font-black mb-2">QAR {{ kpi.expenses_today|number_format(0) }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="trending-down" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>

    <!-- Net Profit -->
    <div class="bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-emerald-100 mb-1 uppercase">Net Profit</p>
                {% set net_profit = kpi.revenue_today - kpi.expenses_today - kpi.commissions_today %}
                <h2 class="text-3xl font-black mb-2">QAR {{ net_profit|number_format(0) }}</h2>
                <p class="text-[10px] text-emerald-200 font-medium">Excl. expenses & comms</p>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="pie-chart" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>

    <!-- Appts -->
    {# <div class="bg-gradient-to-r from-purple-500 to-purple-700 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-purple-100 mb-1 uppercase">Appts Today</p>
                <h2 class="text-3xl font-black mb-2">{{ kpi.appointments_today }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="calendar" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div> #}

    <!-- Stylists -->
    <div class="bg-gradient-to-r from-orange-400 to-amber-500 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-orange-100 mb-1 uppercase">Stylists</p>
                <h2 class="text-3xl font-black mb-2">{{ kpi.active_stylists }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="users" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>

    <!-- New Cust -->
    <div class="bg-gradient-to-r from-teal-400 to-teal-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-teal-100 mb-1 uppercase">New Cust</p>
                <h2 class="text-3xl font-black mb-2">{{ kpi.new_customers }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="user-plus" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>

    <!-- Total Due -->
    <div class="bg-gradient-to-r from-pink-500 to-rose-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-pink-100 mb-1 uppercase">Total Due</p>
                <h2 class="text-3xl font-black mb-2">QAR {{ kpi.total_due|number_format(0) }}</h2>
                <p class="text-[10px] text-pink-200 font-medium">Unpaid invoices</p>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="clock" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-6">
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 lg:col-span-2 flex flex-col">
        <h3 class="text-base font-bold text-slate-900 mb-4">Weekly Revenue</h3>
        <div id="revenue-chart" class="flex-1"></div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col">
        <h3 class="text-base font-bold text-slate-900 mb-4">Services Breakdown</h3>
        <div id="services-chart" class="flex justify-center mt-auto mb-auto"></div>
    </div>
    {# <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col">
        <h3 class="text-base font-bold text-slate-900 mb-4">Appointments Status</h3>
        <div id="apt-status-chart" class="flex justify-center mt-auto mb-auto"></div>
    </div> #}
</div>

<!-- Appointments & Panels -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-8">
    <!-- Left: Appointments -->
    {# <div class="lg:col-span-2 space-y-6">

        <!-- Today's Appointments -->
