{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Stylist Dashboard</h2>
        <p class="text-sm text-slate-500 mt-1">Hello {{ auth_user.name }}! Here's your schedule for today.</p>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <!-- Commission -->
    <div class="bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-emerald-100 mb-1 uppercase">Your Commission (This Month)</p>
                <h2 class="text-3xl font-black mb-2">QAR {{ kpi.my_commission|number_format(2) }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="dollar-sign" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>

    <!-- My Waiting Queue Card -->
    {% if system_settings.enable_queue_system|default('1') == '1' %}
    <div class="bg-gradient-to-r from-indigo-600 to-indigo-800 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-indigo-200 mb-1 uppercase">My Waiting Queue</p>
                <div class="flex items-baseline gap-3 mb-2">
                    <h2 class="text-3xl font-black">{{ my_queue.waiting|length }}</h2>
                    <span class="text-xs text-indigo-200">waiting for you</span>
                </div>
                <div class="flex items-center gap-2 mt-2">
                    {% if my_queue.waiting|length > 0 %}
                    <form action="/web/queue/barbers/{{ auth_user.user_id }}/call-next" method="POST">
                        <button type="submit" class="px-3 py-1 rounded-lg bg-white text-indigo-700 font-bold text-xs hover:bg-indigo-50 shadow-xs transition flex items-center gap-1">
                            <i data-lucide="bell" class="w-3.5 h-3.5"></i> Call Next Customer
                        </button>
                    </form>
                    {% endif %}
                    <a href="/web/queue" class="text-xs text-indigo-200 hover:text-white underline font-medium">View full queue &rarr;</a>
                </div>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="ticket" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<!-- Currently In Chair Active Banner (If Stylist is Serving) -->
{% if system_settings.enable_queue_system|default('1') == '1' and my_queue.serving %}
<div class="mb-6 bg-emerald-50 border-2 border-emerald-500 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xs">
    <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-600 text-white font-mono font-black text-xl flex items-center justify-center shrink-0">
            {{ my_queue.serving.ticket_number }}
        </div>
        <div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider bg-emerald-200/60 px-2 py-0.5 rounded-full">Currently in your chair</span>
                <span class="text-xs text-emerald-600">Started {{ my_queue.serving.called_at|date('h:i A') }}</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mt-0.5">{{ my_queue.serving.customer_name }}</h3>
            <p class="text-xs text-slate-600">{{ my_queue.serving.service_name|default('Haircut / Service') }}</p>
        </div>
    </div>
    <div class="flex items-center gap-2 w-full sm:w-auto">
        <a href="/web/pos?queue_id={{ my_queue.serving.id }}" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 shadow-sm transition">
            <i data-lucide="shopping-cart" class="w-4 h-4"></i> Checkout in POS
        </a>
        <form action="/web/queue/tickets/{{ my_queue.serving.id }}/complete" method="POST">
            <button type="submit" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-50 transition">
                Done
            </button>
        </form>
    </div>
</div>
{% endif %}

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Chart -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 lg:col-span-2">
        <h3 class="text-base font-bold text-slate-900 mb-4">My Weekly Commission</h3>
        <div id="commission-chart"></div>
    </div>
    
    <!-- Donut Chart -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
        <h3 class="text-base font-bold text-slate-900 mb-4">My Top Services</h3>
        <div id="services-chart" class="flex justify-center mt-6"></div>
    </div>
</div>

<!-- Appointments Section -->
{# <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
    
    <!-- Today's Appointments -->
