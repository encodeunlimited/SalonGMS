{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Stylist Dashboard</h2>
        <p class="text-sm text-slate-500 mt-1">Hello {{ auth_user.name }}! Here's your schedule for today.</p>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <!-- Commission -->
    <div class="bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-emerald-100 mb-1 uppercase">Your Commission (This Month)</p>
                <h2 class="text-3xl font-black mb-2">QAR {{ kpi.my_commission|number_format(2) }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="dollar-sign" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>

    <!-- Appointments -->
    <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-blue-100 mb-1 uppercase">Appointments Today</p>
                <h2 class="text-3xl font-black mb-2">{{ today_appointments|length }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="calendar" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Chart -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 lg:col-span-2">
        <h3 class="text-base font-bold text-slate-900 mb-4">My Weekly Commission</h3>
        <div id="commission-chart"></div>
    </div>
    
    <!-- Donut Chart -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
        <h3 class="text-base font-bold text-slate-900 mb-4">My Top Services</h3>
        <div id="services-chart" class="flex justify-center mt-6"></div>
    </div>
</div>

<!-- Appointments Section -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
    
    <!-- Today's Appointments -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
            <h3 class="text-base font-bold text-slate-900">Today's Schedule</h3>
            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ today_appointments|length }}</span>
        </div>
        {% if today_appointments|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-xs text-slate-500 bg-slate-50/50 uppercase font-bold tracking-wider">
                            <th class="px-6 py-3 font-medium">Time</th>
                            <th class="px-6 py-3 font-medium">Customer</th>
                            <th class="px-6 py-3 font-medium">Service</th>
                            <th class="px-6 py-3 font-medium text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for apt in today_appointments %}
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 text-sm font-medium text-slate-900 whitespace-nowrap">{{ apt.time|date("g:i A") }}</td>
                                <td class="px-6 py-4 text-sm text-slate-700 font-medium">{{ apt.customer }}</td>
                                <td class="px-6 py-4 text-sm text-slate-500">{{ apt.service }}</td>
                                <td class="px-6 py-4 text-right">
                                    {% if apt.status == 'scheduled' or apt.status == 'pending' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Scheduled</span>
                                    {% elseif apt.status == 'approved' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Approved</span>
                                    {% elseif apt.status == 'done' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Done</span>
                                    {% elseif apt.status == 'paid' or apt.status == 'completed' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
                                    {% elseif apt.status == 'cancelled' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Cancelled</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800 capitalize">{{ apt.status }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="p-8 text-center text-slate-500 text-sm">No appointments scheduled for today.</div>
        {% endif %}
    </div>

    <!-- Tomorrow's Appointments -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
            <h3 class="text-base font-bold text-slate-900">Tomorrow's Schedule</h3>
            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ tomorrow_appointments|length }}</span>
        </div>
        {% if tomorrow_appointments|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-xs text-slate-500 bg-slate-50/50 uppercase font-bold tracking-wider">
                            <th class="px-6 py-3 font-medium">Time</th>
                            <th class="px-6 py-3 font-medium">Customer</th>
                            <th class="px-6 py-3 font-medium">Service</th>
                            <th class="px-6 py-3 font-medium text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for apt in tomorrow_appointments %}
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 text-sm font-medium text-slate-900 whitespace-nowrap">{{ apt.time|date("g:i A") }}</td>
                                <td class="px-6 py-4 text-sm text-slate-700 font-medium">{{ apt.customer }}</td>
                                <td class="px-6 py-4 text-sm text-slate-500">{{ apt.service }}</td>
                                <td class="px-6 py-4 text-right">
                                    {% if apt.status == 'scheduled' or apt.status == 'pending' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Scheduled</span>
                                    {% elseif apt.status == 'approved' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Approved</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800 capitalize">{{ apt.status }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="p-8 text-center text-slate-500 text-sm">No appointments scheduled for tomorrow.</div>
        {% endif %}
    </div>

</div>

{% endblock %}

{% block scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Commission Trend Bar Chart
        var commissionOptions = {
            series: [{
                name: 'Commission',
                data: {{ charts.commission_series|raw }}
            }],
            chart: {
                type: 'bar',
                height: 300,
                toolbar: { show: false },
                fontFamily: 'Inter, sans-serif'
            },
            plotOptions: {
                bar: {
                    borderRadius: 4,
                    columnWidth: '40%',
                }
            },
            colors: ['#d4af37'],
            dataLabels: { enabled: false },
            xaxis: {
                categories: {{ charts.commission_labels|raw }},
                axisBorder: { show: false },
                axisTicks: { show: false }
            },
            yaxis: {
                labels: { formatter: function (value) { return "QAR " + value; } }
            },
            grid: {
                borderColor: '#f1f5f9',
                strokeDashArray: 4,
                yaxis: { lines: { show: true } }
            }
        };

        var commissionChart = new ApexCharts(document.querySelector("#commission-chart"), commissionOptions);
        commissionChart.render();

        // Stylist Services Donut Chart
        var servicesOptions = {
            series: {{ charts.services_series|raw }},
            chart: {
                type: 'donut',
                height: 320,
                fontFamily: 'Inter, sans-serif'
            },
            labels: {{ charts.services_labels|raw }},
            colors: ['#0f172a', '#d4af37', '#94a3b8', '#475569'],
            dataLabels: { enabled: false },
            plotOptions: {
                pie: { donut: { size: '70%' } }
            },
            legend: { position: 'bottom' }
        };

        var servicesChart = new ApexCharts(document.querySelector("#services-chart"), servicesOptions);
        servicesChart.render();
    });
</script>
{% endblock %}
