<div id="employee-appointments-container">
    <div class="mb-4">
        <div class="relative w-full max-w-md px-6 pt-4">
            <div class="absolute inset-y-0 left-6 pl-3 flex items-center pointer-events-none mt-4">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input type="search" name="search" value="{{ search }}" placeholder="Search appointments..." 
                   hx-get="/web/employees/{{ employee_id }}/appointments?sort={{ sort }}&dir={{ dir }}" 
                   hx-target="#employee-appointments-container" hx-select="#employee-appointments-container" hx-swap="outerHTML" 
                   hx-trigger="keyup changed delay:500ms, search"
                   class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-salon-accent focus:border-salon-accent sm:text-sm transition-colors">
        </div>
    </div>

    {% if appointments|length > 0 %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 border-t border-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/employees/{{ employee_id }}/appointments?sort=date&dir={{ sort == 'date' and dir == 'asc' ? 'desc' : 'asc' }}&search={{ search }}"
                            hx-target="#employee-appointments-container" hx-select="#employee-appointments-container" hx-swap="outerHTML">
                            Date & Time {% if sort == 'date' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Service</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for apt in appointments %}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                {{ apt.date|date("M d, Y") }} <span class="text-gray-500">{{ apt.time|date("g:i A") }}</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ apt.customer_name|default('Walk-in') }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ apt.service }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            
            {% if pagination.total_pages > 1 %}
            <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex items-center justify-between">
                <p class="text-sm text-gray-700">
                    Showing <span class="font-medium">{{ (pagination.page - 1) * pagination.limit + 1 }}</span> to 
                    <span class="font-medium">{{ min(pagination.page * pagination.limit, pagination.total) }}</span> of 
                    <span class="font-medium">{{ pagination.total }}</span> results
                </p>
                <div class="flex gap-1">
                    {% for p in 1..pagination.total_pages %}
                        <button hx-get="/web/employees/{{ employee_id }}/appointments?page={{ p }}&sort={{ sort }}&dir={{ dir }}&search={{ search }}"
                                hx-target="#employee-appointments-container" hx-select="#employee-appointments-container" hx-swap="outerHTML"
                                class="px-3 py-1 text-sm border rounded-md transition-colors {% if pagination.page == p %}bg-salon-accent text-white border-salon-accent{% else %}bg-white text-gray-700 border-gray-300 hover:bg-gray-50{% endif %}">
                            {{ p }}
                        </button>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    {% else %}
        <div class="p-10 text-center text-gray-500">
            <svg class="mx-auto h-12 w-12 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p>No appointments assigned yet.</p>
        </div>
    {% endif %}
</div>
