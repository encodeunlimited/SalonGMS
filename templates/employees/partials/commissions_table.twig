<div id="employee-commissions-container">
    <div class="mb-4">
        <div class="relative w-full max-w-md px-6 pt-4">
            <div class="absolute inset-y-0 left-6 pl-3 flex items-center pointer-events-none mt-4">
                <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input type="search" name="search" value="{{ search }}" placeholder="Search commissions..." 
                   hx-get="/web/employees/{{ employee_id }}/commissions?sort={{ sort }}&dir={{ dir }}" 
                   hx-target="#employee-commissions-container" hx-select="#employee-commissions-container" hx-swap="outerHTML" 
                   hx-trigger="keyup changed delay:500ms, search"
                   class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors">
        </div>
    </div>

    {% if commissions|length > 0 %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-slate-50 border-t border-slate-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/employees/{{ employee_id }}/commissions?sort=created_at&dir={{ sort == 'created_at' and dir == 'asc' ? 'desc' : 'asc' }}&search={{ search }}"
                            hx-target="#employee-commissions-container" hx-select="#employee-commissions-container" hx-swap="outerHTML">
                            Date {% if sort == 'created_at' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/employees/{{ employee_id }}/commissions?sort=invoice_id&dir={{ sort == 'invoice_id' and dir == 'asc' ? 'desc' : 'asc' }}&search={{ search }}"
                            hx-target="#employee-commissions-container" hx-select="#employee-commissions-container" hx-swap="outerHTML">
                            Invoice # {% if sort == 'invoice_id' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/employees/{{ employee_id }}/commissions?sort=amount&dir={{ sort == 'amount' and dir == 'asc' ? 'desc' : 'asc' }}&search={{ search }}"
                            hx-target="#employee-commissions-container" hx-select="#employee-commissions-container" hx-swap="outerHTML">
                            Amount {% if sort == 'amount' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for comm in commissions %}
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900">{{ comm.invoice_date|date("M d, Y h:i A") }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">INV-{{ "%05d"|format(comm.invoice_id) }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-indigo-600 font-bold text-right">+QAR {{ comm.amount|number_format(2) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            
            {% if pagination.total_pages > 1 %}
            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
                <p class="text-sm text-slate-700">
                    Showing <span class="font-medium">{{ (pagination.page - 1) * pagination.limit + 1 }}</span> to 
                    <span class="font-medium">{{ min(pagination.page * pagination.limit, pagination.total) }}</span> of 
                    <span class="font-medium">{{ pagination.total }}</span> results
                </p>
                <div class="flex gap-1">
                    {% for p in 1..pagination.total_pages %}
                        <button hx-get="/web/employees/{{ employee_id }}/commissions?page={{ p }}&sort={{ sort }}&dir={{ dir }}&search={{ search }}"
                                hx-target="#employee-commissions-container" hx-select="#employee-commissions-container" hx-swap="outerHTML"
                                class="px-3 py-1 text-sm border rounded-md transition-colors {% if pagination.page == p %}bg-indigo-600 text-white border-indigo-600{% else %}bg-white text-slate-700 border-slate-300 hover:bg-slate-50{% endif %}">
                            {{ p }}
                        </button>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    {% else %}
        <div class="p-10 text-center text-slate-500">
            <svg class="mx-auto h-12 w-12 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p>No commissions earned yet.</p>
        </div>
    {% endif %}
</div>
