<tr id="employee-row-{{ employee.id }}" class="hover:bg-gray-50 transition-colors">
    <td class="px-6 py-5 whitespace-nowrap">
        <div class="flex items-center">
            {% if employee.profile_image %}
                <img src="{{ employee.profile_image }}" alt="{{ employee.name }}" class="w-8 h-8 rounded-full object-cover mr-3 shadow-sm">
            {% else %}
                <div class="w-8 h-8 rounded-full bg-salon-dark text-white flex items-center justify-center font-bold text-xs mr-3 shadow-sm">
                    {{ employee.name|slice(0, 1)|upper }}
                </div>
            {% endif %}
            <span class="font-medium text-gray-900">{{ employee.name }}</span>
        </div>
    </td>
    <td class="px-6 py-5 text-gray-600">{{ employee.email }}</td>
    <td class="px-6 py-5">
        {% if employee.role == 'admin' %}
            <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs font-medium">Admin</span>
        {% elseif employee.role == 'cashier' %}
            <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">Cashier</span>
        {% elseif employee.role == 'manager' %}
            <span class="px-2 py-1 bg-purple-100 text-purple-700 rounded-full text-xs font-medium">Manager</span>
        {% elseif employee.role == 'receptionist' %}
            <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">Receptionist</span>
        {% else %}
            <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">Stylist</span>
        {% endif %}
    </td>
    <td class="px-6 py-5 text-gray-600">
        {{ employee.commission_rate|number_format(2) }}%
    </td>
    <td class="px-6 py-5 text-right flex justify-end gap-2">
        <a href="/web/employees/{{ employee.id }}/profile" class="text-gray-400 hover:text-salon-accent transition-colors" title="View Profile">
            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        </a>
        <button hx-get="/web/employees/{{ employee.id }}/edit" hx-target="#modal-container" class="text-gray-400 hover:text-salon-accent transition-colors">
            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        </button>
        {% if auth_user.role == 'admin' %}
        <button hx-delete="/web/employees/{{ employee.id }}" 
                hx-confirm="Are you sure you want to delete this employee? This action cannot be undone." 
                hx-target="closest tr" 
                hx-swap="outerHTML" 
                class="text-gray-400 hover:text-red-500 transition-colors ml-2">
            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
        </button>
        {% endif %}
    </td>
</tr>

