{% extends "layout.twig" %}

{% block content %}
<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-900 tracking-tight">{{ title }}</h2>
    <p class="text-sm text-slate-500 mt-1">
        {% if category %}Update the details for this expense category.{% else %}Add a new category to organize your operational costs.{% endif %}
    </p>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 max-w-lg">
    <form action="{% if category %}/web/expenses/categories/{{ category.id }}/edit{% else %}/web/expenses/categories{% endif %}" method="POST" class="p-6 space-y-6">
        
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Category Name <span class="text-red-500">*</span></label>
            <input type="text" name="name" value="{{ category.name|default('') }}" required placeholder="e.g. Office Supplies" class="w-full border-slate-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
        </div>
        
        <div class="flex items-center space-x-3 pt-4 border-t border-slate-100">
            <button type="submit" class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-indigo-700 shadow-sm transition-colors">
                {% if category %}Save Changes{% else %}Create Category{% endif %}
            </button>
            <a href="/web/expenses/categories" class="bg-slate-100 text-slate-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors">
                Cancel
            </a>
        </div>
    </form>
</div>
{% endblock %}
