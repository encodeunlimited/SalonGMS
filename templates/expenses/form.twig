{% extends "layout.twig" %}

{% block content %}
<style>
    /* Normalize TomSelect height to match standard Tailwind inputs */
    .ts-wrapper.compact-ts .ts-control {
        min-height: 38px !important;
        height: 38px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        display: flex;
        align-items: center;
    }
    .ts-wrapper.compact-ts .ts-control .item, .ts-wrapper.compact-ts .ts-control input {
        line-height: normal !important;
        margin-bottom: 0 !important;
        margin-top: 0 !important;
    }
</style>
<div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Edit Expense</h2>
    <p class="text-sm text-gray-500 mt-1">Update details for this operational cost.</p>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 max-w-2xl">
    <form action="/web/expenses/{{ expense.id }}/edit" method="POST" class="p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Date <span class="text-red-500">*</span></label>
                <input type="date" name="expense_date" value="{{ expense.expense_date }}" required class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Category <span class="text-red-500">*</span></label>
                <select name="category" required x-data x-init="new TomSelect($el, { placeholder: 'Select Category', wrapperClass: 'ts-wrapper compact-ts' })" class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                    <option value="">Select Category</option>
                    {% for cat in categories %}
                        <option value="{{ cat.name }}" {% if expense.category == cat.name %}selected{% endif %}>{{ cat.name }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Amount (QAR) <span class="text-red-500">*</span></label>
                <input type="number" step="0.01" min="0" name="amount" value="{{ expense.amount }}" required class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Payment Method</label>
                <select name="payment_method" class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                    <option value="Cash" {% if expense.payment_method == 'Cash' %}selected{% endif %}>Cash</option>
                    <option value="Card" {% if expense.payment_method == 'Card' %}selected{% endif %}>Card</option>
                    <option value="Bank Transfer" {% if expense.payment_method == 'Bank Transfer' %}selected{% endif %}>Bank Transfer</option>
                    <option value="Other" {% if expense.payment_method == 'Other' %}selected{% endif %}>Other</option>
                </select>
            </div>
        </div>
        
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
            <textarea name="description" rows="3" class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">{{ expense.description }}</textarea>
        </div>
        
        <div class="pt-4 flex justify-end space-x-3 border-t border-gray-100">
            <a href="/web/expenses" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</a>
            <button type="submit" class="px-4 py-2 bg-salon-dark text-white rounded-md text-sm font-medium hover:bg-salon-navy shadow-sm">Update Expense</button>
        </div>
    </form>
</div>
{% endblock %}
