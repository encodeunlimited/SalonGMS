{% extends "layout.twig" %}

{% block content %}
<style>
    /* Normalize TomSelect height to match standard Tailwind inputs */
    .ts-wrapper.compact-ts .ts-control {
        min-height: 38px !important;
        height: 38px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        display: flex;
        align-items: center;
    }
    .ts-wrapper.compact-ts .ts-control .item, .ts-wrapper.compact-ts .ts-control input {
        line-height: normal !important;
        margin-bottom: 0 !important;
        margin-top: 0 !important;
    }
</style>
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Expenses</h2>
        <p class="text-sm text-gray-500 mt-1">Track and manage your salon's operational costs.</p>
    </div>
    
    <div class="flex items-center space-x-3">
        <!-- Manage Categories Button -->
        <a href="/web/expenses/categories" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-200 shadow-sm transition-colors flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
            Categories
        </a>
        <!-- Add New Button -->
        <button onclick="document.getElementById('addExpenseModal').classList.remove('hidden')" class="bg-salon-dark text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-salon-navy shadow-sm transition-colors flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add Expense
        </button>
    </div>
</div>

<!-- Filters & Summary -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <form method="GET" action="/web/expenses" class="flex flex-wrap items-center gap-4">
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">From Date</label>
            <input type="date" name="start_date" value="{{ start_date }}" class="text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-salon-accent focus:border-salon-accent text-gray-900">
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">To Date</label>
            <input type="date" name="end_date" value="{{ end_date }}" class="text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-salon-accent focus:border-salon-accent text-gray-900">
        </div>
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Category</label>
            <select name="category" x-data x-init="new TomSelect($el, { placeholder: 'All Categories', wrapperClass: 'ts-wrapper compact-ts' })" class="text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-salon-accent focus:border-salon-accent text-gray-900 min-w-[200px]">
                <option value="">All Categories</option>
                {% for cat in categories %}
                    <option value="{{ cat.name }}" {% if selected_category == cat.name %}selected{% endif %}>{{ cat.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="pt-5">
            <button type="submit" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors">
                Filter
            </button>
        </div>
    </form>
    
    <div class="text-right">
        <p class="text-sm font-medium text-gray-500">Total Expenses (Selected Period)</p>
        <p class="text-2xl font-bold text-red-600">QAR {{ total_expenses|number_format(2) }}</p>
    </div>
</div>

<!-- Expenses List -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 text-xs uppercase tracking-wider text-gray-500 border-b border-gray-100">
                    <th class="px-6 py-4 font-semibold">Date</th>
                    <th class="px-6 py-4 font-semibold">Category</th>
                    <th class="px-6 py-4 font-semibold">Description</th>
                    <th class="px-6 py-4 font-semibold">Payment Method</th>
                    <th class="px-6 py-4 font-semibold text-right">Amount</th>
                    <th class="px-6 py-4 font-semibold text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for expense in expenses %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 text-sm font-medium text-gray-900">{{ expense.expense_date|date('M d, Y') }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                {{ expense.category }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">{{ expense.description|default('-') }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ expense.payment_method|default('-') }}</td>
                        <td class="px-6 py-4 text-sm font-bold text-red-600 text-right">QAR {{ expense.amount|number_format(2) }}</td>
                        <td class="px-6 py-4 text-right space-x-2">
                            <a href="/web/expenses/{{ expense.id }}/edit" class="text-blue-600 hover:text-blue-900 text-sm font-medium">Edit</a>
                            <form method="POST" action="/web/expenses/{{ expense.id }}/delete" class="inline" onsubmit="return confirm('Are you sure you want to delete this expense?');">
                                <button type="submit" class="text-red-600 hover:text-red-900 text-sm font-medium">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500 text-sm">
                            No expenses found for the selected filters.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    {% if pagination.total_pages > 1 %}
    <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex items-center justify-between">
        <span class="text-sm text-gray-500">Showing page {{ pagination.page }} of {{ pagination.total_pages }}</span>
        <div class="flex space-x-2">
            {% if pagination.page > 1 %}
                <a href="?page={{ pagination.page - 1 }}&start_date={{ start_date }}&end_date={{ end_date }}&category={{ selected_category }}" class="px-3 py-1 bg-white border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50">Previous</a>
            {% endif %}
            {% if pagination.page < pagination.total_pages %}
                <a href="?page={{ pagination.page + 1 }}&start_date={{ start_date }}&end_date={{ end_date }}&category={{ selected_category }}" class="px-3 py-1 bg-white border border-gray-300 rounded-md text-sm text-gray-700 hover:bg-gray-50">Next</a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>

<!-- Add Expense Modal -->
<div id="addExpenseModal" class="fixed inset-0 bg-gray-900/50 hidden z-50 flex items-center justify-center backdrop-blur-sm">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full mx-4 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-lg font-bold text-gray-900">Add New Expense</h3>
            <button onclick="document.getElementById('addExpenseModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <form action="/web/expenses" method="POST" class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Date <span class="text-red-500">*</span></label>
                <input type="date" name="expense_date" value="{{ "now"|date("Y-m-d") }}" required class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Category <span class="text-red-500">*</span></label>
                <select name="category" required x-data x-init="new TomSelect($el, { placeholder: 'Select Category', wrapperClass: 'ts-wrapper compact-ts' })" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-salon-accent focus:border-salon-accent text-gray-900">
                    <option value="">Select Category</option>
                    {% for cat in categories %}
                        <option value="{{ cat.name }}">{{ cat.name }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Amount (QAR) <span class="text-red-500">*</span></label>
                <input type="number" step="0.01" min="0" name="amount" required class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm" placeholder="0.00">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Payment Method</label>
                <select name="payment_method" class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea name="description" rows="2" class="w-full border-gray-300 rounded-lg shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm" placeholder="Optional details..."></textarea>
            </div>
            
            <div class="pt-4 flex justify-end space-x-3">
                <button type="button" onclick="document.getElementById('addExpenseModal').classList.add('hidden')" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-salon-dark text-white rounded-md text-sm font-medium hover:bg-salon-navy shadow-sm">Save Expense</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
