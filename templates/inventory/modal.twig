<div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true" x-data="{ open: true }" x-show="open">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" x-show="open" x-transition.opacity @click="open = false; setTimeout(() => $el.closest('#modal-container').innerHTML = '', 300)"></div>

        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <!-- Modal panel -->
        <div class="inline-block align-bottom bg-white rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full" x-show="open" x-transition>
            
            <!-- Header -->
            <div class="bg-gray-50 px-4 py-3 sm:px-6 border-b border-gray-100 flex justify-between items-center">
                <h3 class="text-lg leading-6 font-bold text-gray-900" id="modal-title">
                    {{ item ? 'Edit Product' : 'Create Product' }}
                </h3>
                <button type="button" @click="open = false; setTimeout(() => $el.closest('#modal-container').innerHTML = '', 300)" class="text-gray-400 hover:text-gray-500 p-2 -mr-2 bg-gray-50 rounded-full hover:bg-gray-100 transition-colors">
                    <span class="sr-only">Close</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Body -->
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <form hx-post="{{ item ? '/web/inventory/' ~ item.id ~ '/edit' : '/web/inventory/create' }}"
                      @htmx:after-request="if($event.detail.successful) { open = false; setTimeout(() => $el.closest('#modal-container').innerHTML = '', 300); }">
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Name</label>
                            <input type="text" name="name" value="{{ item.name }}" required class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">SKU</label>
                            <input type="text" name="sku" value="{{ item.sku }}" class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">Description</label>
                            <textarea name="description" rows="3" class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm">{{ item.description }}</textarea>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            {% if item %}
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Current Stock</label>
                                <input type="number" value="{{ item.quantity }}" readonly class="mt-1 block w-full py-2 px-3 border border-gray-200 bg-gray-50 text-gray-500 rounded-md shadow-sm sm:text-sm cursor-not-allowed">
                                <p class="text-xs text-gray-500 mt-1">Use Stock In/Out to modify stock</p>
                            </div>
                            {% endif %}
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Price</label>
                                <div class="mt-1 relative rounded-md shadow-sm">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <span class="text-gray-500 sm:text-sm">QAR</span>
                                    </div>
                                    <input type="number" name="price" value="{{ item.price|default('0.00') }}" step="0.01" required class="block w-full pl-12 py-2 pr-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-6 sm:flex sm:flex-row-reverse border-t border-gray-100 pt-4">
                        <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-5 py-3 bg-salon-dark text-base font-medium text-white hover:bg-salon-navy focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-salon-dark sm:ml-3 sm:w-auto sm:text-sm transition-colors">
                            {{ item ? 'Update Product' : 'Create Product' }}
                        </button>
                        <button type="button" @click="open = false; setTimeout(() => $el.closest('#modal-container').innerHTML = '', 300)" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-5 py-3 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm transition-colors">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

