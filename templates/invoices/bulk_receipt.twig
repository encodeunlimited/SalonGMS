<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        @page {
            margin: 0;
            padding: 0;
        }
        body {
            margin: 0;
            padding: 10px;
            font-family: 'Helvetica', 'Arial', sans-serif;
            font-size: 11px;
            color: #000;
            width: 100%;
            box-sizing: border-box;
            background: #fff;
        }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .text-left { text-align: left; }
        .font-bold { font-weight: bold; }
        .mt-2 { margin-top: 5px; }
        .mt-4 { margin-top: 10px; }
        .mt-8 { margin-top: 20px; }
        .mb-2 { margin-bottom: 5px; }
        .mb-4 { margin-bottom: 10px; }
        .border-b { border-bottom: 1px dashed #000; }
        .border-t { border-top: 1px dashed #000; }
        .py-2 { padding-top: 5px; padding-bottom: 5px; }
        
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 3px 0;
        }
        
        /* Clearfix */
        .cf::after {
            content: "";
            display: table;
            clear: both;
        }
        .flex-row {
            width: 100%;
            clear: both;
        }
        .col-left {
            float: left;
            width: 50%;
            text-align: left;
        }
        .col-right {
            float: right;
            width: 50%;
            text-align: right;
        }
        
        .no-print {
            display: none !important;
        }
        @media screen {
            body {
                width: 300px; /* Approximate 80mm equivalent for screen preview */
                margin: 20px auto;
                border: 1px solid #eee;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
            }
            .no-print {
                display: block !important;
                text-align: center;
                margin-top: 20px;
            }
            .print-btn {
                background: #000;
                color: #fff;
                border: none;
                padding: 10px 20px;
                cursor: pointer;
                border-radius: 4px;
            }
        }
    </style>
</head>
<body>
    <div class="text-center font-bold" style="font-size: 16px;">SalonMS</div>
    <div class="text-center mt-2 mb-4">
        Thank you for your business!
    </div>
    
    <div class="border-b mb-2"></div>
    
    <div class="text-center font-bold mb-2">CONSOLIDATED PAYMENT RECEIPT</div>

    <div class="cf mt-2">
        <div class="col-left">Date:</div>
        <div class="col-right">{{ invoices[0].created_at|date('M j, Y H:i') }}</div>
    </div>
    <div class="cf mt-2">
        <div class="col-left">Customer:</div>
        <div class="col-right">{{ invoices[0].customer_name|default('Walk-in') }}</div>
    </div>
    
    <div class="border-b mt-4 mb-2"></div>
    
    <table>
        <thead>
            <tr class="border-b">
                <th class="text-left font-bold">Invoice ID</th>
                <th class="text-right font-bold">Total</th>
            </tr>
        </thead>
        <tbody>
            {% set grand_total = 0 %}
            {% for invoice in invoices %}
            {% set grand_total = grand_total + invoice.total_amount %}
            <tr>
                <td class="text-left py-2 font-bold">
                    #INV-{{ "%05d"|format(invoice.id) }}
                </td>
                <td class="text-right font-bold">
                    {{ invoice.total_amount|number_format(2) }}
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-left" style="padding-left: 10px; font-style: italic;">
                    {% for item in invoice.items %}
                        - {{ item.description }} <br>
                    {% endfor %}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="2" class="text-center py-2">No invoices found.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    
    <div class="border-t mt-2 mb-2"></div>
    
    <div class="cf">
        <div class="col-left font-bold">Total Paid (QAR):</div>
        <div class="col-right font-bold" style="font-size: 14px;">{{ grand_total|number_format(2) }}</div>
    </div>
    
    <div class="mt-4 text-center">
        <div class="font-bold text-center">
            ALL INVOICES SETTLED
        </div>
    </div>
    
    <div class="text-center mt-8" style="font-size: 10px;">
        Please keep this receipt for your records.
    </div>

    <div class="no-print">
        <button onclick="window.print()" class="print-btn">Print Receipt</button>
    </div>
</body>
</html>
