<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        @page {
            margin: 0;
            padding: 0;
        }
        body {
            margin: 0;
            padding: 10px;
            font-family: 'Helvetica', 'Arial', sans-serif;
            font-size: 11px;
            color: #000;
            width: 100%;
            box-sizing: border-box;
            background: #fff;
        }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .text-left { text-align: left; }
        .font-bold { font-weight: bold; }
        .mt-2 { margin-top: 5px; }
        .mt-4 { margin-top: 10px; }
        .mt-8 { margin-top: 20px; }
        .mb-2 { margin-bottom: 5px; }
        .mb-4 { margin-bottom: 10px; }
        .border-b { border-bottom: 1px dashed #000; }
        .border-t { border-top: 1px dashed #000; }
        .py-2 { padding-top: 5px; padding-bottom: 5px; }
        
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 3px 0;
        }
        
        /* Clearfix */
        .cf::after {
            content: "";
            display: table;
            clear: both;
        }
        .flex-row {
            width: 100%;
            clear: both;
        }
        .col-left {
            float: left;
            width: 50%;
            text-align: left;
        }
        .col-right {
            float: right;
            width: 50%;
            text-align: right;
        }
        
        .no-print {
            display: none !important;
        }
        @media screen {
            body {
                width: 300px; /* Approximate 80mm equivalent for screen preview */
                margin: 20px auto;
                border: 1px solid #eee;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
            }
            .no-print {
                display: block !important;
                text-align: center;
                margin-top: 20px;
            }
            .print-btn {
                background: #000;
                color: #fff;
                border: none;
                padding: 10px 20px;
                cursor: pointer;
                border-radius: 4px;
            }
        }
    </style>
</head>
<body>
    <div class="text-center font-bold" style="font-size: 16px;">SalonMS</div>
    <div class="text-center mt-2 mb-4">
        Thank you for your business!
    </div>
    
    <div class="border-b mb-2"></div>
    
    <div class="cf">
        <div class="col-left font-bold">INVOICE</div>
        <div class="col-right">#INV-{{ "%05d"|format(invoice.id) }}</div>
    </div>
    <div class="cf mt-2">
        <div class="col-left">Date:</div>
        <div class="col-right">{{ invoice.created_at|date('M j, Y') }}</div>
    </div>
    <div class="cf mt-2">
        <div class="col-left">Time:</div>
        <div class="col-right">{{ invoice.created_at|date('h:i A') }}</div>
    </div>
    <div class="cf mt-2">
        <div class="col-left">Customer:</div>
        <div class="col-right">{{ invoice.customer_name|default('Walk-in') }}</div>
    </div>
    {% if invoice.stylist_name %}
    <div class="cf mt-2">
        <div class="col-left">Stylist:</div>
        <div class="col-right">{{ invoice.stylist_name }}</div>
    </div>
    {% endif %}
    <div class="cf mt-2">
        <div class="col-left">Status:</div>
        <div class="col-right">{{ invoice.status|upper }}</div>
    </div>
    
    <div class="border-b mt-4 mb-2"></div>
    
    <table>
        <thead>
            <tr class="border-b">
                <th class="text-left font-bold">Item</th>
                <th class="text-right font-bold">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for item in invoice.items %}
            <tr>
                <td colspan="2" class="text-left py-2">
                    {{ item.description }}
                </td>
            </tr>
            <tr>
                <td class="text-left" style="padding-left: 10px;">
                    {{ item.quantity }} x {{ item.unit_price|number_format(2) }}
                </td>
                <td class="text-right">
                    {{ item.subtotal|number_format(2) }}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="2" class="text-center py-2">No items found.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    
    <div class="border-t mt-2 mb-2"></div>
    
    <div class="cf">
        <div class="col-left font-bold">Total (QAR):</div>
        <div class="col-right font-bold" style="font-size: 14px;">{{ invoice.total_amount|number_format(2) }}</div>
    </div>
    
    <div class="mt-4">
        {% if invoice.status == 'paid' %}
            {% if invoice.payment_method == 'Split' and invoice.split_details %}
                {% set splits = invoice.split_details %}
                {% for split in splits %}
                <div class="cf py-2">
                    <div class="col-left">Paid ({{ split.method }}):</div>
                    <div class="col-right">{{ split.amount|number_format(2) }}</div>
                </div>
                {% endfor %}
            {% else %}
                <div class="cf py-2">
                    <div class="col-left">Paid ({{ invoice.payment_method|default('Cash') }}):</div>
                    <div class="col-right">{{ invoice.total_amount|number_format(2) }}</div>
                </div>
                {% if invoice.tender_amount %}
                <div class="cf py-2">
                    <div class="col-left">Tendered:</div>
                    <div class="col-right">{{ invoice.tender_amount|number_format(2) }}</div>
                </div>
                {% endif %}
            {% endif %}
            
            {% if invoice.change_amount %}
            <div class="cf py-2">
                <div class="col-left font-bold">Change:</div>
                <div class="col-right font-bold">{{ invoice.change_amount|number_format(2) }}</div>
            </div>
            {% endif %}
        {% else %}
            <div class="text-center mt-4 font-bold">
                BALANCE DUE: {{ invoice.total_amount|number_format(2) }}
            </div>
        {% endif %}
    </div>
    
    <div class="text-center mt-8" style="font-size: 10px;">
        Please keep this receipt for your records.
    </div>

    <div class="no-print" style="margin-top: 10px; text-align: center;">
        <button onclick="window.print()" class="print-btn">Print Receipt</button>
        {% if auto_print %}
            <button onclick="window.close()" class="print-btn" style="background: #666; margin-left: 10px;">Close Window</button>
        {% endif %}
    </div>

    {% if auto_print %}
    <script>
        window.onload = function() {
            window.print();
        };
        // Some browsers support onafterprint
        window.onafterprint = function() {
            window.close();
        };
    </script>
    {% endif %}
</body>
</html>
