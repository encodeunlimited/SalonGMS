<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Receipt #{{ invoice.id }}</title>
    <style>
        @page {
            margin: 0;
            size: 80mm auto; /* 80mm width, auto height */
        }
        body {
            margin: 0 auto;
            padding: 10px 15px; 
            font-family: 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif;
            font-size: 13px;
            color: #000;
            width: 80mm;
            max-width: 80mm;
            box-sizing: border-box;
            background: #fff;
            text-align: center;
        }
        .header-logo {
            background-color: #000;
            color: #fff;
            font-size: 16px;
            font-weight: bold;
            padding: 12px 5px;
            text-align: center;
            font-style: italic;
            margin-bottom: 10px;
            border-radius: 2px;
        }
        .header-title {
            font-size: 18px;
            font-weight: bold;
            line-height: 1.2;
            margin-bottom: 15px;
            text-transform: uppercase;
        }
        .info-grid {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        .info-box {
            border: 1px dashed #000;
            padding: 2px;
            flex: 1;
        }
        .info-box.left {
            margin-right: 5px;
            flex: 1.6;
        }
        .info-box.right {
            margin-left: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 16px;
        }
        .info-row {
            display: flex;
            border-bottom: 1px dashed #000;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            width: 50%;
            text-align: center;
            border-right: 1px dashed #000;
            padding: 4px 2px;
            font-weight: bold;
            font-size: 12px;
        }
        .info-value {
            width: 50%;
            text-align: center;
            padding: 4px 2px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
        }
        .arabic-text {
            font-weight: bold;
            display: block;
            margin-bottom: 2px;
            font-size: 14px;
        }
        table.items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        table.items-table th, table.items-table td {
            text-align: center;
            padding: 6px 2px;
        }
        table.items-table th {
            border-bottom: 1px dashed #000;
            border-top: 1px dashed #000;
            font-size: 12px;
        }
        table.items-table td {
            vertical-align: middle;
            font-weight: bold;
        }
        .item-desc {
            font-size: 14px;
            margin-top: 3px;
        }
        .totals-grid {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        .totals-box {
            border: 1px dashed #000;
            padding: 2px;
            flex: 1;
        }
        .totals-box.left {
            margin-right: 5px;
            flex: 1.2;
        }
        .totals-box.right {
            margin-left: 5px;
        }
        .totals-row {
            display: flex;
            border-bottom: 1px dashed #000;
        }
        .totals-row:last-child {
            border-bottom: none;
        }
        .totals-label {
            width: 60%;
            text-align: center;
            border-right: 1px dashed #000;
            padding: 4px 2px;
            font-weight: bold;
            font-size: 12px;
        }
        .totals-value {
            width: 40%;
            text-align: center;
            padding: 4px 2px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }
        .footer {
            font-weight: bold;
            font-size: 13px;
            line-height: 1.5;
            border-bottom: 1px dashed #000;
            padding-bottom: 15px;
            margin-bottom: 15px;
        }
        .timestamp {
            font-size: 13px;
            margin-bottom: 20px;
        }
        
        .no-print {
            display: none !important;
        }
        @media screen {
            body {
                margin: 20px auto;
                border: 1px solid #ccc;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
                min-height: 100vh;
            }
            .no-print {
                display: block !important;
                text-align: center;
                margin-top: 20px;
                margin-bottom: 20px;
            }
            .print-btn {
                background: #000;
                color: #fff;
                border: none;
                padding: 10px 20px;
                cursor: pointer;
                border-radius: 4px;
                font-weight: bold;
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button class="print-btn" onclick="window.print()">Print Receipt</button>
        {% if auto_print %}
            <button onclick="window.close()" class="print-btn" style="background: #666; margin-left: 10px;">Close Window</button>
        {% endif %}
    </div>

    <div class="header-logo">
        Nabiha Henna
    </div>

    <div class="header-title">
        NABIHA HENNA<br>BEAUTY SALOON
    </div>

    <div class="info-grid">
        <div class="info-box left">
            <div class="info-row">
                <div class="info-label">
                    <span class="arabic-text" dir="rtl">رقم الفاتورة</span>
                    Invoice no
                </div>
                <div class="info-value">{{ invoice.id }}</div>
            </div>
            <div class="info-row">
                <div class="info-label">
                    <span class="arabic-text" dir="rtl">العميل</span>
                    Customer
                </div>
                <div class="info-value">{{ invoice.customer_name|default('Walk-in') }}</div>
            </div>
            <div class="info-row" style="border-bottom: none;">
                <div class="info-label">
                    <span class="arabic-text" dir="rtl">رقم التليفون</span>
                    Mobile
                </div>
                <div class="info-value">{{ invoice.customer_phone|default('-') }}</div>
            </div>
        </div>
        <div class="info-box right">
            {{ invoice.payment_method|default('CASH')|upper }}
        </div>
    </div>

    <table class="items-table">
        <thead>
            <tr>
                <th style="width: 35%;">
                    <span class="arabic-text" dir="rtl">الصنف</span>
                    Item
                </th>
                <th style="width: 25%;">
                    <span class="arabic-text" dir="rtl">موظفة</span>
                    Staff
                </th>
                <th style="width: 10%;">
                    <span class="arabic-text" dir="rtl">كمية</span>
                    Qty
                </th>
                <th style="width: 15%;">
                    <span class="arabic-text" dir="rtl">سعر</span>
                    Price
                </th>
                <th style="width: 15%;">
                    <span class="arabic-text" dir="rtl">اجمالى</span>
                    Total
                </th>
            </tr>
        </thead>
        <tbody>
            {% for item in invoice.items %}
            <tr>
                <td>
                    {% if item.arabic_description %}
                    <div class="arabic-text" dir="rtl">{{ item.arabic_description }}</div>
                    {% endif %}
                    <div class="item-desc">{{ item.description }}</div>
                </td>
                <td>{{ invoice.stylist_name|default('-')|upper }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ item.unit_price|number_format(0) }}</td>
                <td>{{ item.subtotal|number_format(0) }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5">No items found.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="totals-grid">
        <div class="totals-box left">
            <div class="totals-row">
                <div class="totals-label">
                    <span class="arabic-text" dir="rtl">اجمالى الفاتورة</span>
                    Total
                </div>
                <div class="totals-value">{{ invoice.total_amount|number_format(0) }}</div>
            </div>
            <div class="totals-row">
                <div class="totals-label">
                    <span class="arabic-text" dir="rtl">الخصم</span>
                    Discount
                </div>
                <div class="totals-value">0</div>
            </div>
            <div class="totals-row" style="border-bottom: none;">
                <div class="totals-label">
                    <span class="arabic-text" dir="rtl">الصافى</span>
                    Net
                </div>
                <div class="totals-value">{{ invoice.total_amount|number_format(0) }}</div>
            </div>
        </div>
        <div class="totals-box right">
            <div class="totals-row">
                <div class="totals-label">
                    <span class="arabic-text" dir="rtl">المدفوع</span>
                    paid
                </div>
                <div class="totals-value">{{ (invoice.tender_amount > 0 ? invoice.tender_amount : invoice.total_amount)|number_format(0) }}</div>
            </div>
            <div class="totals-row" style="border-bottom: none;">
                <div class="totals-label">
                    <span class="arabic-text" dir="rtl">الباقى</span>
                    Balance
                </div>
                <div class="totals-value">{{ invoice.change_amount|default(0)|number_format(0) }}</div>
            </div>
        </div>
    </div>

    <div class="footer">
        <div>Building 89 Al Hamad ST. AL Rayyan</div>
        <div style="display: flex; justify-content: center; gap: 20px; margin-top: 5px;">
            <div>40013662</div>
            <div>30576865</div>
        </div>
        <div style="display: flex; justify-content: center; gap: 20px; margin-top: 5px;">
            <div>IG:- nabiha_henna_qtr</div>
            <div>snap:- nabihahennaqtr</div>
        </div>
        <div class="arabic-text" dir="rtl" style="font-size: 16px; margin-top: 15px;">
            مرحبا بكم في صالوننا
        </div>
    </div>

    <div class="timestamp">
        {{ invoice.created_at|date('l, M j, Y g:i A') }}
    </div>

    <script>
        {% if auto_print %}
        window.onload = function() {
            window.print();
        };
        window.onafterprint = function() {
            window.close();
        };
        {% else %}
        if (window.location.search.includes('print=1')) {
            window.onload = function() { window.print(); }
        }
        {% endif %}
    </script>
</body>
</html>
