<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <script src="/assets/vendor/tailwindcss.js"></script>
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; }
        }
    </style>
</head>
<body class="bg-gray-50 p-4 sm:p-8 font-sans">
    <div class="max-w-3xl mx-auto bg-white p-8 rounded-lg shadow-sm border border-gray-100">
        <!-- Header -->
        <div class="flex justify-between items-start border-b border-gray-200 pb-6 mb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">INVOICE</h1>
                <p class="text-gray-500 mt-1">#INV-{{ "%05d"|format(invoice.id) }}</p>
            </div>
            <div class="text-right">
                <div class="font-bold text-gray-900 text-lg">SalonMS</div>
                <p class="text-sm text-gray-500 mt-1">Thank you for your business!</p>
            </div>
        </div>

        <!-- Customer & Info -->
        <div class="flex justify-between mb-8">
            <div>
                <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">Billed To</p>
                <div class="text-gray-900 font-medium">{{ invoice.customer_name|default('Walk-in Customer') }}</div>
                {% if invoice.customer_phone %}<div class="text-sm text-gray-600">{{ invoice.customer_phone }}</div>{% endif %}
                {% if invoice.customer_email %}<div class="text-sm text-gray-600">{{ invoice.customer_email }}</div>{% endif %}
            </div>
            <div class="text-right">
                <div class="mb-2">
                    <span class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Date:</span>
                    <span class="text-gray-900 font-medium ml-2">{{ invoice.created_at|date('M j, Y') }}</span>
                </div>
                <div>
                    <span class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Status:</span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ml-2 {% if invoice.status == 'paid' %}bg-green-100 text-green-800{% else %}bg-yellow-100 text-yellow-800{% endif %}">
                        {{ invoice.status|upper }}
                    </span>
                </div>
            </div>
        </div>

        <!-- Items -->
        <div class="mb-8 overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-gray-200 text-sm text-gray-500">
                        <th class="py-3 px-2 font-semibold">Description</th>
                        <th class="py-3 px-2 font-semibold text-center">Qty</th>
                        <th class="py-3 px-2 font-semibold text-right">Price</th>
                        <th class="py-3 px-2 font-semibold text-right">Total</th>
                    </tr>
                </thead>
                <tbody class="text-gray-700">
                    {% for item in invoice.items %}
                    <tr class="border-b border-gray-100">
                        <td class="py-4 px-2">{{ item.description }}</td>
                        <td class="py-4 px-2 text-center">{{ item.quantity }}</td>
                        <td class="py-4 px-2 text-right">${{ item.unit_price|number_format(2) }}</td>
                        <td class="py-4 px-2 text-right font-medium">${{ item.subtotal|number_format(2) }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="py-4 px-2 text-center text-gray-500">No items found for this invoice.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <div class="flex justify-end mb-8">
            <div class="w-full max-w-sm">
                <div class="flex justify-between items-center py-3 border-b border-gray-100 text-gray-600">
                    <span>Subtotal</span>
                    <span>${{ invoice.total_amount|number_format(2) }}</span>
                </div>
                <div class="flex justify-between items-center py-4 text-xl font-bold text-gray-900">
                    <span>Total</span>
                    <span>${{ invoice.total_amount|number_format(2) }}</span>
                </div>
                
                {% if invoice.status == 'paid' %}
                <div class="flex justify-between items-center py-2 text-sm text-gray-500">
                    <span>Paid via {{ invoice.payment_method|default('Cash') }}</span>
                    {% if invoice.tender_amount %}
                    <span>Tendered: ${{ invoice.tender_amount|number_format(2) }}</span>
                    {% endif %}
                </div>
                {% if invoice.change_amount %}
                <div class="flex justify-between items-center py-1 text-sm text-gray-500">
                    <span>Change</span>
                    <span>${{ invoice.change_amount|number_format(2) }}</span>
                </div>
                {% endif %}
                {% endif %}
            </div>
        </div>
        
        <div class="text-center text-sm text-gray-500 border-t border-gray-200 pt-8">
            <p>If you have any questions about this invoice, please contact us.</p>
        </div>
        
        <div class="mt-8 text-center no-print">
            <button onclick="window.print()" class="px-6 py-2 bg-gray-900 text-white rounded shadow hover:bg-gray-800 transition-colors">
                Print / Save PDF
            </button>
        </div>
    </div>
</body>
</html>
