<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title ?? 'Dashboard' }} - SalonMS</title>
    <link rel="icon" type="image/png" href="/images/lsms.png">
    
    <!-- Google Fonts: Inter -->
    <link href="/assets/fonts/inter.css" rel="stylesheet">
    
    <!-- HTMX -->
    <script src="/assets/vendor/htmx.min.js"></script>
    
    <!-- Alpine.js -->
    <script defer src="/assets/vendor/alpine.min.js"></script>
    <style>[x-cloak] { display: none !important; }</style>
    
    <!-- ApexCharts -->
    <script src="/assets/vendor/apexcharts.min.js"></script>

    <!-- FullCalendar -->
    <script src='/assets/vendor/fullcalendar.min.js'></script>
    
    <!-- Tippy.js (Tooltips) -->
    <script src="/assets/vendor/popper.min.js"></script>
    <script src="/assets/vendor/tippy.min.js"></script>
    <link rel="stylesheet" href="/assets/vendor/tippy-light.css" />

    <!-- Tom Select for Searchable Dropdowns -->
    <link href="/assets/vendor/tom-select.css" rel="stylesheet">
    <script src="/assets/vendor/tom-select.min.js"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Tailwind CSS -->
    <script src="/assets/vendor/tailwindcss.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Smooth transitions for HTMX */
        .htmx-indicator{ display:none; }
        .htmx-request .htmx-indicator{ display:inline; }
        .htmx-request.htmx-indicator{ display:inline; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        /* Tom Select overrides (POSMobileS style) */
        .ts-wrapper { padding: 0 !important; border: none !important; background: transparent !important; box-shadow: none !important; }
        .ts-control { 
            border: 1px solid #e2e8f0 !important; 
            border-radius: 0.75rem !important; 
            padding: 0.625rem 1rem !important; 
            box-shadow: none !important; 
            background-color: #fff !important; 
            min-height: 42px !important; 
            font-size: 0.875rem !important;
        }
        .ts-control.focus { border-color: #6366f1 !important; box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important; outline: none !important; }
        
        /* Global Touch friendly inputs */
        input[type="text"], input[type="email"], input[type="password"], input[type="number"], input[type="search"], input[type="date"], select, textarea {
            min-height: 42px !important;
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased h-screen flex overflow-hidden" x-data="{ sidebarOpen: false }">

    <!-- Mobile Sidebar Overlay -->
    <div x-show="sidebarOpen" x-transition.opacity class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 md:hidden" @click="sidebarOpen = false" style="display: none;" x-cloak></div>

    <!-- Sidebar (Light Theme POSMobileS style) -->
    <aside class="w-64 bg-white border-r border-slate-200 flex flex-col z-50 transition-transform duration-300 flex-shrink-0 fixed inset-y-0 left-0 transform md:relative md:translate-x-0 {% if hide_sidebar %}hidden md:hidden{% else %}flex{% endif %}" :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'">
        <!-- Logo Area -->
        <div class="h-16 flex items-center px-6 border-b border-slate-200 shrink-0">
            <img src="/images/lsms.png" alt="SalonMS" class="w-8 h-8 mr-3 object-contain">
            <div>
                <h1 class="text-lg font-bold text-slate-900 leading-tight">Salon<span class="text-indigo-600">MS</span></h1>
                <span class="text-xs font-medium text-slate-500">Management System</span>
            </div>
        </div>
        
        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto py-4 space-y-2 px-4">
            <a href="/web/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'dashboard' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                Dashboard
            </a>
            
            {# <a href="/web/appointments" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'appointments' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="calendar" class="w-5 h-5"></i>
                Appointments
            </a> #}
            
            <a href="/web/pos" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'pos' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                POS & Billing
            </a>
            
            <a href="/web/customers" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'customers' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="users" class="w-5 h-5"></i>
                Customers
            </a>
            
            {% if auth_user.role in ['admin', 'receptionist', 'cashier'] %}
            <a href="/web/services" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'services' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="scissors" class="w-5 h-5"></i>
                Services
            </a>
            {% endif %}
            
            {# {% if auth_user.role in ['admin', 'cashier'] %}
            <a href="/web/packages" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'packages' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="package" class="w-5 h-5"></i>
                Packages
            </a>
            {% endif %} #}
            
            {% if auth_user.role in ['admin', 'stylist', 'cashier'] %}
            <a href="/web/inventory" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'inventory' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="box" class="w-5 h-5"></i>
                Inventory
            </a>
            {% endif %}
            
            {% if auth_user.role == 'admin' %}
            <a href="/web/employees" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'employees' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="user-check" class="w-5 h-5"></i>
                Employees
            </a>
            {% endif %}
            
            {# {% if auth_user.role in ['admin', 'receptionist', 'stylist', 'cashier'] %}
            <a href="/web/birthdays" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'birthdays' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="gift" class="w-5 h-5"></i>
                Birthdays & Offers
            </a>
            {% endif %} #}
            
            {% if auth_user.role in ['admin', 'cashier'] %}
            <div x-data="{ open: {% if active_menu == 'reports' %}true{% else %}false{% endif %} }">
                <button @click="open = !open" class="w-full flex items-center justify-between px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'reports' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %} focus:outline-none">
                    <div class="flex items-center gap-3">
                        <i data-lucide="bar-chart-2" class="w-5 h-5"></i>
                        Reports
                    </div>
                    <i data-lucide="chevron-down" class="w-4 h-4 transition-transform duration-200" :class="{'rotate-180': open}"></i>
                </button>
                
                <div x-show="open" x-collapse x-cloak class="pl-11 pr-3 py-2 space-y-1">
                    {% if auth_user.role == 'admin' %}
                    <a href="/web/reports" class="block py-1.5 text-sm transition-colors {% if title == 'Reports' %}text-indigo-700 font-semibold{% else %}text-slate-500 hover:text-indigo-600{% endif %}">Overview</a>
                    <a href="/web/reports/sales" class="block py-1.5 text-sm transition-colors {% if title == 'Sales Summary' %}text-indigo-700 font-semibold{% else %}text-slate-500 hover:text-indigo-600{% endif %}">Sales Summary</a>
                    <a href="/web/reports/stylists" class="block py-1.5 text-sm transition-colors {% if title == 'Stylist Performance' %}text-indigo-700 font-semibold{% else %}text-slate-500 hover:text-indigo-600{% endif %}">Stylist Performance</a>
                    <a href="/web/reports/payment-channels" class="block py-1.5 text-sm transition-colors {% if title == 'Payment Channel Report' %}text-indigo-700 font-semibold{% else %}text-slate-500 hover:text-indigo-600{% endif %}">Payment Channels</a>
                    <a href="/web/reports/shifts" class="block py-1.5 text-sm transition-colors {% if title == 'Register Shifts' %}text-indigo-700 font-semibold{% else %}text-slate-500 hover:text-indigo-600{% endif %}">Register Shifts</a>
                    {% endif %}
                    <a href="/web/pos/history" class="block py-1.5 text-sm transition-colors {% if title == 'POS Transaction History' %}text-indigo-700 font-semibold{% else %}text-slate-500 hover:text-indigo-600{% endif %}">POS Transaction History</a>
                    <a href="/web/reports/eod" class="block py-1.5 text-sm transition-colors {% if title == 'End of Day Report' %}text-indigo-700 font-semibold{% else %}text-slate-500 hover:text-indigo-600{% endif %}">End of Day Report</a>
                    {% if auth_user.role == 'admin' %}
                    <a href="/web/reports/inventory-issues" class="block py-1.5 text-sm transition-colors {% if title == 'Inventory Issues Report' %}text-indigo-700 font-semibold{% else %}text-slate-500 hover:text-indigo-600{% endif %}">Inventory Issues</a>
                    {% endif %}
                </div>
            </div>
            
            <a href="/web/expenses" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'expenses' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="receipt" class="w-5 h-5"></i>
                Expenses
            </a>
            {% endif %}
            
            {% if auth_user.role == 'admin' %}
            <a href="/web/settings" class="flex items-center gap-3 px-3 py-2 rounded-lg font-medium transition-colors {% if active_menu == 'settings' %}bg-indigo-50 text-indigo-700{% else %}text-slate-600 hover:bg-slate-50 hover:text-slate-900{% endif %}">
                <i data-lucide="settings" class="w-5 h-5"></i>
                Settings
            </a>
            {% endif %}
        </nav>
        
        <!-- User Profile (Moved to bottom of sidebar) -->
        <div class="p-4 border-t border-slate-200">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    {% if auth_user.profile_image %}
                        <img src="{{ auth_user.profile_image }}" alt="Profile" class="w-10 h-10 rounded-full object-cover shadow-sm ring-1 ring-slate-200">
                    {% else %}
                        <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold uppercase shadow-sm ring-1 ring-slate-200">
                            {{ auth_user.name|slice(0, 1)|default('U') }}
                        </div>
                    {% endif %}
                    <div>
                        <p class="text-sm font-medium text-slate-900 truncate w-24">{{ auth_user.name|default('User') }}</p>
                        <p class="text-[10px] uppercase font-bold text-slate-500 tracking-wider">{{ auth_user.role|default('Stylist') }}</p>
                    </div>
                </div>
                <div class="flex gap-1" x-data="{ profileMenu: false }">
                    <button @click="profileMenu = !profileMenu" @click.away="profileMenu = false" class="text-slate-400 hover:text-indigo-600 transition-colors p-2 relative">
                        <i data-lucide="more-vertical" class="w-5 h-5"></i>
                        <div x-show="profileMenu" x-transition.opacity class="absolute bottom-full right-0 mb-2 w-32 bg-white rounded-lg shadow-xl border border-slate-100 py-1 z-[60]" style="display: none;">
                            <a href="/web/profile" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 text-left">Profile</a>
                            <a href="/web/logout" class="block px-4 py-2 text-sm text-rose-600 hover:bg-slate-50 text-left">Sign out</a>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <main class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden bg-slate-50">
        <!-- Topbar -->
        <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 md:px-6 z-10 shrink-0">
            <div class="flex items-center gap-4">
                {% if not hide_sidebar %}
                <button @click="sidebarOpen = true" class="md:hidden text-slate-500 hover:text-slate-700 focus:outline-none">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
                {% else %}
                <a href="/web/dashboard" class="text-slate-500 hover:text-slate-700 flex items-center gap-2">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                    Back
                </a>
                {% endif %}
                <h2 class="text-xl font-semibold text-slate-800 hidden sm:block">{{ title ?? 'Overview' }}</h2>
            </div>
            
            <div class="flex items-center gap-4">
                {% block header_actions %}{% endblock %}
                <!-- Notifications -->
                <div class="relative" x-data="{ open: false }" hx-get="/web/notifications/dropdown" hx-trigger="load" hx-swap="innerHTML" id="notifications-wrapper">
                    <button class="relative text-slate-500 hover:text-slate-700 transition-colors">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Dynamic Content Area -->
        <div class="flex-1 overflow-auto p-4 md:p-6">
            {% block content %}{% endblock %}
        </div>
    </main>

    <!-- Global Modal Container -->
    <div id="modal-container" x-data @close-modal.window="setTimeout(() => $el.innerHTML = '', 100)"></div>

    <!-- Global Toast Notification -->
    <div x-data="{ show: false, message: '', type: 'success' }" 
         @show-toast.window="
            let val = $event.detail.value || $event.detail;
            message = (typeof val === 'object' && val.message) ? val.message : val;
            type = (typeof val === 'object' && val.type) ? val.type : 'success';
            show = true; 
            setTimeout(() => show = false, 3000);
         "
         @open-receipt.window="
            window.open($event.detail.url, 'receipt', 'width=350,height=600');
            if ($event.detail.redirect) {
                setTimeout(() => window.location.href = $event.detail.redirect, 500);
            }
         "
         class="fixed bottom-6 right-6 z-[60]">
        <div x-show="show" 
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 transform translate-y-4"
             x-transition:enter-end="opacity-100 transform translate-y-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 transform translate-y-0"
             x-transition:leave-end="opacity-0 transform translate-y-4"
             :class="{
                 'bg-emerald-600': type === 'success',
                 'bg-rose-600': type === 'error',
                 'bg-blue-600': type === 'info'
             }"
             class="text-white px-6 py-3 rounded-lg shadow-xl font-medium flex items-center gap-3"
             style="display: none;">
            <i data-lucide="check-circle" x-show="type === 'success'" class="w-5 h-5"></i>
            <i data-lucide="x-circle" x-show="type === 'error'" class="w-5 h-5"></i>
            <i data-lucide="info" x-show="type === 'info'" class="w-5 h-5"></i>
            <span x-text="message"></span>
        </div>
    </div>

    <!-- Initialize Lucide Icons -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
        document.body.addEventListener('htmx:afterSwap', function(evt) {
            lucide.createIcons();
        });
    </script>
    
    {% block scripts %}{% endblock %}
</body>
</html>
