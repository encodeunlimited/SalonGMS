<button @click="open = !open" @click.away="open = false" class="relative text-slate-400 hover:text-slate-600 transition-colors">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
    {% if unread_count > 0 %}
        <span class="absolute top-0 right-0 block h-2.5 w-2.5 rounded-full bg-red-500 ring-2 ring-white"></span>
    {% endif %}
</button>

<div x-show="open" x-transition.opacity class="absolute right-0 mt-2 w-80 bg-white rounded-md shadow-lg border border-slate-100 py-1 z-50" style="display: none;">
    <div class="px-4 py-3 border-b border-slate-100 flex justify-between items-center bg-slate-50 rounded-t-md">
        <h3 class="text-sm font-semibold text-slate-800">Notifications</h3>
        {% if unread_count > 0 %}
            <span class="bg-red-100 text-red-600 py-0.5 px-2 rounded-full text-xs font-medium">{{ unread_count }} new</span>
            <button class="text-xs text-indigo-600 hover:underline" hx-post="/web/notifications/read-all" hx-target="#notifications-wrapper">Mark all read</button>
        {% endif %}
    </div>
    
    <div class="max-h-64 overflow-y-auto">
        {% if notifications|length > 0 %}
            {% for note in notifications %}
                <div class="px-4 py-3 border-b border-gray-50 hover:bg-slate-50 transition-colors {% if not note.is_read %}bg-blue-50{% endif %}">
                    <div class="flex justify-between items-start mb-1">
                        <p class="text-sm font-medium text-slate-800">{{ note.title }}</p>
                        <span class="text-xs text-slate-400">{{ note.created_at|date('M d, H:i') }}</span>
                    </div>
                    <p class="text-sm text-slate-600">{{ note.message }}</p>
                    {% if not note.is_read %}
                        <button class="mt-2 text-xs text-indigo-600 hover:underline" hx-post="/web/notifications/{{ note.id }}/read" hx-target="#notifications-wrapper" hx-swap="outerHTML" @click="setTimeout(() => htmx.ajax('GET', '/web/notifications/dropdown', '#notifications-wrapper'), 100)">Mark read</button>
                    {% endif %}
                </div>
            {% endfor %}
        {% else %}
            <div class="px-4 py-6 text-center text-sm text-slate-500">
                <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                <p class="mt-2">No notifications yet.</p>
            </div>
        {% endif %}
    </div>
</div>
