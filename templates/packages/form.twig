{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <a href="/web/packages" class="text-sm font-medium text-gray-500 hover:text-salon-accent mb-2 inline-flex items-center transition-colors">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            Back to Packages
        </a>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">{{ package ? 'Edit Package' : 'Create Package' }}</h2>
    </div>
</div>

<div class="max-w-3xl">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 md:p-8">
        <form action="{{ package ? '/web/packages/' ~ package.id ~ '/edit' : '/web/packages/create' }}" method="POST">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div class="md:col-span-2">
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Package Name <span class="text-red-500">*</span></label>
                    <input type="text" id="name" name="name" value="{{ package.name|default('') }}" required
                        class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-salon-accent focus:outline-none focus:ring-1 focus:ring-salon-accent transition-colors">
                </div>

                <div class="md:col-span-2">
                    <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea id="description" name="description" rows="3"
                        class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-salon-accent focus:outline-none focus:ring-1 focus:ring-salon-accent transition-colors resize-none">{{ package.description|default('') }}</textarea>
                </div>

                <div>
                    <label for="price" class="block text-sm font-medium text-gray-700 mb-1">Package Price (QAR) <span class="text-red-500">*</span></label>
                    <input type="number" step="0.01" id="price" name="price" value="{{ package.price|default('0.00') }}" required
                        class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-salon-accent focus:outline-none focus:ring-1 focus:ring-salon-accent transition-colors">
                </div>
                
                <div class="flex items-center mt-6">
                    <label class="flex items-center space-x-3 cursor-pointer">
                        <input type="checkbox" name="active" value="1" {% if not package or package.active %}checked{% endif %}
                               class="w-5 h-5 text-salon-accent rounded border-gray-300 focus:ring-salon-accent transition-colors">
                        <span class="text-sm font-medium text-gray-700">Package is Active</span>
                    </label>
                </div>
            </div>

            <div class="mb-8">
                <label for="service_ids" class="block text-sm font-medium text-gray-700 mb-2">Included Services <span class="text-red-500">*</span></label>
                <select id="service_ids" name="service_ids[]" multiple placeholder="Select services to include..." autocomplete="off">
                    {% for service in services %}
                        <option value="{{ service.id }}" {% if package and service.id in package.service_ids %}selected{% endif %}>
                            {{ service.name }} (QAR {{ service.price|number_format(2) }})
                        </option>
                    {% endfor %}
                </select>
                <p class="text-xs text-gray-500 mt-2">These services will be included when a customer books this package.</p>
            </div>

            <div class="flex justify-end space-x-3 border-t border-gray-100 pt-6">
                <a href="/web/packages" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-salon-accent transition-colors">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-salon-dark hover:bg-salon-navy focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-salon-accent transition-colors">
                    {{ package ? 'Update Package' : 'Create Package' }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (document.getElementById('service_ids')) {
            new TomSelect('#service_ids', {
                plugins: ['remove_button'],
                maxOptions: null,
                searchField: 'text',
                render: {
                    item: function(data, escape) {
                        return '<div>' + escape(data.text) + '</div>';
                    }
                }
            });
        }
    });
</script>
{% endblock %}
