{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Packages</h2>
        <p class="text-sm text-slate-500 mt-1">Manage bundled services and special offers.</p>
    </div>
    <div class="flex items-center space-x-3">
        {% if auth_user.role != 'cashier' %}
        <a href="/web/packages/create" class="bg-indigo-600 text-white rounded-md px-4 py-2 text-sm font-medium hover:bg-indigo-700 transition-colors inline-flex items-center shadow-sm">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Create Package
        </a>
        {% endif %}
    </div>
</div>

<div id="table-container">
<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <!-- Search bar -->
    <div class="p-4 border-b border-slate-100 bg-slate-50 flex gap-4">
        <div class="relative flex-1 max-w-sm">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"></path></svg>
            </div>
            <input type="search" id="search-box" name="search" value="{{ search }}" placeholder="Search packages..."
                   hx-get="/web/packages?sort={{ sort }}&dir={{ dir }}"
                   hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true"
                   hx-trigger="keyup changed delay:500ms, search"
                   class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors">
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider cursor-pointer hover:bg-gray-200 transition-colors"
                        hx-get="/web/packages?sort=name&dir={{ sort == 'name' and dir == 'asc' ? 'desc' : 'asc' }}"
                        hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                        Package Name {% if sort == 'name' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                    </th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Included Services</th>
                    <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider cursor-pointer hover:bg-gray-200 transition-colors"
                        hx-get="/web/packages?sort=price&dir={{ sort == 'price' and dir == 'asc' ? 'desc' : 'asc' }}"
                        hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                        Price (QAR) {% if sort == 'price' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                    </th>
                    <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider cursor-pointer hover:bg-gray-200 transition-colors"
                        hx-get="/web/packages?sort=active&dir={{ sort == 'active' and dir == 'asc' ? 'desc' : 'asc' }}"
                        hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                        Status {% if sort == 'active' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                    </th>
                    <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for package in packages %}
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="text-sm font-bold text-slate-900">{{ package.name }}</div>
                        <div class="text-sm text-slate-500 mt-1 line-clamp-1">{{ package.description|default('No description') }}</div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1">
                            {% for service in package.services %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-800">
                                    {{ service.name }}
                                </span>
                            {% else %}
                                <span class="text-xs text-slate-400">None</span>
                            {% endfor %}
                        </div>
                    </td>
                    <td class="px-6 py-4 text-sm font-semibold text-indigo-600 text-right">
                        {{ package.price|number_format(2) }}
                    </td>
                    <td class="px-6 py-4 text-center">
                        {% if package.active %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">Active</span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800 border border-slate-200">Inactive</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <div class="flex items-center justify-end space-x-3">
                            {% if auth_user.role != 'cashier' %}
                            <a href="/web/packages/{{ package.id }}/edit" class="text-blue-600 hover:text-blue-900 transition-colors" title="Edit">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            </a>
                            <form action="/web/packages/{{ package.id }}" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this package?');">
                                <input type="hidden" name="_METHOD" value="DELETE">
                                <button type="submit" class="text-red-500 hover:text-red-700 transition-colors" title="Delete">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
                        <p class="text-sm font-medium text-slate-500">No packages found.</p>
                        {% if search %}
                            <p class="text-xs text-slate-400 mt-1">Try a different search term.</p>
                        {% else %}
                            <p class="text-xs text-slate-400 mt-1">Click "Create Package" to get started.</p>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="px-6 pb-4">
        {% include "partials/pagination.twig" with {'hx_url': '/web/packages'} %}
    </div>
</div>
</div>
{% endblock %}
