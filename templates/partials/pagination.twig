{% if pagination.total_pages > 1 %}
    <div class="mt-6 flex items-center justify-between border-t border-salon-border pt-4">
        <div class="flex flex-1 justify-between sm:hidden">
            {% if pagination.page > 1 %}
                <button type="button" hx-get="{{ hx_url }}?page={{ pagination.page - 1 }}&search={{ search|default('') }}&sort={{ sort|default('') }}&dir={{ dir|default('') }}{{ extra_query_params|default('') }}" hx-target="{{ hx_target|default('#table-container') }}" hx-select="{{ hx_select|default('#table-container') }}" hx-swap="outerHTML" hx-push-url="true" class="relative inline-flex items-center rounded-md border border-salon-border bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Previous</button>
            {% else %}
                <button disabled class="relative inline-flex items-center rounded-md border border-salon-border bg-gray-50 px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed">Previous</button>
            {% endif %}
            
            {% if pagination.page < pagination.total_pages %}
                <button type="button" hx-get="{{ hx_url }}?page={{ pagination.page + 1 }}&search={{ search|default('') }}&sort={{ sort|default('') }}&dir={{ dir|default('') }}{{ extra_query_params|default('') }}" hx-target="{{ hx_target|default('#table-container') }}" hx-select="{{ hx_select|default('#table-container') }}" hx-swap="outerHTML" hx-push-url="true" class="relative ml-3 inline-flex items-center rounded-md border border-salon-border bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Next</button>
            {% else %}
                <button disabled class="relative ml-3 inline-flex items-center rounded-md border border-salon-border bg-gray-50 px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed">Next</button>
            {% endif %}
        </div>
        
        <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
            <div>
                <p class="text-sm text-gray-700">
                    Showing
                    <span class="font-medium">{{ ((pagination.page - 1) * pagination.limit) + 1 }}</span>
                    to
                    <span class="font-medium">{{ min(pagination.page * pagination.limit, pagination.total) }}</span>
                    of
                    <span class="font-medium">{{ pagination.total }}</span>
                    results
                </p>
            </div>
            <div>
                <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                    {% if pagination.page > 1 %}
                        <button type="button" hx-get="{{ hx_url }}?page={{ pagination.page - 1 }}&search={{ search|default('') }}&sort={{ sort|default('') }}&dir={{ dir|default('') }}{{ extra_query_params|default('') }}" hx-target="{{ hx_target|default('#table-container') }}" hx-select="{{ hx_select|default('#table-container') }}" hx-swap="outerHTML" hx-push-url="true" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-salon-border hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                            <span class="sr-only">Previous</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                        </button>
                    {% else %}
                        <span class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-300 ring-1 ring-inset ring-salon-border bg-gray-50 cursor-not-allowed">
                            <span class="sr-only">Previous</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                        </span>
                    {% endif %}

                    {% for i in max(1, pagination.page - 2)..min(pagination.total_pages, pagination.page + 2) %}
                        {% if i == pagination.page %}
                            <span aria-current="page" class="relative z-10 inline-flex items-center bg-salon-accent px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-salon-accent">{{ i }}</span>
                        {% else %}
                            <button type="button" hx-get="{{ hx_url }}?page={{ i }}&search={{ search|default('') }}&sort={{ sort|default('') }}&dir={{ dir|default('') }}{{ extra_query_params|default('') }}" hx-target="{{ hx_target|default('#table-container') }}" hx-select="{{ hx_select|default('#table-container') }}" hx-swap="outerHTML" hx-push-url="true" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-salon-border hover:bg-gray-50 focus:z-20 focus:outline-offset-0">{{ i }}</button>
                        {% endif %}
                    {% endfor %}

                    {% if pagination.page < pagination.total_pages %}
                        <button type="button" hx-get="{{ hx_url }}?page={{ pagination.page + 1 }}&search={{ search|default('') }}&sort={{ sort|default('') }}&dir={{ dir|default('') }}{{ extra_query_params|default('') }}" hx-target="{{ hx_target|default('#table-container') }}" hx-select="{{ hx_select|default('#table-container') }}" hx-swap="outerHTML" hx-push-url="true" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-salon-border hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                            <span class="sr-only">Next</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                        </button>
                    {% else %}
                        <span class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-300 ring-1 ring-inset ring-salon-border bg-gray-50 cursor-not-allowed">
                            <span class="sr-only">Next</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                        </span>
                    {% endif %}
                </nav>
            </div>
        </div>
    </div>
{% endif %}
