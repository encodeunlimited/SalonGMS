{% extends 'portal/layout.twig' %}

{% block content %}
<div class="animate-fade-in" style="max-width: 450px; margin: 2rem auto;">
    <div class="card glass">
        <h2 class="text-center" style="font-size: 2rem; margin-bottom: 0.5rem;">Welcome Back</h2>
        <p class="text-center text-muted mb-8">Sign in to manage your appointments</p>

        <form hx-post="/portal/login" hx-target="#login-error" hx-swap="outerHTML">
            <div id="login-error"></div>
            
            <div class="form-group">
                <label class="form-label" for="phone">WhatsApp Number</label>
                <input type="text" id="phone" name="phone" class="form-input" placeholder="e.g. 12345678" required autofocus>
            </div>
            
            <button type="submit" class="btn-primary mt-4">Sign In</button>
        </form>
        
        <script>
            document.querySelector('form').addEventListener('input', function() {
                const err = document.getElementById('login-error');
                if (err && err.innerHTML.trim() !== '') {
                    err.innerHTML = '';
                    err.style = '';
                }
            });
        </script>
    </div>
</div>
{% endblock %}
