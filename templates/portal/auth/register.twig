{% extends 'portal/layout.twig' %}

{% block content %}
<div class="animate-fade-in" style="max-width: 450px; margin: 2rem auto;">
    <div class="card glass">
        <h2 class="text-center" style="font-size: 2rem; margin-bottom: 0.5rem;">Create Account</h2>
        <p class="text-center text-muted mb-8">Join us and start booking</p>

        <form hx-post="/portal/register" hx-target="#register-error" hx-swap="outerHTML" enctype="multipart/form-data" hx-encoding="multipart/form-data">
            <div id="register-error"></div>
            
            <div class="form-group" style="text-align: center; margin-bottom: 1.5rem;">
                <label class="form-label" style="margin-bottom: 0.5rem;" for="profile_image">Profile Picture (Optional)</label>
                <div style="width: 96px; height: 96px; margin: 0 auto; background-color: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid var(--border-color); cursor: pointer;" onclick="document.getElementById('profile_image').click()" id="profile_preview_container">
                    <svg style="width: 32px; height: 32px; color: var(--text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
                <input type="file" id="profile_image" name="profile_image" style="display: none;" accept="image/*" onchange="previewImage(this)">
                <div class="text-muted" style="font-size: 0.75rem; margin-top: 0.5rem;">Click to upload</div>
            </div>
            
            <script>
            function previewImage(input) {
                if (input.files && input.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        document.getElementById('profile_preview_container').innerHTML = '<img src="'+e.target.result+'" style="width: 100%; height: 100%; object-fit: cover;">';
                    }
                    reader.readAsDataURL(input.files[0]);
                }
            }
            </script>

            <div class="form-group">
                <label class="form-label" for="name">Full Name</label>
                <input type="text" id="name" name="name" class="form-input" required autofocus>
            </div>

            <div class="form-group">
                <label class="form-label" for="phone">Phone Number (Optional)</label>
                <input type="text" id="phone" name="phone" class="form-input">
            </div>

            <div class="form-group">
                <label class="form-label" for="date_of_birth">Date of Birth</label>
                <input type="date" id="date_of_birth" name="date_of_birth" class="form-input" required>
            </div>
            
            <div class="form-group">
                <label class="form-label" for="email">Email Address</label>
                <input type="email" id="email" name="email" class="form-input" required>
            </div>
            
            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <input type="password" id="password" name="password" class="form-input" required>
            </div>

            <div class="form-group">
                <label class="form-label" for="password_confirm">Confirm Password</label>
                <input type="password" id="password_confirm" name="password_confirm" class="form-input" required>
            </div>
            
            <button type="submit" class="btn-primary mt-4">Sign Up</button>
        </form>
        
        <script>
            document.querySelector('form').addEventListener('input', function() {
                const err = document.getElementById('register-error');
                if (err && err.innerHTML.trim() !== '') {
                    err.innerHTML = '';
                    err.style = '';
                }
            });
        </script>
        
        <p class="text-center mt-4 text-sm text-muted">
            Already have an account? <a href="/portal/login">Sign In</a>
        </p>
    </div>
</div>
{% endblock %}
