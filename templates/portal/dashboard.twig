{% extends 'portal/layout.twig' %}

{% block content %}
<div class="animate-fade-in">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1 style="font-size: 2.5rem; font-weight: 700;">Welcome, {{ customer.name }}</h1>
        <a href="/portal/book" class="btn-primary" style="width: auto;">Book New Appointment</a>
    </div>

    <div class="grid grid-cols-2 gap-4">
        <!-- Upcoming Appointments -->
        <div>
            <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Upcoming Appointments</h2>
            {% if upcoming_appointments|length > 0 %}
                {% for app in upcoming_appointments %}
                    <div class="card glass mb-4" style="padding: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                            <span style="font-weight: 600; font-size: 1.1rem;">
                                {{ app.start_time|date("l, F j, Y") }}
                            </span>
                            {% if app.status == 'scheduled' or app.status == 'pending' %}
                                <span style="background-color: #dbeafe; color: #1e40af; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">{{ app.status }}</span>
                            {% elseif app.status == 'approved' %}
                                <span style="background-color: #dbeafe; color: #2563eb; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">{{ app.status }}</span>
                            {% elseif app.status == 'done' %}
                                <span style="background-color: #d1fae5; color: #10b981; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">{{ app.status }}</span>
                            {% elseif app.status == 'paid' or app.status == 'completed' %}
                                <span style="background-color: #d1fae5; color: #065f46; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Paid</span>
                            {% elseif app.status == 'cancelled' %}
                                <span style="background-color: #fee2e2; color: #991b1b; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">Cancelled</span>
                            {% else %}
                                <span style="background-color: #e5e7eb; color: #374151; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">{{ app.status }}</span>
                            {% endif %}
                        </div>
                        <div class="text-muted">
                            <div style="margin-bottom: 0.5rem;">
                                🕒 {{ app.start_time|date("g:i A") }} - {{ app.end_time|date("g:i A") }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="card glass text-center text-muted" style="padding: 2rem;">
                    No upcoming appointments found.
                </div>
            {% endif %}
        </div>

        <!-- Past Appointments -->
        <div>
            <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Past Appointments</h2>
            {% if past_appointments|length > 0 %}
                {% for app in past_appointments %}
                    <div class="card glass mb-4" style="padding: 1.5rem; opacity: 0.8;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="font-weight: 500;">
                                {{ app.start_time|date("M j, Y") }}
                            </span>
                            {% if app.status == 'paid' or app.status == 'completed' %}
                                <span style="color: #065f46; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Paid</span>
                            {% elseif app.status == 'done' %}
                                <span style="color: #10b981; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Done</span>
                            {% elseif app.status == 'cancelled' %}
                                <span style="color: #991b1b; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Cancelled</span>
                            {% else %}
                                <span class="text-muted" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">{{ app.status }}</span>
                            {% endif %}
                        </div>
                        <div class="text-muted" style="font-size: 0.875rem;">
                            {{ app.start_time|date("g:i A") }}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="card glass text-center text-muted" style="padding: 2rem;">
                    No past appointments.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
