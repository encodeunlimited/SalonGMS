{% extends 'portal/layout.twig' %}

{% block content %}
<div class="animate-fade-in">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem;">Welcome, {{ customer.name }}</h1>
            <div style="display: inline-flex; align-items: center; background-color: var(--primary-container); color: var(--on-primary-container); padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 600;">
                <span class="material-symbols-outlined" style="margin-right: 0.5rem; font-size: 1.25rem;">stars</span>
                {{ customer.loyalty_points|default(0) }} Loyalty Points
            </div>
            <div style="margin-top: 1rem;">
                <a href="/portal/profile" style="color: var(--primary); font-weight: 500; font-size: 0.875rem; display: inline-flex; align-items: center; text-decoration: none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
                    <svg style="width: 1rem; height: 1rem; margin-right: 0.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                    Edit Profile
                </a>
            </div>
        </div>
        <a href="/portal/book" class="btn-primary" style="width: auto;">Book New Appointment</a>
    </div>

    {% if is_birthday %}
    <div style="background: linear-gradient(135deg, #fce7f3 0%, #fbcfe8 100%); border: 1px solid #f9a8d4; border-radius: 1rem; padding: 2rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <div>
            <h2 style="font-size: 1.75rem; font-weight: 800; color: #831843; margin-bottom: 0.5rem;">🎉 Happy Birthday, {{ customer.name }}! 🎂</h2>
            <p style="color: #9d174d; font-size: 1rem; margin-bottom: 0;">We hope you have a fantastic day! Treat yourself to one of our special beauty packages.</p>
        </div>
        <a href="/portal/book" class="btn-primary" style="background-color: #db2777; width: auto; font-weight: bold; padding: 0.75rem 1.5rem;">View Birthday Offers</a>
    </div>
    {% endif %}

    <div x-data="{ activeTab: 'upcoming' }" style="margin-bottom: 2rem;">
        <div style="display: flex; gap: 1rem; border-bottom: 1px solid var(--border-color); margin-bottom: 1.5rem;">
            <button @click="activeTab = 'upcoming'" 
                    :style="activeTab === 'upcoming' ? 'border-bottom-color: var(--primary); color: var(--primary);' : 'border-bottom-color: transparent; color: var(--text-muted);'"
                    style="background: transparent; border-top: none; border-left: none; border-right: none; border-bottom: 2px solid transparent; padding: 0.75rem 1rem; font-size: 1.1rem; font-weight: 600; cursor: pointer; outline: none; transition: all 0.2s; margin-bottom: -1px;"
                    onmouseover="if(activeTab !== 'upcoming') this.style.color='var(--text-main)'"
                    onmouseout="if(activeTab !== 'upcoming') this.style.color='var(--text-muted)'">
                Upcoming Appointments
            </button>
            <button @click="activeTab = 'past'" 
                    :style="activeTab === 'past' ? 'border-bottom-color: var(--primary); color: var(--primary);' : 'border-bottom-color: transparent; color: var(--text-muted);'"
                    style="background: transparent; border-top: none; border-left: none; border-right: none; border-bottom: 2px solid transparent; padding: 0.75rem 1rem; font-size: 1.1rem; font-weight: 600; cursor: pointer; outline: none; transition: all 0.2s; margin-bottom: -1px;"
                    onmouseover="if(activeTab !== 'past') this.style.color='var(--text-main)'"
                    onmouseout="if(activeTab !== 'past') this.style.color='var(--text-muted)'">
                Past Appointments
            </button>
        </div>

        <!-- Upcoming Appointments -->
        <div x-show="activeTab === 'upcoming'">
            {% if upcoming_appointments|length > 0 %}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for app in upcoming_appointments %}
                    <div class="card glass mb-4" style="padding: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem;">
                            <span style="font-weight: 700; font-size: 1.2rem; color: var(--text-main);">
                                {{ app.service }}
                            </span>
                            {% if app.status == 'scheduled' or app.status == 'pending' %}
                                <span style="background-color: #dbeafe; color: #1e40af; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; white-space: nowrap;">{{ app.status }}</span>
                            {% elseif app.status == 'approved' %}
                                <span style="background-color: #dbeafe; color: #2563eb; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; white-space: nowrap;">{{ app.status }}</span>
                            {% elseif app.status == 'done' %}
                                <span style="background-color: #d1fae5; color: #10b981; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; white-space: nowrap;">{{ app.status }}</span>
                            {% elseif app.status == 'paid' or app.status == 'completed' %}
                                <span style="background-color: #d1fae5; color: #065f46; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; white-space: nowrap;">Paid</span>
                            {% elseif app.status == 'cancelled' %}
                                <span style="background-color: #fee2e2; color: #991b1b; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; white-space: nowrap;">Cancelled</span>
                            {% else %}
                                <span style="background-color: #e5e7eb; color: #374151; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; white-space: nowrap;">{{ app.status }}</span>
                            {% endif %}
                        </div>
                        <div style="margin-bottom: 0.75rem; color: var(--text-muted); font-size: 0.95rem;">
                            With <span style="font-weight: 500; color: var(--text-main);">{{ app.stylist }}</span>
                        </div>
                        <div class="text-muted" style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
                            🕒 {{ app.start_time|date("l, M j, Y") }} | {{ app.start_time|date("g:i A") }} - {{ app.end_time|date("g:i A") }}
                        </div>
                    </div>
                {% endfor %}
                </div>
            {% else %}
                <div class="card glass text-center text-muted" style="padding: 2rem;">
                    No upcoming appointments found.
                </div>
            {% endif %}
        </div>

        <!-- Past Appointments -->
        <div x-show="activeTab === 'past'" style="display: none;">
            {% if past_appointments|length > 0 %}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for app in past_appointments %}
                    <div class="card glass mb-4" style="padding: 1.5rem; opacity: 0.8;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.25rem;">
                            <span style="font-weight: 600; color: var(--text-main);">
                                {{ app.service }}
                            </span>
                            {% if app.status == 'paid' or app.status == 'completed' %}
                                <span style="color: #065f46; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; white-space: nowrap;">Paid</span>
                            {% elseif app.status == 'done' %}
                                <span style="color: #10b981; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; white-space: nowrap;">Done</span>
                            {% elseif app.status == 'cancelled' %}
                                <span style="color: #991b1b; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; white-space: nowrap;">Cancelled</span>
                            {% else %}
                                <span class="text-muted" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; white-space: nowrap;">{{ app.status }}</span>
                            {% endif %}
                        </div>
                        <div class="text-muted" style="font-size: 0.85rem; margin-bottom: 0.5rem;">
                            With {{ app.stylist }}
                        </div>
                        <div class="text-muted" style="font-size: 0.85rem;">
                            {{ app.start_time|date("M j, Y") }} at {{ app.start_time|date("g:i A") }}
                        </div>
                    </div>
                {% endfor %}
                </div>
            {% else %}
                <div class="card glass text-center text-muted" style="padding: 2rem;">
                    No past appointments.
                </div>
            {% endif %}
        </div>
    </div>
    
    {% if my_packages|length > 0 %}
    <div style="margin-top: 2rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">My Packages</h2>
        <div class="grid grid-cols-2 gap-4">
            {% for package in my_packages %}
                <div class="card glass" style="padding: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0; color: var(--primary);">{{ package.package_name }}</h3>
                        {% if package.expires_at %}
                            <span style="font-size: 0.75rem; color: var(--text-muted); background: var(--bg-elevated); padding: 0.25rem 0.5rem; border-radius: 9999px;">
                                Expires: {{ package.expires_at|date("M j, Y") }}
                            </span>
                        {% endif %}
                    </div>
                    
                    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                        {% for service in package.services %}
                            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-color); padding-bottom: 0.5rem;">
                                <div style="display: flex; flex-direction: column;">
                                    <span style="font-weight: 500; font-size: 0.95rem; color: var(--text-main);">{{ service.service_name }}</span>
                                    <span style="font-size: 0.8rem; color: var(--text-muted);">{{ service.remaining }} / {{ service.total }} left</span>
                                </div>
                                <a href="/portal/book?service_id=cps_{{ service.cps_id }}" class="btn-primary" style="padding: 0.25rem 0.75rem; font-size: 0.75rem; width: auto; border-radius: 9999px; text-decoration: none;">Book</a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
