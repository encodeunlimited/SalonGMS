{% extends 'portal/layout.twig' %}

{% block content %}
<!-- Hero Section -->
<div class="hero-section animate-fade-in" style="
    position: relative; 
    border-radius: var(--radius-lg); 
    overflow: hidden; 
    margin-bottom: 4rem; 
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
">
    <div style="
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image: url('/images/hero.png');
        background-size: cover;
        background-position: center;
        z-index: 1;
    "></div>
    <!-- Overlay for better text readability -->
    <div style="
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(to bottom, rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.9));
        z-index: 2;
    "></div>

    <div class="hero-content" style="
        position: relative; 
        z-index: 3; 
        text-align: center; 
        padding: 2rem;
        max-width: 800px;
    ">
        <h1 style="font-size: 3.5rem; font-weight: 700; margin-bottom: 1.5rem; letter-spacing: -1px; text-shadow: 0 4px 10px rgba(0,0,0,0.5);">
            Experience <span style="color: var(--primary);">Premium</span> Beauty
        </h1>
        <p style="font-size: 1.25rem; color: #cbd5e1; margin: 0 auto 3rem; text-shadow: 0 2px 5px rgba(0,0,0,0.5);">
            Discover the ultimate salon experience. Professional stylists, luxurious treatments, and effortless booking.
        </p>
        
        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href="/portal/book" class="btn-primary" style="width: auto; padding: 1.25rem 3rem; font-size: 1.1rem; border-radius: var(--radius-full);">
                Book Appointment
            </a>
        </div>
    </div>
</div>

<!-- Services Section -->
<div class="animate-fade-in" style="animation-delay: 0.1s; margin-bottom: 4rem;">
    <h2 class="text-center" style="font-size: 2.5rem; font-weight: 700; margin-bottom: 2rem;">Our Services</h2>
    <div class="grid grid-cols-2 gap-4">
        {% if services and services|length > 0 %}
            {% for service in services %}
            <div class="card glass" style="padding: 0; border-color: var(--border-color); display: flex; flex-direction: column; overflow: hidden;">
                <!-- Image Slider -->
                {% if service.images and service.images|length > 0 %}
                    <div x-data="{ activeSlide: 0, slides: {{ service.images|length }} }" 
                         x-init="if(slides > 1) { setInterval(() => activeSlide = activeSlide === slides - 1 ? 0 : activeSlide + 1, 3500) }"
                         class="w-full overflow-hidden" style="height: 200px; position: relative; background-color: var(--bg-elevated); flex-shrink: 0;">
                        
                        {% for img in service.images %}
                            <div x-show="activeSlide === {{ loop.index0 }}"
                                 x-transition:enter="transition ease-in-out duration-500"
                                 x-transition:enter-start="opacity-0"
                                 x-transition:enter-end="opacity-100"
                                 x-transition:leave="transition ease-in-out duration-500"
                                 x-transition:leave-start="opacity-100"
                                 x-transition:leave-end="opacity-0"
                                 style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
                                <img src="{{ img }}" style="width: 100%; height: 100%; object-fit: cover;" alt="{{ service.name }}">
                            </div>
                        {% endfor %}
                        
                        {% if service.images|length > 1 %}
                        <!-- Navigation Dots -->
                        <div class="absolute bottom-3 left-0 right-0 flex justify-center space-x-2 z-10">
                            {% for img in service.images %}
                                <button @click="activeSlide = {{ loop.index0 }}" 
                                        class="w-2 h-2 rounded-full transition-colors"
                                        :class="activeSlide === {{ loop.index0 }} ? 'bg-salon-accent' : 'bg-white/50 hover:bg-white'"></button>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                {% else %}
                    <!-- Placeholder if no image -->
                    <div style="width: 100%; height: 200px; background-color: var(--bg-elevated); display: flex; align-items: center; justify-content: center; color: var(--text-muted);">
                        No Image Available
                    </div>
                {% endif %}
                
                <!-- Content -->
                <div style="padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1;">
                    <div style="flex-grow: 1;">
                        <h3 style="font-weight: 600; font-size: 1.25rem; margin-bottom: 0.5rem; color: var(--primary);">{{ service.name }}</h3>
                        <p class="text-muted" style="font-size: 0.95rem; margin-bottom: 1rem;">{{ service.description }}</p>
                    </div>
                    
                    <div style="margin-top: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                            <span style="font-size: 1.5rem; font-weight: 700; color: white;">${{ service.price }}</span>
                            <span class="text-muted" style="font-size: 0.875rem;">⏱ {{ service.duration_minutes }} mins</span>
                        </div>
                        <a href="/portal/book?service_id={{ service.id }}" class="btn-primary" style="display: block; text-align: center; width: 100%;">Book Now</a>
                    </div>
                </div>
            </div>
            {% endfor %}
        {% else %}
            <div class="card glass text-center text-muted" style="grid-column: span 2; padding: 2rem;">
                Check back soon for our updated service list!
            </div>
        {% endif %}
    </div>
</div>

<!-- Features Section -->
<div class="grid grid-cols-2 gap-4 animate-fade-in" style="animation-delay: 0.2s; margin-bottom: 4rem;">
    <!-- Feature 1 -->
    <div class="card glass" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
        <div style="height: 250px; background-image: url('/images/stylist.png'); background-size: cover; background-position: center;"></div>
        <div style="padding: 2rem; text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 1rem;">✨</div>
            <h3 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">Expert Stylists</h3>
            <p class="text-muted">Our team of award-winning professionals is here to give you the perfect look tailored just for you.</p>
        </div>
    </div>
    
    <!-- Feature 2 -->
    <div class="card glass" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
        <div style="height: 250px; background-image: url('/images/products.png'); background-size: cover; background-position: center;"></div>
        <div style="padding: 2rem; text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 1rem;">💎</div>
            <h3 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">Premium Products</h3>
            <p class="text-muted">We use only the finest, high-end hair care products to ensure your hair stays healthy and vibrant.</p>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="card glass animate-fade-in text-center" style="animation-delay: 0.4s; padding: 4rem 2rem; margin-bottom: 2rem; border-color: var(--primary);">
    <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">Ready for a change?</h2>
    <p class="text-muted mb-8" style="font-size: 1.1rem;">Join our community of satisfied clients and elevate your style.</p>
    <a href="/portal/register" class="btn-primary" style="width: auto; padding: 1rem 2.5rem; font-size: 1.1rem; border-radius: var(--radius-full);">
        Create an Account Today
    </a>
</div>

{% endblock %}
