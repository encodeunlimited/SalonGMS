<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SalonMS{% endblock %}</title>
    
    <!-- HTMX for SPA-like feel -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    
    <!-- Alpine.js for frontend interactivity (sliders, etc) -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            /* Rich Aesthetics Color Palette */
            --primary: #d4af37; /* Gold */
            --primary-hover: #b5952f;
            --bg-base: #0f172a; /* Slate 900 */
            --bg-surface: #1e293b; /* Slate 800 */
            --bg-elevated: #334155; /* Slate 700 */
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #334155;
            --danger: #ef4444;
            --success: #10b981;
            
            --radius-md: 0.5rem;
            --radius-lg: 1rem;
            --radius-full: 9999px;
            
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.3), 0 2px 4px -2px rgb(0 0 0 / 0.3);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.4);
            
            --transition: all 0.3s ease;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-base);
            color: var(--text-main);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            color: var(--primary);
            text-decoration: none;
            transition: var(--transition);
        }

        a:hover {
            color: var(--primary-hover);
        }

        /* Navbar */
        .navbar {
            background-color: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            letter-spacing: -0.5px;
        }

        .nav-links {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-main);
            font-weight: 500;
        }
        
        .nav-links a:hover {
            color: var(--primary);
        }

        .nav-button {
            background-color: var(--primary);
            color: var(--bg-base) !important;
            padding: 0.5rem 1.25rem;
            border-radius: var(--radius-full);
            font-weight: 600;
            box-shadow: 0 4px 14px 0 rgba(212, 175, 55, 0.39);
        }
        
        .nav-button:hover {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.23);
        }

        /* Layout */
        .main-content {
            flex: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 2rem;
            width: 100%;
        }

        /* UI Components */
        .card {
            background-color: var(--bg-surface);
            border-radius: var(--radius-lg);
            padding: 2rem;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-lg);
            transition: var(--transition);
        }
        
        .card:hover {
            border-color: var(--primary);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.1);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: var(--text-muted);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            background-color: var(--bg-base);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            color: var(--text-main);
            font-family: inherit;
            transition: var(--transition);
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
        }

        .btn-primary {
            display: inline-block;
            width: 100%;
            padding: 0.75rem 1.5rem;
            background-color: var(--primary);
            color: var(--bg-base);
            border: none;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
            text-align: center;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-hover);
            color: var(--bg-base) !important;
            transform: translateY(-1px);
        }

        /* Glassmorphism utilities */
        .glass {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            animation: fadeIn 0.5s ease-out forwards;
        }
        
        .text-center { text-align: center; }
        .text-muted { color: var(--text-muted); }
        .mt-2 { margin-top: 0.5rem; }
        .mt-4 { margin-top: 1rem; }
        .mt-8 { margin-top: 2rem; }
        .mb-2 { margin-bottom: 0.5rem; }
        .mb-4 { margin-bottom: 1rem; }
        .mb-8 { margin-bottom: 2rem; }
        .grid { display: grid; }
        .gap-4 { gap: 1rem; }
        .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
        
        @media (max-width: 768px) {
            .grid-cols-2 { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: 1fr !important; gap: 2rem; }
            .footer-middle { flex-direction: column; gap: 1.5rem; align-items: flex-start !important; }
            .footer-bottom { flex-direction: column; gap: 1rem; align-items: flex-start !important; }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="nav-brand">SalonMS</a>
            <div class="nav-links">
                {% if auth_customer %}
                    <a href="/portal/dashboard">Dashboard</a>
                    <a href="/portal/book">Book Appointment</a>
                    <a href="/portal/logout" class="nav-button" style="background-color: var(--bg-elevated); color: var(--text-main) !important; box-shadow: none;">Logout</a>
                {% else %}
                    <a href="/web/login">Staff Login</a>
                    <a href="/portal/login">Sign In</a>
                    <a href="/portal/register" class="nav-button">Sign Up</a>
                {% endif %}
            </div>
        </div>
    </nav>

    <main class="main-content">
        {% block content %}{% endblock %}
    </main>

    <footer style="background-color: var(--bg-base); border-top: 1px solid var(--border-color); padding: 4rem 2rem 2rem; margin-top: auto; font-family: 'Outfit', sans-serif;">
        <div style="max-width: 1200px; margin: 0 auto;">
            
            <!-- Top Section -->
            <div class="footer-grid" style="display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 2rem; margin-bottom: 3rem;">
                <!-- Brand -->
                <div>
                    <h2 style="color: var(--primary); font-size: 2.25rem; font-weight: 700; margin-bottom: 1rem; line-height: 1;">SalonMS</h2>
                    <p style="color: var(--text-main); font-size: 0.95rem; line-height: 1.5; max-width: 280px; font-weight: 400;">
                        Premium beauty and wellness experiences tailored to your unique style.
                    </p>
                </div>
                
                <!-- Links 1 -->
                <div>
                    <h3 style="color: var(--primary); font-size: 1rem; font-weight: 500; margin-bottom: 1.5rem;">Treatments</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem;">
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Facial</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Massage</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Hair</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Waxing</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Threading</a></li>
                    </ul>
                </div>
                
                <!-- Links 2 -->
                <div>
                    <h3 style="color: var(--primary); font-size: 1rem; font-weight: 500; margin-bottom: 1.5rem;">Company</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem;">
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">About Us</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Careers</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Contact</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Press</a></li>
                    </ul>
                </div>
                
                <!-- Links 3 -->
                <div>
                    <h3 style="color: var(--primary); font-size: 1rem; font-weight: 500; margin-bottom: 1.5rem;">Support</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem;">
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Privacy Policy</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Terms of Service</a></li>
                        <li><a href="#" style="color: var(--text-main); font-size: 0.9rem; font-weight: 600;">Booking FAQ</a></li>
                    </ul>
                </div>
            </div>
            
            <!-- Middle Section: Socials & Button -->
            <div class="footer-middle" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <!-- Social Icons -->
                <div style="display: flex; gap: 1.5rem;">
                    <a href="#" style="color: var(--primary); transition: opacity 0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    </a>
                    <a href="#" style="color: var(--primary); transition: opacity 0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                    </a>
                    <a href="#" style="color: var(--primary); transition: opacity 0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
                    </a>
                </div>
                
                <!-- Book Appointment Button -->
                <a href="/portal/book" style="background-color: var(--primary); color: var(--bg-base) !important; padding: 0.6rem 1.5rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--primary-hover)'" onmouseout="this.style.backgroundColor='var(--primary)'">
                    Book an Appointment
                </a>
            </div>
            
            <!-- Bottom Section -->
            <div class="footer-bottom" style="border-top: 1px solid var(--border-color); padding-top: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0;">
                    &copy; 2024 SalonMS Premium Management. All rights reserved.
                </p>
                <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" style="background: none; border: none; color: var(--primary); font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.25rem; transition: opacity 0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">
                    Back to Top &uarr;
                </button>
            </div>
            
        </div>
    </footer>
</body>
</html>
