<h3 style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--primary);">2. Select Specialist</h3>
{% if employees|length > 0 %}
<div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
    {% for employee in employees %}
    <label class="card" style="flex: 0 1 180px; padding: 1rem; cursor: pointer; border-width: 2px; position: relative; display: flex; flex-direction: column; align-items: center; border-color: var(--border-color); text-align: center;"
           onclick="selectEmployee({{ employee.id }}, '{{ employee.name|escape('js') }}')">
        <input type="radio" id="employee_{{ employee.id }}" name="employee_id" value="{{ employee.id }}" required style="position: absolute; opacity: 0; pointer-events: none;">
        
        {% if employee.profile_image %}
            <img src="{{ employee.profile_image }}" alt="{{ employee.name }}" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover; margin-bottom: 0.75rem;">
        {% else %}
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--bg-color); display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem;">
                <svg style="width: 32px; height: 32px; color: var(--text-color); opacity: 0.5;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
        {% endif %}
        
        <div style="font-weight: 600; font-size: 1rem; margin-bottom: 0.25rem; line-height: 1.2;">{{ employee.name }}</div>
        <div class="text-muted" style="font-size: 0.8rem;">Specialist</div>
    </label>
    {% endfor %}
</div>

{% else %}
<div class="mb-8 p-4 rounded-lg bg-yellow-50 text-yellow-800 border border-yellow-200">
    Sorry, there are currently no specialists available for this service.
</div>
{% endif %}
