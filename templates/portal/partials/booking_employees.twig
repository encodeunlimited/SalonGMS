<h3 class="text-lg text-brand-accent font-semibold mb-4 mt-0">2. Select Specialist</h3>
{% if employees|length > 0 %}
<div class="flex flex-wrap gap-4 mb-8">
    {% for employee in employees %}
    <label class="employee-book-item flex-[0_1_180px] p-4 rounded-xl border border-brand-border bg-brand-card hover:border-brand-accent/50 cursor-pointer transition-all flex flex-col items-center text-center group m-0"
           onclick="selectEmployee({{ employee.id }}, '{{ employee.name|escape('js') }}')">
        <input type="radio" id="employee_{{ employee.id }}" name="employee_id" value="{{ employee.id }}" required class="hidden"
               onchange="document.querySelectorAll('.employee-book-item').forEach(el => { el.classList.remove('border-brand-accent'); el.style.backgroundColor='#1F2937'; el.classList.add('border-brand-border'); }); this.parentElement.classList.remove('border-brand-border'); this.parentElement.classList.add('border-brand-accent'); this.parentElement.style.backgroundColor='rgba(234, 179, 8, 0.1)';">
        
        {% if employee.profile_image %}
            <img src="{{ employee.profile_image }}" alt="{{ employee.name }}" class="w-16 h-16 rounded-full object-cover mb-3 shadow-md border-2 border-transparent group-hover:border-brand-accent transition-colors">
        {% else %}
            <div class="w-16 h-16 rounded-full bg-brand-bg flex items-center justify-center mb-3 shadow-inner border-2 border-transparent group-hover:border-brand-accent transition-colors">
                <svg class="w-8 h-8 text-brand-textMuted opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
        {% endif %}
        
        <div class="font-semibold text-brand-text mb-1 leading-tight group-hover:text-brand-accent transition-colors">{{ employee.name }}</div>
        <div class="text-xs text-brand-textMuted">Specialist</div>
    </label>
    {% endfor %}
</div>
{% else %}
<div class="mb-8 p-4 rounded-lg bg-yellow-900/30 text-yellow-500 border border-yellow-700/50">
    Sorry, there are currently no specialists available for this service.
</div>
{% endif %}
