{% extends 'portal/layout.twig' %}

{% block content %}
<div class="animate-fade-in" style="max-width: 600px; margin: 2rem auto;">
    <div class="card glass">
        <div class="flex items-center gap-4 mb-6 pb-4 border-b border-brand-border">
            <h2 class="text-xl font-bold text-brand-accent m-0">Your Profile</h2>
        </div>

        <form hx-post="/portal/profile" hx-target="#profile-error" hx-swap="outerHTML" enctype="multipart/form-data">
            <div id="profile-error"></div>
            
            <div class="flex justify-center mb-6">
                <div class="relative group">
                    <div class="w-24 h-24 rounded-full overflow-hidden border-4 border-brand-border bg-brand-bg flex items-center justify-center text-3xl">
                        {% if customer.profile_image %}
                            <img src="{{ customer.profile_image }}" alt="{{ customer.name }}" class="w-full h-full object-cover">
                        {% else %}
                            🧑‍💼
                        {% endif %}
                    </div>
                    <label class="absolute bottom-0 right-0 bg-brand-accent text-brand-bg rounded-full p-2 cursor-pointer shadow-md hover:bg-brand-accentHover transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        <input type="file" name="profile_image" class="hidden" accept="image/*" onchange="previewImage(this)">
                    </label>
                </div>
            </div>

            <div class="space-y-4">
                <div class="form-group">
                    <label class="form-label" for="name">Full Name</label>
                    <input type="text" id="name" name="name" class="form-input" value="{{ customer.name }}" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="phone">WhatsApp Number</label>
                    <input type="text" id="phone" name="phone" class="form-input" value="{{ customer.phone }}" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label" for="email">Email Address (Optional)</label>
                    <input type="email" id="email" name="email" class="form-input" value="{{ customer.email }}">
                </div>

                <div class="form-group">
                    <label class="form-label" for="date_of_birth">Birthday (Optional)</label>
                    <input type="date" id="date_of_birth" name="date_of_birth" class="form-input" value="{{ customer.date_of_birth }}">
                </div>
            </div>
            
            <div class="flex justify-end gap-3 mt-8 pt-6 border-t border-brand-border">
                <a href="/portal/dashboard" class="px-6 py-2.5 border border-brand-border text-brand-text rounded-lg hover:bg-brand-card transition-colors font-medium cursor-pointer bg-transparent no-underline">Cancel</a>
                <button type="submit" class="px-6 py-2.5 bg-brand-accent text-brand-bg rounded-lg hover:bg-brand-accentHover transition-colors font-medium shadow-sm cursor-pointer border-none">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
function previewImage(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
            const container = input.closest('.relative').querySelector('.w-24.h-24');
            container.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
        }
        reader.readAsDataURL(input.files[0]);
    }
}

// Clear error on input
document.querySelector('form').addEventListener('input', function() {
    const err = document.getElementById('profile-error');
    if (err && err.innerHTML.trim() !== '') {
        err.innerHTML = '';
        err.className = '';
    }
});
</script>
{% endblock %}
