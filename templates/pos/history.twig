{% extends "layout.twig" %}

{% block content %}
<div class="mb-6 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">POS Transaction History</h2>
        <p class="text-sm text-slate-500 mt-1">View, reprint, or void recent point-of-sale transactions.</p>
    </div>
    <div>
        <a href="/web/pos" class="bg-white text-slate-700 hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-medium border border-slate-200 transition-colors shadow-sm flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to POS
        </a>
    </div>
</div>

<div id="table-container">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <!-- Search / Filter bar -->
        <div class="p-4 border-b border-slate-100 bg-slate-50 flex gap-4">
            <div class="relative flex-1 max-w-md">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                <input type="search" id="search-box" name="search" value="{{ search }}" placeholder="Search transactions..." 
                       hx-get="/web/pos/history?sort={{ sort }}&dir={{ dir }}" 
                       hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true"
                       hx-trigger="keyup changed delay:500ms, search"
                       class="block w-full pl-12 pr-3 py-2 border border-slate-200 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm transition-colors">
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="text-xs text-slate-500 bg-slate-50/50 uppercase font-bold tracking-wider">
                        <th class="px-6 py-5 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/pos/history?sort=created_at&dir={{ sort == 'created_at' and dir == 'asc' ? 'desc' : 'asc' }}"
                            hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                            Date & Time {% if sort == 'created_at' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-5 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/pos/history?sort=id&dir={{ sort == 'id' and dir == 'asc' ? 'desc' : 'asc' }}"
                            hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                            Invoice ID {% if sort == 'id' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-5 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/pos/history?sort=customer_name&dir={{ sort == 'customer_name' and dir == 'asc' ? 'desc' : 'asc' }}"
                            hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                            Customer {% if sort == 'customer_name' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-5 font-medium text-slate-500">Services</th>
                        <th class="px-6 py-5 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/pos/history?sort=payment_method&dir={{ sort == 'payment_method' and dir == 'asc' ? 'desc' : 'asc' }}"
                            hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                            Payment Method {% if sort == 'payment_method' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-5 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/pos/history?sort=total_amount&dir={{ sort == 'total_amount' and dir == 'asc' ? 'desc' : 'asc' }}"
                            hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                            Total {% if sort == 'total_amount' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-5 font-medium cursor-pointer hover:bg-gray-200 transition-colors"
                            hx-get="/web/pos/history?sort=status&dir={{ sort == 'status' and dir == 'asc' ? 'desc' : 'asc' }}"
                            hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true">
                            Status {% if sort == 'status' %}{{ dir == 'asc' ? '↑' : '↓' }}{% endif %}
                        </th>
                        <th class="px-6 py-5 font-medium text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {% for txn in transactions %}
                    <tr class="hover:bg-slate-50 transition-colors group">
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">{{ txn.created_at|date('M j, Y g:i A') }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">#{{ '%05d'|format(txn.id) }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900">{{ txn.customer_name|default('Walk-in') }}</td>
                        <td class="px-6 py-4 text-sm text-slate-500 max-w-xs truncate" title="{{ txn.service_names }}">{{ txn.service_names|default('-') }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">{{ txn.payment_method|default('-') }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">{{ txn.total_amount|number_format(2) }}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if txn.status == 'paid' %}
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Paid</span>
                            {% elseif txn.status == 'void' %}
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Void</span>
                            {% else %}
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">{{ txn.status|title }}</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
                            <a href="#" onclick="window.open('/web/invoices/download/{{ txn.id }}', 'receipt', 'width=400,height=600'); return false;" class="text-blue-600 hover:text-blue-900 inline-block" title="View">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                            </a>
                            
                            <a href="#" onclick="window.open('/web/invoices/download/{{ txn.id }}?print=1', 'receipt', 'width=400,height=600'); return false;" class="text-indigo-600 hover:text-indigo-900 inline-block" title="Reprint">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                            </a>
                            
                            {% if txn.status != 'void' %}
                                <button type="button" 
                                        hx-post="/web/pos/invoices/{{ txn.id }}/void" 
                                        hx-confirm="Are you sure you want to void this invoice?" 
                                        class="text-red-600 hover:text-red-900 inline-block" title="Void">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                </button>
                            {% else %}
                                <span class="inline-block w-5 h-5"></span>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center text-slate-500 bg-slate-50 rounded-b-xl">
                            <div class="flex flex-col items-center justify-center">
                                <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                <p class="text-base font-medium">No transactions found</p>
                                <p class="text-sm mt-1">Try adjusting your search criteria</p>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-slate-100 bg-white flex items-center justify-between">
            <div class="text-sm text-slate-500">
                {% if total > 0 %}
                Showing <span class="font-medium text-slate-900">{{ (page - 1) * 15 + 1 }}</span> to 
                <span class="font-medium text-slate-900">{{ min(page * 15, total) }}</span> of 
                <span class="font-medium text-slate-900">{{ total }}</span> transactions
                {% else %}
                No transactions
                {% endif %}
            </div>
            <div class="flex gap-2">
                {% if page > 1 %}
                <button hx-get="/web/pos/history?page={{ page - 1 }}&sort={{ sort }}&dir={{ dir }}" hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true" class="px-3 py-1 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors">
                    Previous
                </button>
                {% else %}
                <button disabled class="px-3 py-1 border border-slate-200 rounded-md text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed">
                    Previous
                </button>
                {% endif %}
                
                <div class="hidden sm:flex items-center space-x-1">
                    {% for p in 1..max(1, total_pages) %}
                        {% if p == page %}
                            <span class="px-3 py-1 bg-indigo-600 text-white rounded-md text-sm font-medium">{{ p }}</span>
                        {% else %}
                            <button hx-get="/web/pos/history?page={{ p }}&sort={{ sort }}&dir={{ dir }}" hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true" class="px-3 py-1 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-md text-sm font-medium transition-colors">
                                {{ p }}
                            </button>
                        {% endif %}
                    {% endfor %}
                </div>
                
                {% if page < total_pages %}
                <button hx-get="/web/pos/history?page={{ page + 1 }}&sort={{ sort }}&dir={{ dir }}" hx-include="#search-box" hx-target="#table-container" hx-select="#table-container" hx-swap="outerHTML" hx-push-url="true" class="px-3 py-1 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors">
                    Next
                </button>
                {% else %}
                <button disabled class="px-3 py-1 border border-slate-200 rounded-md text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed">
                    Next
                </button>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
