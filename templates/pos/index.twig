{% block scripts %}
<script>
function posSystem() {
    return {
        search_query: '',
        show_checkout_modal: false,
        loyalty_currency_per_point: {{ loyalty_currency_per_point|default(0.001) }},
        employees_data: {{ employees|json_encode|raw }},
        items: [],
        customer_id: '{% if appointment_to_checkout %}{{ appointment_to_checkout.customer_id }}{% else %}{% endif %}',
        employee_id: '{% if appointment_to_checkout %}{{ appointment_to_checkout.user_id }}{% elseif auth_user.role == "stylist" %}{{ auth_user.user_id }}{% else %}{% endif %}',
        payment_method: 'Cash',
        tender_amount: '',
        split_details: [{method: 'Cash', amount: ''}],
        customer_points: 0,
        redeem_points: 0,
        discount_type: 'amount',
        discount_value: '',
        available_redemptions: [],
        
        getRemainingRedemptions(cps_id, total, used) {
            const inCart = this.items.find(i => i.type === 'redemption' && i.id === cps_id);
            const cartQty = inCart ? inCart.quantity : 0;
            return (total - used) - cartQty;
        },
        
        get subtotal() {
            return this.items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        },
        get final_total() {
            let t = this.subtotal;
            let d_val = parseFloat(this.discount_value) || 0;
            if (this.discount_type === 'amount') {
                t = Math.max(0, t - d_val);
            } else {
                t = Math.max(0, t - (t * (d_val / 100)));
            }
            
            const loyalty_discount = (parseFloat(this.redeem_points) || 0) * this.loyalty_currency_per_point;
            return Math.max(0, t - loyalty_discount);
        },
        get change_due() {
            if (this.payment_method !== 'Cash' || this.tender_amount === '') return 0;
            const change = parseFloat(this.tender_amount) - this.final_total;
            return change > 0 ? change : 0;
        },
        get split_total() {
            return this.split_details.reduce((sum, split) => sum + (parseFloat(split.amount) || 0), 0);
        },
        get split_remaining() {
            const rem = this.subtotal - this.split_total;
            return rem > 0 ? rem : 0;
        },
        get points_error() {
            let ptsAmt = 0;
            if (this.payment_method === 'Points') {
                ptsAmt = this.final_total;
            } else if (this.payment_method === 'Split') {
                for (let s of this.split_details) {
                    if (s.method === 'Points') ptsAmt += (parseFloat(s.amount) || 0);
                }
            }
            if (ptsAmt > 0) {
                if (!this.customer_id) return true;
                const needed = Math.ceil(ptsAmt / this.loyalty_currency_per_point);
                const redeem = parseInt(this.redeem_points) || 0;
                if (this.customer_points < (needed + redeem)) return true;
            }
            return false;
        },
        addSplit() {
            this.split_details.push({method: 'Card', amount: this.split_remaining > 0 ? this.split_remaining.toFixed(2) : ''});
        },
        removeSplit(index) {
            this.split_details.splice(index, 1);
        },
        setMethod(method) {
            this.payment_method = method;
            if (method === 'Split' && this.split_details.length === 1 && !this.split_details[0].amount) {
                this.split_details[0].amount = this.final_total.toFixed(2);
            }
        },
        setEmployee(id) {
            this.employee_id = id;
        },
        async onCustomerChange() {
            this.redeem_points = 0;
            if (this.customer_id) {
                const select = this.$el.querySelector('select[x-model="customer_id"]') || document.querySelector('select[x-model="customer_id"]');
                const option = select ? Array.from(select.options).find(opt => opt.value == this.customer_id) : null;
                this.customer_points = option ? parseInt(option.dataset.points || 0) : 0;
                
                try {
                    const res = await fetch(`/web/api/customers/${this.customer_id}/available-redemptions`);
                    if (res.ok) {
                        const data = await res.json();
                        if (data && data.success) {
                            this.available_redemptions = data.packages || [];
                        }
                    }
                } catch (e) {
                    console.error('Failed to fetch available redemptions', e);
                }
            } else {
                this.customer_points = 0;
            }
        },
        addItem(id, type, name, price, service_id = null, initial_service_id = null, initial_service_name = null, stylist_id = null, stylist_name = null) {
            const existing = this.items.find(i => i.id === id && i.type === type && i.name === name && i.initial_service_id === initial_service_id && i.stylist_id === stylist_id);
            if (existing) {
                existing.quantity++;
            } else {
                this.items.push({ id, type, name, price, quantity: 1, service_id, initial_service_id, initial_service_name, stylist_id, stylist_name });
            }
        },
        removeItem(index) {
            this.items.splice(index, 1);
        },
        clearCart() {
            this.items = [];
            this.tender_amount = '';
            this.split_details = [{method: 'Cash', amount: ''}];
            this.redeem_points = 0;
            this.discount_value = '';
        },
        // Immediate Package Redemption
        selected_package: null,
        show_package_modal: false,
        selectPackage(pkg) {
            this.selected_package = pkg;
            if (pkg.services && pkg.services.length > 0) {
                this.show_package_modal = true;
            } else {
                this.addItem(pkg.id, 'package', pkg.name, pkg.price);
            }
        },
        closePackageModal() {
            this.show_package_modal = false;
            this.selected_package = null;
        },
        addPackageWithInitialService(serviceId, serviceName) {
            if (this.selected_package) {
                this.openStylistModal(serviceId, serviceName, this.selected_package.price, true, this.selected_package);
            }
            this.closePackageModal();
        },
        addPackageWithoutInitialService() {
            if (this.selected_package) {
                this.addItem(this.selected_package.id, 'package', this.selected_package.name, this.selected_package.price);
            }
            this.closePackageModal();
        },
        // Stylist Selection Modal
        show_stylist_modal: false,
        pending_service: null,
        filtered_stylists: [],
        openStylistModal(serviceId, serviceName, servicePrice, isPackageService = false, packageDetails = null, isRedemption = false, redemptionServiceId = null) {
            this.pending_service = { id: serviceId, name: serviceName, price: servicePrice, isPackageService: isPackageService, packageDetails: packageDetails, isRedemption: isRedemption, redemptionServiceId: redemptionServiceId };
            // Filter stylists: check if they have specialist_areas containing serviceId
            const filterId = redemptionServiceId || serviceId;
            this.filtered_stylists = this.employees_data.map(emp => {
                let is_specialist = false;
                if (emp.specialist_areas) {
                    try {
                        const areas = typeof emp.specialist_areas === 'string' ? JSON.parse(emp.specialist_areas) : emp.specialist_areas;
                        if (Array.isArray(areas) && areas.includes(filterId.toString())) {
                            is_specialist = true;
                        }
                    } catch (e) {}
                }
                return { ...emp, is_specialist };
            });
            // Sort: specialists first
            this.filtered_stylists.sort((a, b) => {
                if (a.is_specialist && !b.is_specialist) return -1;
                if (!a.is_specialist && b.is_specialist) return 1;
                return 0;
            });
            this.show_stylist_modal = true;
        },
        closeStylistModal() {
            this.show_stylist_modal = false;
            this.pending_service = null;
        },
        confirmStylist(stylistId, stylistName) {
            if (this.pending_service) {
                if (this.pending_service.isRedemption) {
                    this.addItem(
                        this.pending_service.id,
                        'redemption',
                        this.pending_service.name,
                        this.pending_service.price,
                        this.pending_service.redemptionServiceId,
                        null,
                        null,
                        stylistId,
                        stylistName
                    );
                } else if (this.pending_service.isPackageService && this.pending_service.packageDetails) {
                    this.addItem(
                        this.pending_service.packageDetails.id,
                        'package',
                        this.pending_service.packageDetails.name,
                        this.pending_service.packageDetails.price,
                        null,
                        this.pending_service.id,
                        this.pending_service.name,
                        stylistId,
                        stylistName
                    );
                } else {
                    this.addItem(
                        this.pending_service.id, 
                        'service', 
                        this.pending_service.name, 
                        this.pending_service.price,
                        null,
                        null,
                        null,
                        stylistId,
                        stylistName
                    );
                }
            }
            this.closeStylistModal();
        }
    }
}
</script>

<!-- Close Register Modal -->
<dialog id="closeRegisterModal" class="bg-white rounded-xl shadow-xl p-0 backdrop:bg-gray-900/50 w-full max-w-md m-auto">
    <div class="p-6">
