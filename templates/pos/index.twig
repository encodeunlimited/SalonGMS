{% extends "layout.twig" %}

{% block content %}
<div class="mb-3 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Point of Sale</h2>
        <p class="text-sm text-slate-500 mt-1">Quick checkout for walk-ins and appointments.</p>
    </div>
    <div class="flex items-center space-x-2">
        <a href="/web/pos/history" class="bg-white text-slate-700 hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-medium border border-slate-200 transition-colors shadow-sm flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            History
        </a>
        {% if active_session %}
        <button type="button" onclick="document.getElementById('closeRegisterModal').showModal()" class="bg-red-50 text-red-600 hover:bg-red-100 px-4 py-2 rounded-lg text-sm font-medium border border-red-200 transition-colors shadow-sm flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            Close Register
        </button>
        {% endif %}
    </div>
</div>

<div id="pos-alerts"></div>

<style>
    /* Restrict TomSelect height to match the search input exactly */
    .pos-customer-ts .ts-control {
        min-height: 42px !important;
        height: 42px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        display: flex;
        align-items: center;
    }
    .pos-customer-ts .ts-control .item, .pos-customer-ts .ts-control input {
        line-height: normal !important;
        margin-bottom: 0 !important;
        margin-top: 0 !important;
    }
</style>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6" x-data="posSystem()" {% if appointment_to_checkout %}x-init="addItem({{ appointment_to_checkout.item_id|default(0) }}, '{{ appointment_to_checkout.item_type|default('service')|escape('js') }}', '{{ appointment_to_checkout.item_name|escape('js') }}', {{ appointment_to_checkout.item_price|default(0) }})"{% endif %}>
    <!-- Left: Service Selection -->
    <div class="lg:col-span-8">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden h-[calc(100vh-140px)] flex flex-col">
            <div class="p-4 border-b border-slate-100 bg-slate-50 flex-shrink-0 flex items-center space-x-3">
                <div class="flex-1 pos-customer-ts">
                    <select x-model="customer_id" x-init="const ts = new TomSelect($el, { placeholder: 'Select Customer...' }); ts.on('change', (val) => { customer_id = val; onCustomerChange(); })" class="w-full shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block sm:text-sm border-slate-300 rounded-md bg-white">
                        <option value="">Walk-in Customer</option>
                        {% for customer in customers %}
                            <option value="{{ customer.id }}" data-points="{{ customer.loyalty_points|default(0) }}" {% if appointment_to_checkout and appointment_to_checkout.customer_id == customer.id %}selected{% endif %}>
                                {{ customer.name }} {% if customer.phone %}({{ customer.phone }}){% endif %} - {{ customer.loyalty_points|default(0) }} pts
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="flex-1">
                    <input type="text" x-model="search_query" placeholder="Search services..." class="w-full h-[42px] focus:ring-indigo-500 focus:border-indigo-500 block shadow-sm sm:text-sm border-slate-300 rounded-md px-3 border">
                </div>
            </div>
            <div class="p-4 flex-1 overflow-y-auto space-y-6">
                <!-- Available Redemptions (Dynamic based on selected customer) -->
                <template x-if="available_redemptions && available_redemptions.length > 0">
                    <div class="mb-6">
                        <h3 class="font-bold text-indigo-600 text-sm mb-3 uppercase tracking-wider flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Available Redemptions
                        </h3>
                        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                            <template x-for="pkg in available_redemptions" :key="pkg.id">
                                <template x-for="srv in pkg.services" :key="srv.customer_package_service_id">
                                    <div x-show="getRemainingRedemptions(srv.customer_package_service_id, srv.total_quantity, srv.used_quantity) > 0"
                                         @click="openStylistModal(srv.customer_package_service_id, `Package: ${pkg.name} (Package Redemption) - ${srv.service_name}`, 0, false, null, true, srv.service_id)" 
                                         class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 cursor-pointer hover:shadow-md hover:border-yellow-400 transition-all group flex flex-col justify-between h-full relative overflow-hidden">
                                        <div class="absolute top-0 right-0 w-8 h-8 bg-yellow-400/20 rounded-bl-full -mr-2 -mt-2 group-hover:scale-150 transition-transform"></div>
                                        <div>
                                            <h4 class="font-bold text-slate-900 text-sm mb-1 leading-tight" x-text="srv.service_name"></h4>
                                            <p class="text-xs text-yellow-700 line-clamp-1 mb-2" x-text="'From: ' + pkg.name"></p>
                                        </div>
                                        <div class="flex justify-between items-end mt-2">
                                            <span class="text-yellow-800 font-bold text-xs bg-yellow-100 px-2 py-0.5 rounded-full" x-text="getRemainingRedemptions(srv.customer_package_service_id, srv.total_quantity, srv.used_quantity) + ' left'"></span>
                                            <div class="w-6 h-6 rounded-full bg-white flex items-center justify-center text-yellow-600 shadow-sm group-hover:bg-yellow-400 group-hover:text-white transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                                            </div>
                                        </div>
                                    </div>
                                </template>
                            </template>
                        </div>
                    </div>
                </template>

                <!-- Packages Category -->
                {% if packages|length > 0 %}
                <div class="mb-6" x-show="search_query === '' || [
                    {% for pkg in packages %}
                        '{{ pkg.name|lower|escape('js') }}'{% if not loop.last %},{% endif %}
                    {% endfor %}
                ].some(name => name.includes(search_query.toLowerCase()))">
                    <h3 class="font-bold text-slate-800 text-sm mb-3 uppercase tracking-wider">Packages</h3>
                    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                        {% for pkg in packages %}
                        <div x-show="search_query === '' || '{{ pkg.name|lower|escape('js') }}'.includes(search_query.toLowerCase())"
                             @click="selectPackage({{ pkg|json_encode|escape('html_attr') }})" 
                             class="bg-white border border-slate-100 rounded-lg p-3 cursor-pointer hover:shadow-md hover:border-indigo-600 transition-all group flex flex-col justify-between h-full relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-8 h-8 bg-indigo-600/10 rounded-bl-full -mr-2 -mt-2 group-hover:scale-150 transition-transform"></div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm mb-1 leading-tight">{{ pkg.name }}</h4>
                                <p class="text-xs text-slate-500 line-clamp-2 mb-2">{{ pkg.description }}</p>
                            </div>
                            <div class="flex justify-between items-end mt-2">
                                <span class="text-indigo-600 font-bold text-sm">QAR {{ pkg.price }}</span>
                                <div class="w-6 h-6 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% for category, services in services_by_category %}
                <div x-show="search_query === '' || [
                    {% for service in services %}
                        '{{ service.name|lower|escape('js') }}'{% if not loop.last %},{% endif %}
                    {% endfor %}
                ].some(name => name.includes(search_query.toLowerCase()))">
                    <h4 class="text-lg font-semibold text-slate-800 mb-3 border-b pb-2">{{ category }}</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                        {% for service in services %}
                        <div x-show="search_query === '' || '{{ service.name|lower|escape('js') }}'.includes(search_query.toLowerCase())"
                             @click="openStylistModal({{ service.id }}, '{{ service.name|escape('js') }}', {{ service.price }})" class="border border-slate-200 rounded-lg p-3 cursor-pointer hover:border-indigo-600 hover:shadow-md transition-all flex flex-col justify-center items-center text-center bg-white group select-none active:bg-slate-50">
                            <div class="h-8 w-8 rounded-full bg-indigo-600 text-white flex items-center justify-center mb-2 group-hover:bg-indigo-600 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </div>
                            <h4 class="font-medium text-slate-900 text-xs">{{ service.name }}</h4>
                            <p class="text-indigo-600 font-bold mt-1 text-sm">QAR {{ service.price|number_format(2) }}</p>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% else %}
                    <!-- Fallback mock services if DB is empty -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4" x-show="search_query === '' || ['haircut', 'coloring'].some(name => name.includes(search_query.toLowerCase()))">
                        <div x-show="search_query === '' || 'haircut'.includes(search_query.toLowerCase())"
                             @click="addItem(0, 'service', 'Haircut', 45.00)" class="border border-slate-200 rounded-lg p-3 cursor-pointer hover:border-indigo-600 hover:shadow-md transition-all flex flex-col justify-center items-center text-center bg-white group select-none active:bg-slate-50">
                            <div class="h-8 w-8 rounded-full bg-indigo-600 text-white flex items-center justify-center mb-2 group-hover:bg-indigo-600 transition-colors text-lg">✂️</div>
                            <h4 class="font-medium text-slate-900 text-xs">Haircut</h4>
                            <p class="text-indigo-600 font-bold mt-1 text-sm">QAR 45.00</p>
                        </div>
                        <div x-show="search_query === '' || 'coloring'.includes(search_query.toLowerCase())"
                             @click="addItem(0, 'service', 'Coloring', 120.00)" class="border border-slate-200 rounded-lg p-3 cursor-pointer hover:border-indigo-600 hover:shadow-md transition-all flex flex-col justify-center items-center text-center bg-white group select-none active:bg-slate-50">
                            <div class="h-8 w-8 rounded-full bg-indigo-600 text-white flex items-center justify-center mb-2 group-hover:bg-indigo-600 transition-colors">🎨</div>
                            <h4 class="font-medium text-slate-900 text-xs">Coloring</h4>
                            <p class="text-indigo-600 font-bold mt-1 text-sm">QAR 120.00</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Middle: Live Bill Preview -->
    <div class="lg:col-span-4 bg-white rounded-2xl shadow-sm border border-slate-100 flex flex-col h-[calc(100vh-140px)]">
        <div class="p-3 border-b border-slate-100 flex-shrink-0 bg-indigo-600 text-white rounded-t-xl">
            <h3 class="text-lg font-bold text-center">Live Preview</h3>
        </div>
        
        <!-- Cart Items -->
        <div class="flex-1 overflow-y-auto p-3 bg-slate-50">
            <template x-if="items.length === 0">
                <div class="text-center text-slate-400 py-6">
                    <svg class="w-12 h-12 mx-auto mb-3 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    <p>Select services to add to cart</p>
                </div>
            </template>
            <!-- Live Preview POS Cart Iteration -->
            <template x-for="(item, index) in items" :key="index">
                <div class="flex justify-between items-start mb-3 pb-3 border-b border-slate-100 last:border-0 last:pb-0 last:mb-0 group">
                    <div class="flex-1 pr-3">
                        <h5 class="text-sm font-medium text-slate-900 leading-tight flex items-center">
                            <span x-text="item.name"></span>
                            <template x-if="item.type === 'redemption'">
                                <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-yellow-100 text-yellow-800">Redeem</span>
                            </template>
                        </h5>
                        <template x-if="item.stylist_name">
                            <p class="text-xs text-slate-500 mt-0.5"><span class="font-medium">Stylist:</span> <span x-text="item.stylist_name"></span></p>
                        </template>
                        <template x-if="item.initial_service_name">
                            <p class="text-xs text-indigo-600 mt-0.5"><span class="font-medium">Includes:</span> <span x-text="item.initial_service_name"></span></p>
                        </template>
                        <div class="flex items-center mt-2 space-x-2">
                            <div class="flex items-center border border-slate-200 rounded-md">
                                <button type="button" @click="item.quantity > 1 ? item.quantity-- : removeItem(index)" class="px-2 py-0.5 text-slate-500 hover:text-red-500 hover:bg-slate-50 rounded-l-md transition-colors">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
                                </button>
                                <span class="px-2 py-0.5 text-xs font-bold text-slate-700 w-6 text-center" x-text="item.quantity"></span>
                                <button type="button" @click="item.quantity++" class="px-2 py-0.5 text-slate-500 hover:text-indigo-600 hover:bg-slate-50 rounded-r-md transition-colors">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                </button>
                            </div>
                            <span class="text-xs text-slate-400">@ <span x-text="item.price.toFixed(2)"></span></span>
                        </div>
                    </div>
                    <div class="text-right flex flex-col justify-between items-end h-full">
                        <span class="text-sm font-bold text-slate-900" x-text="(item.price * item.quantity).toFixed(2)"></span>
                        <button type="button" @click="removeItem(index)" class="mt-2 text-gray-300 hover:text-red-500 transition-colors opacity-0 group-hover:opacity-100">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>
                    
                    <!-- Hidden fields for submission -->
                    <input type="hidden" :name="`items[${index}][id]`" :value="item.id">
                    <input type="hidden" :name="`items[${index}][type]`" :value="item.type">
                    <input type="hidden" :name="`items[${index}][name]`" :value="item.name">
                    <input type="hidden" :name="`items[${index}][price]`" :value="item.price">
                    <input type="hidden" :name="`items[${index}][quantity]`" :value="item.quantity">
                    <template x-if="item.service_id">
                        <input type="hidden" :name="`items[${index}][service_id]`" :value="item.service_id">
                    </template>
                    <template x-if="item.initial_service_id">
                        <input type="hidden" :name="`items[${index}][initial_service_id]`" :value="item.initial_service_id">
                    </template>
                    <template x-if="item.initial_service_name">
                        <input type="hidden" :name="`items[${index}][initial_service_name]`" :value="item.initial_service_name">
                    </template>
                    <template x-if="item.stylist_id">
                        <input type="hidden" :name="`items[${index}][stylist_id]`" :value="item.stylist_id">
                    </template>
                    <template x-if="item.stylist_name">
                        <input type="hidden" :name="`items[${index}][stylist_name]`" :value="item.stylist_name">
                    </template>
                </div>
            </template>
        </div>

        <!-- Summary Section -->
        <div class="p-4 border-t border-slate-200 bg-white rounded-b-xl flex-shrink-0">
            <div class="flex justify-between text-sm font-medium text-slate-900 mb-1">
                <p>Subtotal</p>
                <p>QAR <span x-text="subtotal.toFixed(2)"></span></p>
            </div>
            <div class="flex justify-between text-sm font-medium text-slate-900 mb-2 items-center">
                <p>Discount</p>
                <div class="flex items-center space-x-1">
                    <select x-model="discount_type" class="border border-slate-300 rounded text-xs p-1 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="amount">QAR</option>
                        <option value="percent">%</option>
                    </select>
                    <input type="number" x-model.number="discount_value" min="0" class="w-16 border border-slate-300 rounded text-right text-xs p-1 focus:ring-indigo-500 focus:border-indigo-500" placeholder="0">
                </div>
            </div>
            <div class="flex justify-between text-lg font-bold text-indigo-700 border-t pt-2 mt-2">
                <p>Total</p>
                <p>QAR <span x-text="final_total.toFixed(2)"></span></p>
            </div>
            
            <button type="button" 
                    @click="show_checkout_modal = true"
                    :disabled="items.length === 0" 
                    class="w-full mt-4 bg-indigo-600 text-white py-3 text-lg rounded-lg font-bold hover:bg-gray-800 shadow-md transition-colors disabled:opacity-50 flex items-center justify-center">
                Checkout
            </button>
        </div>
    </div>

    <!-- Checkout Modal -->
    <template x-teleport="body">
        <div x-show="show_checkout_modal" class="fixed inset-0 z-50 overflow-y-auto" style="display: none;">
            <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <div x-show="show_checkout_modal" x-transition.opacity class="fixed inset-0 transition-opacity" aria-hidden="true">
                    <div class="absolute inset-0 bg-slate-500 opacity-75" @click="show_checkout_modal = false"></div>
                </div>
                <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
                <div x-show="show_checkout_modal" x-transition class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full">
                    <div class="p-3 border-b border-slate-100 bg-salon-navy text-white flex justify-between items-center rounded-t-lg">
                        <h3 class="text-lg font-bold">Checkout</h3>
                        <button @click="show_checkout_modal = false" class="text-white hover:text-gray-200 focus:outline-none">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                    <div class="p-4 bg-white">
                        <form hx-post="/web/pos/checkout" hx-swap="none" @htmx:after-request="if($event.detail.successful){ clearCart(); onCustomerChange(); show_checkout_modal = false; }">

                <div class="mb-5">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Payment Method</label>
                    <div class="grid grid-cols-3 md:grid-cols-6 gap-2">
                        {% if settings.pos_show_cash|default('1') == '1' %}
                        <button type="button" @click="setMethod('Cash')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all flex flex-col items-center justify-center space-y-1"
                                :class="payment_method == 'Cash' ? 'border-indigo-600 bg-yellow-50 text-indigo-600' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            <span>Cash</span>
                        </button>
                        {% endif %}
                        
                        {% if settings.pos_show_card|default('1') == '1' %}
                        <button type="button" @click="setMethod('Card')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all flex flex-col items-center justify-center space-y-1"
                                :class="payment_method == 'Card' ? 'border-indigo-600 bg-yellow-50 text-indigo-600' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                            <span>Card</span>
                        </button>
                        {% endif %}
                        
                        {% if settings.pos_show_bank_transfer|default('1') == '1' %}
                        <button type="button" @click="setMethod('Bank Transfer')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all flex flex-col items-center justify-center space-y-1"
                                :class="payment_method == 'Bank Transfer' ? 'border-indigo-600 bg-yellow-50 text-indigo-600' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                            <span>Transfer</span>
                        </button>
                        {% endif %}
                        
                        {% if settings.pos_show_points|default('1') == '1' %}
                        <button type="button" @click="setMethod('Points')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all flex flex-col items-center justify-center space-y-1"
                                :class="payment_method == 'Points' ? 'border-indigo-600 bg-yellow-50 text-indigo-600' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
                            <span>Points</span>
                        </button>
                        {% endif %}
                        
                        {% if settings.pos_show_credit|default('1') == '1' %}
                        <button type="button" @click="setMethod('Credit')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all flex flex-col items-center justify-center space-y-1"
                                :class="payment_method == 'Credit' ? 'border-indigo-600 bg-yellow-50 text-indigo-600' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                            <span>Credit</span>
                        </button>
                        {% endif %}
                        
                        {% if settings.pos_show_split|default('1') == '1' %}
                        <button type="button" @click="setMethod('Split')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all flex flex-col items-center justify-center space-y-1"
                                :class="payment_method == 'Split' ? 'border-indigo-600 bg-yellow-50 text-indigo-600' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300'">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path></svg>
                            <span>Split</span>
                        </button>
                        {% endif %}
                    </div>
                </div>
                
                <!-- Cash Tender Amount -->
                <div x-show="payment_method === 'Cash'" class="mb-5 bg-slate-50 p-4 rounded-lg border border-slate-200" style="display: none;">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Tender Amount</label>
                    <div class="flex items-center space-x-3">
                        <div class="relative flex-1">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-slate-500 sm:text-sm font-medium">QAR</span>
                            </div>
                            <input type="number" x-model="tender_amount" step="0.01" class="!pl-14 focus:ring-indigo-500 focus:border-indigo-500 block w-full pr-12 sm:text-lg font-medium border-slate-300 rounded-md py-3 shadow-sm" placeholder="0.00">
                        </div>
                    </div>
                    <div class="mt-3 flex justify-between items-center text-sm" x-show="tender_amount !== '' && parseFloat(tender_amount) >= final_total">
                        <span class="text-slate-600 font-medium">Change Due:</span>
                        <span class="font-bold text-green-600 text-xl">QAR <span x-text="change_due.toFixed(2)"></span></span>
                    </div>
                    <div class="mt-3 flex justify-between items-center text-sm" x-show="tender_amount !== '' && parseFloat(tender_amount) < final_total">
                        <span class="text-red-500 font-medium flex items-center"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg> Insufficient funds</span>
                    </div>
                </div>

                <!-- Split Payments -->
                <div x-show="payment_method === 'Split'" class="mb-5 bg-slate-50 p-4 rounded-lg border border-slate-200" style="display: none;">
                    <label class="block text-sm font-bold text-slate-700 mb-3">Split Payments</label>
                    <template x-for="(split, index) in split_details" :key="index">
                        <div class="flex items-center space-x-2 mb-3">
                            <select x-model="split.method" class="block w-2/5 py-3 px-3 border border-slate-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 sm:text-sm font-medium">
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                                <option value="Bank Transfer">Transfer</option>
                                <option value="Points">Points</option>
                                <option value="Credit">Credit</option>
                            </select>
                            <div class="relative flex-1">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="text-slate-500 sm:text-sm font-medium">QAR</span>
                                </div>
                                <input type="number" x-model.number="split.amount" min="0" step="0.01"
                                    class="block w-full !pl-14 pr-2 sm:text-lg border-slate-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 py-3 shadow-sm" placeholder="0.00">
                            </div>
                            <button type="button" @click="removeSplit(index)" :disabled="split_details.length === 1" class="text-red-500 p-2 hover:bg-red-50 rounded-md disabled:opacity-30 border border-transparent hover:border-red-200 transition-colors">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    </template>
                    <div class="flex justify-between items-center mt-4 pt-3 border-t border-slate-200">
                        <button type="button" @click="addSplit()" class="text-sm bg-white border border-slate-300 shadow-sm text-slate-700 px-3 py-1.5 rounded-md font-medium hover:bg-slate-50 flex items-center transition-colors">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> Add Payment
                        </button>
                        <div class="text-sm">
                            <span class="text-slate-600 mr-2">Remaining:</span>
                            <span class="font-bold text-lg" :class="split_remaining < 0.01 ? 'text-green-600' : 'text-red-500'">QAR <span x-text="split_remaining.toFixed(2)"></span></span>
                        </div>
                    </div>
                </div>
                
                <!-- Reactive hidden inputs to bridge Alpine data to HTMX -->
                <div x-show="points_error" class="mb-5 p-4 rounded-lg bg-red-50 border border-red-200" style="display: none;">
                    <p class="text-sm text-red-700 font-medium">Insufficient loyalty points or no customer selected to pay with Points.</p>
                </div>
                
                <div id="hidden-inputs-container">
                    <template x-for="(item, index) in items" :key="index">
                        <div>
                            <input type="hidden" :name="`items[${index}][id]`" :value="item.id">
                            <input type="hidden" :name="`items[${index}][type]`" :value="item.type">
                            <input type="hidden" :name="`items[${index}][name]`" :value="item.name">
                            <input type="hidden" :name="`items[${index}][price]`" :value="item.price">
                            <input type="hidden" :name="`items[${index}][quantity]`" :value="item.quantity">
                            <input type="hidden" :name="`items[${index}][service_id]`" :value="item.service_id">
                            <template x-if="item.initial_service_id">
                                <input type="hidden" :name="`items[${index}][initial_service_id]`" :value="item.initial_service_id">
                            </template>
                            <template x-if="item.initial_service_name">
                                <input type="hidden" :name="`items[${index}][initial_service_name]`" :value="item.initial_service_name">
                            </template>
                            <template x-if="item.stylist_id">
                                <input type="hidden" :name="`items[${index}][stylist_id]`" :value="item.stylist_id">
                            </template>
                            <template x-if="item.stylist_name">
                                <input type="hidden" :name="`items[${index}][stylist_name]`" :value="item.stylist_name">
                            </template>
                        </div>
                    </template>
                    
                    <input type="hidden" name="customer_id" :value="customer_id" x-if="customer_id">
                    <input type="hidden" name="redeem_points" :value="redeem_points" x-if="customer_id && redeem_points > 0">
                    <input type="hidden" name="employee_id" :value="employee_id">
                    <input type="hidden" name="payment_method" :value="payment_method">
                    
                    <template x-if="parseFloat(discount_value) > 0">
                        <input type="hidden" name="custom_discount" :value="discount_type === 'amount' ? discount_value : (subtotal * (discount_value / 100)).toFixed(2)">
                    </template>
                    
                    <template x-if="payment_method === 'Cash' && tender_amount !== ''">
                        <div>
                            <input type="hidden" name="tender_amount" :value="tender_amount">
                            <input type="hidden" name="change_amount" :value="change_due.toFixed(2)">
                        </div>
                    </template>
                    
                    <template x-if="payment_method === 'Split'">
                        <template x-for="(split, index) in split_details" :key="index">
                            <div>
                                <input type="hidden" :name="`split_details[${index}][method]`" :value="split.method">
                                <input type="hidden" :name="`split_details[${index}][amount]`" :value="split.amount">
                            </div>
                        </template>
                    </template>
                </div>
                {% if appointment_to_checkout %}
                    <input type="hidden" name="appointment_id" value="{{ appointment_to_checkout.id }}">
                {% endif %}
                
                <button type="submit" 
                        :disabled="items.length === 0 || (payment_method === 'Cash' && tender_amount !== '' && parseFloat(tender_amount) < final_total) || (payment_method === 'Split' && split_remaining > 0.01) || points_error" 
                        class="w-full bg-indigo-600 text-white py-4 text-lg rounded-lg font-bold hover:bg-indigo-700 shadow-md transition-colors disabled:opacity-50 flex items-center justify-center">
                    Pay QAR <span x-text="final_total.toFixed(2)" class="ml-1"></span>
                    <svg class="animate-spin ml-2 h-5 w-5 text-white htmx-indicator" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>
</div>
</template>

