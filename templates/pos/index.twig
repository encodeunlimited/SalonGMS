{% extends "layout.twig" %}

{% block content %}
<div class="mb-3 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Point of Sale</h2>
        <p class="text-sm text-gray-500 mt-1">Quick checkout for walk-ins and appointments.</p>
    </div>
</div>

<div id="pos-alerts"></div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6" x-data="posSystem()" {% if appointment_to_checkout %}x-init="addItem({{ appointment_to_checkout.item_id|default(0) }}, '{{ appointment_to_checkout.item_type|default('service')|escape('js') }}', '{{ appointment_to_checkout.item_name|escape('js') }}', {{ appointment_to_checkout.item_price|default(0) }})"{% endif %}>
    <!-- Left: Service Selection -->
    <div class="lg:col-span-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden h-[calc(100vh-140px)] flex flex-col">
            <div class="p-4 border-b border-gray-100 bg-gray-50 flex-shrink-0">
                <input type="text" placeholder="Search services..." class="w-full focus:ring-salon-accent focus:border-salon-accent block shadow-sm sm:text-sm border-gray-300 rounded-md py-2 px-3 border">
            </div>
            <div class="p-4 flex-1 overflow-y-auto space-y-6">
                <!-- Available Redemptions (Dynamic based on selected customer) -->
                <template x-if="available_redemptions && available_redemptions.length > 0">
                    <div class="mb-6">
                        <h3 class="font-bold text-salon-accent text-sm mb-3 uppercase tracking-wider flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Available Redemptions
                        </h3>
                        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                            <template x-for="pkg in available_redemptions" :key="pkg.id">
                                <template x-for="srv in pkg.services" :key="srv.customer_package_service_id">
                                    <div x-show="getRemainingRedemptions(srv.customer_package_service_id, srv.total_quantity, srv.used_quantity) > 0"
                                         @click="addItem(srv.customer_package_service_id, 'redemption', `Package: ${pkg.name} (Package Redemption) - ${srv.service_name}`, 0, srv.service_id)" 
                                         class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 cursor-pointer hover:shadow-md hover:border-yellow-400 transition-all group flex flex-col justify-between h-full relative overflow-hidden">
                                        <div class="absolute top-0 right-0 w-8 h-8 bg-yellow-400/20 rounded-bl-full -mr-2 -mt-2 group-hover:scale-150 transition-transform"></div>
                                        <div>
                                            <h4 class="font-bold text-gray-900 text-sm mb-1 leading-tight" x-text="srv.service_name"></h4>
                                            <p class="text-xs text-yellow-700 line-clamp-1 mb-2" x-text="'From: ' + pkg.name"></p>
                                        </div>
                                        <div class="flex justify-between items-end mt-2">
                                            <span class="text-yellow-800 font-bold text-xs bg-yellow-100 px-2 py-0.5 rounded-full" x-text="getRemainingRedemptions(srv.customer_package_service_id, srv.total_quantity, srv.used_quantity) + ' left'"></span>
                                            <div class="w-6 h-6 rounded-full bg-white flex items-center justify-center text-yellow-600 shadow-sm group-hover:bg-yellow-400 group-hover:text-white transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                                            </div>
                                        </div>
                                    </div>
                                </template>
                            </template>
                        </div>
                    </div>
                </template>

                <!-- Packages Category -->
                {% if packages|length > 0 %}
                <div class="mb-6">
                    <h3 class="font-bold text-gray-800 text-sm mb-3 uppercase tracking-wider">Packages</h3>
                    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                        {% for pkg in packages %}
                        <div @click="selectPackage({{ pkg|json_encode|escape('html_attr') }})" 
                             class="bg-white border border-gray-100 rounded-lg p-3 cursor-pointer hover:shadow-md hover:border-salon-accent transition-all group flex flex-col justify-between h-full relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-8 h-8 bg-salon-accent/10 rounded-bl-full -mr-2 -mt-2 group-hover:scale-150 transition-transform"></div>
                            <div>
                                <h4 class="font-bold text-gray-900 text-sm mb-1 leading-tight">{{ pkg.name }}</h4>
                                <p class="text-xs text-gray-500 line-clamp-2 mb-2">{{ pkg.description }}</p>
                            </div>
                            <div class="flex justify-between items-end mt-2">
                                <span class="text-salon-accent font-bold text-sm">QAR {{ pkg.price }}</span>
                                <div class="w-6 h-6 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 group-hover:bg-salon-accent group-hover:text-white transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% for category, services in services_by_category %}
                <div>
                    <h4 class="text-lg font-semibold text-gray-800 mb-3 border-b pb-2">{{ category }}</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                        {% for service in services %}
                        <div @click="addItem({{ service.id }}, 'service', '{{ service.name|escape('js') }}', {{ service.price }})" class="border border-gray-200 rounded-lg p-3 cursor-pointer hover:border-salon-accent hover:shadow-md transition-all flex flex-col justify-center items-center text-center bg-white group select-none active:bg-gray-50">
                            <div class="h-8 w-8 rounded-full bg-salon-dark text-white flex items-center justify-center mb-2 group-hover:bg-salon-accent transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </div>
                            <h4 class="font-medium text-gray-900 text-xs">{{ service.name }}</h4>
                            <p class="text-salon-accent font-bold mt-1 text-sm">QAR {{ service.price|number_format(2) }}</p>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% else %}
                    <!-- Fallback mock services if DB is empty -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                        <div @click="addItem(0, 'service', 'Haircut', 45.00)" class="border border-gray-200 rounded-lg p-3 cursor-pointer hover:border-salon-accent hover:shadow-md transition-all flex flex-col justify-center items-center text-center bg-white group select-none active:bg-gray-50">
                            <div class="h-8 w-8 rounded-full bg-salon-dark text-white flex items-center justify-center mb-2 group-hover:bg-salon-accent transition-colors text-lg">✂️</div>
                            <h4 class="font-medium text-gray-900 text-xs">Haircut</h4>
                            <p class="text-salon-accent font-bold mt-1 text-sm">QAR 45.00</p>
                        </div>
                        <div @click="addItem(0, 'service', 'Coloring', 120.00)" class="border border-gray-200 rounded-lg p-3 cursor-pointer hover:border-salon-accent hover:shadow-md transition-all flex flex-col justify-center items-center text-center bg-white group select-none active:bg-gray-50">
                            <div class="h-8 w-8 rounded-full bg-salon-dark text-white flex items-center justify-center mb-2 group-hover:bg-salon-accent transition-colors">🎨</div>
                            <h4 class="font-medium text-gray-900 text-xs">Coloring</h4>
                            <p class="text-salon-accent font-bold mt-1 text-sm">QAR 120.00</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Middle: Live Bill Preview -->
    <div class="lg:col-span-3 bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col h-[calc(100vh-140px)]">
        <div class="p-3 border-b border-gray-100 flex-shrink-0 bg-salon-dark text-white rounded-t-xl">
            <h3 class="text-lg font-bold text-center">Live Preview</h3>
        </div>
        
        <!-- Cart Items -->
        <div class="flex-1 overflow-y-auto p-3 bg-gray-50">
            <template x-if="items.length === 0">
                <div class="text-center text-gray-400 py-6">
                    <svg class="w-12 h-12 mx-auto mb-3 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    <p>Select services to add to cart</p>
                </div>
            </template>
            <template x-for="(item, index) in items" :key="index">
                <div class="flex justify-between items-center mb-2 bg-white p-2 rounded shadow-sm border border-gray-100">
                    <div>
                        <h4 class="font-medium text-sm text-gray-900" x-text="item.type === 'package' ? (item.initial_service_name ? `Package: ${item.name} (First Service: ${item.initial_service_name})` : `Package: ${item.name}`) : item.name"></h4>
                        <p class="text-xs text-gray-500">QAR <span x-text="item.price.toFixed(2)"></span> x <span x-text="item.quantity"></span></p>
                    </div>
                    <div class="flex items-center">
                        <p class="font-bold text-base text-gray-900 mr-4">QAR <span x-text="(item.price * item.quantity).toFixed(2)"></span></p>
                        <button @click="removeItem(index)" class="text-red-500 hover:text-red-700 p-3 -mr-3 bg-red-50 rounded-full hover:bg-red-100 transition-colors" title="Remove">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>
                </div>
            </template>
        </div>

        <!-- Summary Section -->
        <div class="p-4 border-t border-gray-200 bg-white rounded-b-xl flex-shrink-0">
            <div class="flex justify-between text-sm font-medium text-gray-900 mb-1">
                <p>Subtotal</p>
                <p>QAR <span x-text="subtotal.toFixed(2)"></span></p>
            </div>
            <div class="flex justify-between text-sm font-medium text-gray-900 mb-2 items-center">
                <p>Discount</p>
                <div class="flex items-center space-x-1">
                    <select x-model="discount_type" class="border border-gray-300 rounded text-xs p-1 focus:ring-salon-accent focus:border-salon-accent">
                        <option value="amount">QAR</option>
                        <option value="percent">%</option>
                    </select>
                    <input type="number" x-model.number="discount_value" min="0" class="w-16 border border-gray-300 rounded text-right text-xs p-1 focus:ring-salon-accent focus:border-salon-accent" placeholder="0">
                </div>
            </div>
            <div class="flex justify-between text-lg font-bold text-salon-dark border-t pt-2 mt-2">
                <p>Total</p>
                <p>QAR <span x-text="final_total.toFixed(2)"></span></p>
            </div>
        </div>
    </div>

    <!-- Right: Checkout Form -->
    <div class="lg:col-span-3 bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col h-[calc(100vh-140px)] overflow-y-auto">
        <div class="p-3 border-b border-gray-100 flex-shrink-0 bg-salon-navy text-white rounded-t-xl">
            <h3 class="text-lg font-bold text-center">Checkout</h3>
        </div>
        
        <div class="p-4">
            <!-- HTMX Form bridging Alpine data -->
            <form hx-post="/web/pos/checkout" hx-swap="none" @htmx:after-request="if($event.detail.successful){ clearCart(); onCustomerChange(); }">
                <!-- Customer Selection -->
                <div class="mb-5">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Select Customer</label>
                    <select x-model="customer_id" x-init="const ts = new TomSelect($el, { placeholder: 'Search for a customer...' }); ts.on('change', (val) => { customer_id = val; onCustomerChange(); })" class="w-full shadow-sm focus:ring-salon-accent focus:border-salon-accent block sm:text-sm border-gray-300 rounded-md py-2 px-3 border bg-white">
                        <option value="">Walk-in Customer</option>
                        {% for customer in customers %}
                            <option value="{{ customer.id }}" data-points="{{ customer.loyalty_points|default(0) }}" {% if appointment_to_checkout and appointment_to_checkout.customer_id == customer.id %}selected{% endif %}>
                                {{ customer.name }} {% if customer.phone %}({{ customer.phone }}){% endif %} - {{ customer.loyalty_points|default(0) }} pts
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Stylist Selection (Touch Friendly) -->
                <div class="mb-5">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Select Stylist (Optional)</label>
                    <div class="flex space-x-3 overflow-x-auto pb-2" style="scroll-snap-type: x mandatory;">
                        <div @click="setEmployee('')" 
                             class="flex-shrink-0 w-20 flex flex-col items-center justify-center p-2 rounded-lg cursor-pointer border-2 transition-all"
                             :class="employee_id == '' ? 'border-salon-accent bg-yellow-50' : 'border-gray-100 bg-white hover:border-gray-300'">
                             <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center mb-1 text-gray-500 border border-gray-200">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                             </div>
                             <span class="text-xs font-medium text-gray-700 text-center">None</span>
                        </div>
                        {% for employee in employees %}
                        <div @click="setEmployee('{{ employee.id }}')" 
                             class="flex-shrink-0 w-20 flex flex-col items-center justify-center p-2 rounded-lg cursor-pointer border-2 transition-all"
                             :class="employee_id == '{{ employee.id }}' ? 'border-salon-accent bg-yellow-50' : 'border-gray-100 bg-white hover:border-gray-300'">
                             {% if employee.profile_image %}
                                <img src="{{ employee.profile_image }}" class="w-10 h-10 rounded-full object-cover mb-1 border border-gray-200">
                             {% else %}
                                <div class="w-10 h-10 rounded-full bg-gray-200 text-gray-600 font-bold flex items-center justify-center mb-1 text-sm border border-gray-300">
                                    {{ employee.name|slice(0,2)|upper }}
                                </div>
                             {% endif %}
                             <span class="text-xs font-medium text-gray-700 text-center truncate w-full">{{ employee.name|split(' ')|first }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="mb-5">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Payment Method</label>
                    <div class="grid grid-cols-3 md:grid-cols-6 gap-2">
                        <button type="button" @click="setMethod('Cash')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all text-center"
                                :class="payment_method == 'Cash' ? 'border-salon-accent bg-yellow-50 text-salon-accent' : 'border-gray-200 bg-white text-gray-600 hover:border-gray-300'">
                            Cash
                        </button>
                        <button type="button" @click="setMethod('Card')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all text-center"
                                :class="payment_method == 'Card' ? 'border-salon-accent bg-yellow-50 text-salon-accent' : 'border-gray-200 bg-white text-gray-600 hover:border-gray-300'">
                            Card
                        </button>
                        <button type="button" @click="setMethod('Bank Transfer')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all text-center"
                                :class="payment_method == 'Bank Transfer' ? 'border-salon-accent bg-yellow-50 text-salon-accent' : 'border-gray-200 bg-white text-gray-600 hover:border-gray-300'">
                            Transfer
                        </button>
                        <button type="button" @click="setMethod('Points')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all text-center"
                                :class="payment_method == 'Points' ? 'border-salon-accent bg-yellow-50 text-salon-accent' : 'border-gray-200 bg-white text-gray-600 hover:border-gray-300'">
                            Points
                        </button>
                        <button type="button" @click="setMethod('Credit')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all text-center"
                                :class="payment_method == 'Credit' ? 'border-salon-accent bg-yellow-50 text-salon-accent' : 'border-gray-200 bg-white text-gray-600 hover:border-gray-300'">
                            Credit
                        </button>
                        <button type="button" @click="setMethod('Split')" 
                                class="py-2 px-1 text-sm font-medium rounded-md border-2 transition-all text-center"
                                :class="payment_method == 'Split' ? 'border-salon-accent bg-yellow-50 text-salon-accent' : 'border-gray-200 bg-white text-gray-600 hover:border-gray-300'">
                            Split
                        </button>
                    </div>
                </div>
                
                <!-- Cash Tender Amount -->
                <div x-show="payment_method === 'Cash'" class="mb-5 bg-gray-50 p-4 rounded-lg border border-gray-200" style="display: none;">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Tender Amount</label>
                    <div class="flex items-center space-x-3">
                        <div class="relative flex-1">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm font-medium">QAR</span>
                            </div>
                            <input type="number" x-model="tender_amount" step="0.01" class="!pl-14 focus:ring-salon-accent focus:border-salon-accent block w-full pr-12 sm:text-lg font-medium border-gray-300 rounded-md py-3 shadow-sm" placeholder="0.00">
                        </div>
                    </div>
                    <div class="mt-3 flex justify-between items-center text-sm" x-show="tender_amount !== '' && parseFloat(tender_amount) >= final_total">
                        <span class="text-gray-600 font-medium">Change Due:</span>
                        <span class="font-bold text-green-600 text-xl">QAR <span x-text="change_due.toFixed(2)"></span></span>
                    </div>
                    <div class="mt-3 flex justify-between items-center text-sm" x-show="tender_amount !== '' && parseFloat(tender_amount) < final_total">
                        <span class="text-red-500 font-medium flex items-center"><svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg> Insufficient funds</span>
                    </div>
                </div>

                <!-- Split Payments -->
                <div x-show="payment_method === 'Split'" class="mb-5 bg-gray-50 p-4 rounded-lg border border-gray-200" style="display: none;">
                    <label class="block text-sm font-bold text-gray-700 mb-3">Split Payments</label>
                    <template x-for="(split, index) in split_details" :key="index">
                        <div class="flex items-center space-x-2 mb-3">
                            <select x-model="split.method" class="block w-2/5 py-3 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-salon-accent sm:text-sm font-medium">
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                                <option value="Bank Transfer">Transfer</option>
                                <option value="Points">Points</option>
                                <option value="Credit">Credit</option>
                            </select>
                            <div class="relative flex-1">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <span class="text-gray-500 sm:text-sm font-medium">QAR</span>
                                </div>
                                <input type="number" x-model.number="split.amount" min="0" step="0.01"
                                    class="block w-full !pl-14 pr-2 sm:text-lg border-gray-300 rounded-md focus:ring-salon-accent focus:border-salon-accent py-3 shadow-sm" placeholder="0.00">
                            </div>
                            <button type="button" @click="removeSplit(index)" :disabled="split_details.length === 1" class="text-red-500 p-2 hover:bg-red-50 rounded-md disabled:opacity-30 border border-transparent hover:border-red-200 transition-colors">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                    </template>
                    <div class="flex justify-between items-center mt-4 pt-3 border-t border-gray-200">
                        <button type="button" @click="addSplit()" class="text-sm bg-white border border-gray-300 shadow-sm text-gray-700 px-3 py-1.5 rounded-md font-medium hover:bg-gray-50 flex items-center transition-colors">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> Add Payment
                        </button>
                        <div class="text-sm">
                            <span class="text-gray-600 mr-2">Remaining:</span>
                            <span class="font-bold text-lg" :class="split_remaining < 0.01 ? 'text-green-600' : 'text-red-500'">QAR <span x-text="split_remaining.toFixed(2)"></span></span>
                        </div>
                    </div>
                </div>
                
                <!-- Reactive hidden inputs to bridge Alpine data to HTMX -->
                <div x-show="points_error" class="mb-5 p-4 rounded-lg bg-red-50 border border-red-200" style="display: none;">
                    <p class="text-sm text-red-700 font-medium">Insufficient loyalty points or no customer selected to pay with Points.</p>
                </div>
                
                <div id="hidden-inputs-container">
                    <template x-for="(item, index) in items" :key="index">
                        <div>
                            <input type="hidden" :name="`items[${index}][id]`" :value="item.id">
                            <input type="hidden" :name="`items[${index}][type]`" :value="item.type">
                            <input type="hidden" :name="`items[${index}][name]`" :value="item.name">
                            <input type="hidden" :name="`items[${index}][price]`" :value="item.price">
                            <input type="hidden" :name="`items[${index}][quantity]`" :value="item.quantity">
                            <input type="hidden" :name="`items[${index}][service_id]`" :value="item.service_id">
                            <template x-if="item.initial_service_id">
                                <input type="hidden" :name="`items[${index}][initial_service_id]`" :value="item.initial_service_id">
                            </template>
                            <template x-if="item.initial_service_name">
                                <input type="hidden" :name="`items[${index}][initial_service_name]`" :value="item.initial_service_name">
                            </template>
                        </div>
                    </template>
                    
                    <input type="hidden" name="customer_id" :value="customer_id" x-if="customer_id">
                    <input type="hidden" name="redeem_points" :value="redeem_points" x-if="customer_id && redeem_points > 0">
                    <input type="hidden" name="employee_id" :value="employee_id">
                    <input type="hidden" name="payment_method" :value="payment_method">
                    
                    <template x-if="parseFloat(discount_value) > 0">
                        <input type="hidden" name="custom_discount" :value="discount_type === 'amount' ? discount_value : (subtotal * (discount_value / 100)).toFixed(2)">
                    </template>
                    
                    <template x-if="payment_method === 'Cash' && tender_amount !== ''">
                        <div>
                            <input type="hidden" name="tender_amount" :value="tender_amount">
                            <input type="hidden" name="change_amount" :value="change_due.toFixed(2)">
                        </div>
                    </template>
                    
                    <template x-if="payment_method === 'Split'">
                        <template x-for="(split, index) in split_details" :key="index">
                            <div>
                                <input type="hidden" :name="`split_details[${index}][method]`" :value="split.method">
                                <input type="hidden" :name="`split_details[${index}][amount]`" :value="split.amount">
                            </div>
                        </template>
                    </template>
                </div>
                {% if appointment_to_checkout %}
                    <input type="hidden" name="appointment_id" value="{{ appointment_to_checkout.id }}">
                {% endif %}
                
                <button type="submit" 
                        :disabled="items.length === 0 || (payment_method === 'Cash' && tender_amount !== '' && parseFloat(tender_amount) < final_total) || (payment_method === 'Split' && split_remaining > 0.01) || points_error" 
                        class="w-full bg-salon-accent text-white py-4 text-lg rounded-lg font-bold hover:bg-yellow-600 shadow-md transition-colors disabled:opacity-50 flex items-center justify-center">
                    Pay QAR <span x-text="final_total.toFixed(2)" class="ml-1"></span>
                    <svg class="animate-spin ml-2 h-5 w-5 text-white htmx-indicator" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </button>
            </form>
        </div>
    </div>

    <!-- Package Initial Service Modal -->
    <template x-teleport="body">
        <div x-show="show_package_modal" class="fixed inset-0 z-50 overflow-y-auto" style="display: none;">
            <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <div x-show="show_package_modal" x-transition.opacity class="fixed inset-0 transition-opacity" aria-hidden="true">
                    <div class="absolute inset-0 bg-gray-500 opacity-75" @click="closePackageModal()"></div>
                </div>
                <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
                <div x-show="show_package_modal" x-transition class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                    <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-salon-accent/10 sm:mx-0 sm:h-10 sm:w-10">
                                <svg class="h-6 w-6 text-salon-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                            </div>
                            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                                <h3 class="text-lg leading-6 font-medium text-gray-900">
                                    Select a Service for Today
                                </h3>
                                <div class="mt-2">
                                    <p class="text-sm text-gray-500 mb-4">
                                        The customer is purchasing <strong x-text="selected_package?.name"></strong>. Do they want to use one of the included services right now?
                                    </p>
                                    <div class="space-y-2 max-h-60 overflow-y-auto pr-2">
                                        <template x-for="service in selected_package?.services || []" :key="service.id">
                                            <button @click="addPackageWithInitialService(service.id, service.name)" type="button" class="w-full text-left px-4 py-3 border border-gray-200 rounded-md hover:bg-yellow-50 hover:border-salon-accent transition-colors flex justify-between items-center group">
                                                <span class="font-medium text-gray-900 group-hover:text-salon-accent" x-text="service.name"></span>
                                                <svg class="w-5 h-5 text-gray-400 group-hover:text-salon-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                            </button>
                                        </template>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse border-t border-gray-100">
                        <button @click="addPackageWithoutInitialService()" type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-gray-600 text-base font-medium text-white hover:bg-gray-700 focus:outline-none sm:ml-3 sm:w-auto sm:text-sm">
                            No, just buy package
                        </button>
                        <button @click="closePackageModal()" type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </template>
</div>
{% endblock %}

{% block scripts %}
<script>
function posSystem() {
    return {
        loyalty_currency_per_point: {{ loyalty_currency_per_point|default(0.001) }},
        items: [],
        customer_id: '{% if appointment_to_checkout %}{{ appointment_to_checkout.customer_id }}{% else %}{% endif %}',
        employee_id: '{% if appointment_to_checkout %}{{ appointment_to_checkout.user_id }}{% else %}{% endif %}',
        payment_method: 'Cash',
        tender_amount: '',
        split_details: [{method: 'Cash', amount: ''}],
        customer_points: 0,
        redeem_points: 0,
        discount_type: 'amount',
        discount_value: '',
        available_redemptions: [],
        
        getRemainingRedemptions(cps_id, total, used) {
            const inCart = this.items.find(i => i.type === 'redemption' && i.id === cps_id);
            const cartQty = inCart ? inCart.quantity : 0;
            return (total - used) - cartQty;
        },
        
        get subtotal() {
            return this.items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        },
        get final_total() {
            let t = this.subtotal;
            let d_val = parseFloat(this.discount_value) || 0;
            if (this.discount_type === 'amount') {
                t = Math.max(0, t - d_val);
            } else {
                t = Math.max(0, t - (t * (d_val / 100)));
            }
            
            const loyalty_discount = (parseFloat(this.redeem_points) || 0) * this.loyalty_currency_per_point;
            return Math.max(0, t - loyalty_discount);
        },
        get change_due() {
            if (this.payment_method !== 'Cash' || this.tender_amount === '') return 0;
            const change = parseFloat(this.tender_amount) - this.final_total;
            return change > 0 ? change : 0;
        },
        get split_total() {
            return this.split_details.reduce((sum, split) => sum + (parseFloat(split.amount) || 0), 0);
        },
        get split_remaining() {
            const rem = this.subtotal - this.split_total;
            return rem > 0 ? rem : 0;
        },
        get points_error() {
            let ptsAmt = 0;
            if (this.payment_method === 'Points') {
                ptsAmt = this.final_total;
            } else if (this.payment_method === 'Split') {
                for (let s of this.split_details) {
                    if (s.method === 'Points') ptsAmt += (parseFloat(s.amount) || 0);
                }
            }
            if (ptsAmt > 0) {
                if (!this.customer_id) return true;
                const needed = Math.ceil(ptsAmt / this.loyalty_currency_per_point);
                const redeem = parseInt(this.redeem_points) || 0;
                if (this.customer_points < (needed + redeem)) return true;
            }
            return false;
        },
        addSplit() {
            this.split_details.push({method: 'Card', amount: this.split_remaining > 0 ? this.split_remaining.toFixed(2) : ''});
        },
        removeSplit(index) {
            this.split_details.splice(index, 1);
        },
        setMethod(method) {
            this.payment_method = method;
            if (method === 'Split' && this.split_details.length === 1 && !this.split_details[0].amount) {
                this.split_details[0].amount = this.final_total.toFixed(2);
            }
        },
        setEmployee(id) {
            this.employee_id = id;
        },
        async onCustomerChange() {
            this.redeem_points = 0;
            if (this.customer_id) {
                const select = this.$el.querySelector('select[x-model="customer_id"]') || document.querySelector('select[x-model="customer_id"]');
                const option = select ? Array.from(select.options).find(opt => opt.value == this.customer_id) : null;
                this.customer_points = option ? parseInt(option.dataset.points || 0) : 0;
                
                try {
                    const res = await fetch(`/web/api/customers/${this.customer_id}/available-redemptions`);
                    if (res.ok) {
                        const data = await res.json();
                        if (data && data.success) {
                            this.available_redemptions = data.packages || [];
                        }
                    }
                } catch (e) {
                    console.error('Failed to fetch available redemptions', e);
                }
            } else {
                this.customer_points = 0;
            }
        },
        addItem(id, type, name, price, service_id = null, initial_service_id = null, initial_service_name = null) {
            const existing = this.items.find(i => i.id === id && i.type === type && i.name === name && i.initial_service_id === initial_service_id);
            if (existing) {
                existing.quantity++;
            } else {
                this.items.push({ id, type, name, price, quantity: 1, service_id, initial_service_id, initial_service_name });
            }
        },
        removeItem(index) {
            this.items.splice(index, 1);
        },
        clearCart() {
            this.items = [];
            this.tender_amount = '';
            this.split_details = [{method: 'Cash', amount: ''}];
            this.redeem_points = 0;
            this.discount_value = '';
        },
        // Immediate Package Redemption
        selected_package: null,
        show_package_modal: false,
        selectPackage(pkg) {
            this.selected_package = pkg;
            if (pkg.services && pkg.services.length > 0) {
                this.show_package_modal = true;
            } else {
                this.addItem(pkg.id, 'package', pkg.name, pkg.price);
            }
        },
        closePackageModal() {
            this.show_package_modal = false;
            this.selected_package = null;
        },
        addPackageWithInitialService(serviceId, serviceName) {
            if (this.selected_package) {
                this.addItem(
                    this.selected_package.id, 
                    'package', 
                    this.selected_package.name, 
                    this.selected_package.price, 
                    null, 
                    serviceId, 
                    serviceName
                );
            }
            this.closePackageModal();
        },
        addPackageWithoutInitialService() {
            if (this.selected_package) {
                this.addItem(this.selected_package.id, 'package', this.selected_package.name, this.selected_package.price);
            }
            this.closePackageModal();
        }
    }
}
</script>

</script>
{% endblock %}
