{% extends "layout.twig" %}

{% block content %}
<div class="max-w-4xl mx-auto">
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Your Profile</h2>
        <p class="text-sm text-slate-500 mt-1">Manage your personal information and security.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden flex">
        <div class="p-8 w-1/3 bg-slate-50 border-r border-slate-100 text-center flex flex-col items-center justify-center">
            <div class="w-24 h-24 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-3xl shadow-md uppercase mb-4">
                {{ auth_user.name|slice(0, 1)|default('U') }}
            </div>
            <h3 class="text-lg font-bold text-slate-900">{{ auth_user.name|default('User') }}</h3>
            <p class="text-sm text-indigo-600 font-medium capitalize mt-1">{{ auth_user.role|default('Stylist') }}</p>
        </div>
        
        <div class="p-8 w-2/3">
            <h4 class="text-md font-medium text-slate-900 mb-4 border-b border-slate-100 pb-2">Profile Details</h4>
            
            <form class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700">Full Name</label>
                    <input type="text" value="{{ auth_user.name }}" class="mt-1 w-full px-3 py-2 border border-slate-200 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700">Role</label>
                    <input type="text" value="{{ auth_user.role|capitalize }}" disabled class="mt-1 w-full px-3 py-2 border border-slate-200 bg-slate-50 text-slate-500 rounded-md sm:text-sm">
                    <p class="text-xs text-slate-400 mt-1">Roles can only be changed by an Administrator.</p>
                </div>

                <div class="pt-4 mt-6 border-t border-slate-100">
                    <button type="button" class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors">
                        Update Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
