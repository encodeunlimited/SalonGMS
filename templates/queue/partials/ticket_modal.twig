<div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeTicketModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full border border-slate-100">
            <!-- Modal Header -->
            <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 px-6 py-5 text-white text-center relative">
                <button type="button" onclick="closeTicketModal()" class="absolute top-4 right-4 text-white/80 hover:text-white transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
                <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-2 backdrop-blur-sm">
                    <i data-lucide="check" class="w-6 h-6 text-white stroke-[3]"></i>
                </div>
                <h3 class="text-lg font-bold">Ticket Issued Successfully!</h3>
                <p class="text-xs text-indigo-100 mt-0.5">Customer is now in the waiting queue</p>
            </div>

            <!-- Ticket Card Preview -->
            <div class="p-6">
                <div class="bg-slate-50 border-2 border-dashed border-indigo-200 rounded-xl p-5 text-center relative overflow-hidden">
                    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Ticket Number</div>
                    <div class="text-5xl font-black text-indigo-700 font-mono tracking-tight my-2">
                        {{ ticket.ticket_number }}
                    </div>

                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800 mb-4">
                        <i data-lucide="user-check" class="w-3.5 h-3.5"></i>
                        Barber: {{ ticket.barber_name }}
                    </div>

                    <div class="grid grid-cols-2 gap-3 text-left border-t border-slate-200 pt-3 text-xs">
                        <div>
                            <span class="text-slate-500 block">Customer</span>
                            <span class="font-bold text-slate-800 text-sm truncate block">{{ ticket.customer_name }}</span>
                            {% if ticket.customer_phone %}
                            <span class="text-[11px] text-slate-500">{{ ticket.customer_phone }}</span>
                            {% endif %}
                        </div>
                        <div>
                            <span class="text-slate-500 block">Service</span>
                            <span class="font-semibold text-slate-800 block truncate">{{ ticket.service_name|default('Standard Haircut') }}</span>
                            {% if ticket.estimated_wait_time > 0 %}
                            <span class="text-indigo-600 font-medium text-[11px]">~{{ ticket.estimated_wait_time }} mins wait</span>
                            {% else %}
                            <span class="text-emerald-600 font-medium text-[11px]">Next in line!</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex flex-col sm:flex-row gap-2">
                    <button type="button" 
                            onclick="printTicketSlip({{ ticket.id }})" 
                            class="flex-1 inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold text-sm hover:bg-indigo-700 shadow-sm transition">
                        <i data-lucide="printer" class="w-4 h-4"></i>
                        Print Slip
                    </button>
                    <button type="button" 
                            onclick="closeTicketModal()" 
                            class="px-4 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold text-sm hover:bg-slate-200 transition">
                        Done
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
