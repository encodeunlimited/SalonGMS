{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Reports & Analytics</h2>
        <p class="text-sm text-gray-500 mt-1">Key metrics and insights for your salon.</p>
    </div>
    
    <div class="bg-white p-1.5 rounded-lg shadow-sm border border-gray-200 inline-flex items-center">
        <form hx-get="/web/reports" hx-target="#reports-content" hx-indicator=".loading-overlay" class="flex items-center space-x-2">
            <input type="hidden" name="partial" value="true">
            <div class="flex items-center px-2">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider mr-2">From</span>
                <input type="date" name="start_date" value="{{ start_date }}" class="text-sm border-none bg-transparent p-0 focus:ring-0 text-gray-900 font-medium cursor-pointer w-32">
            </div>
            <div class="w-px h-6 bg-gray-200"></div>
            <div class="flex items-center px-2">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider mr-2">To</span>
                <input type="date" name="end_date" value="{{ end_date }}" class="text-sm border-none bg-transparent p-0 focus:ring-0 text-gray-900 font-medium cursor-pointer w-32">
            </div>
            <button type="submit" class="bg-salon-dark text-white rounded-md px-3 py-1.5 text-sm font-medium hover:bg-salon-navy transition-colors">
                Apply
            </button>
        </form>
    </div>
</div>

<div class="relative min-h-[500px]">
    <!-- Loading Overlay -->
    <div class="loading-overlay absolute inset-0 bg-white/50 backdrop-blur-[2px] z-10 flex items-center justify-center rounded-xl" style="display:none;">
        <div class="bg-white p-4 rounded-lg shadow-lg flex items-center space-x-3">
            <svg class="animate-spin h-6 w-6 text-salon-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            <span class="font-medium text-gray-700">Loading data...</span>
        </div>
    </div>

    <!-- Reports Content -->
    <div id="reports-content">
        {% include 'reports/partials/dashboard_data.twig' %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Global chart instances to destroy before re-rendering
    window.chartInstances = {};

    function renderCharts(dataStr) {
        try {
            const data = JSON.parse(dataStr);
            
            // Clean up old charts
            Object.values(window.chartInstances).forEach(chart => {
                if(chart) chart.destroy();
            });
            window.chartInstances = {};

            // 1. Revenue Over Time (Area Chart)
            if (document.querySelector("#revenueChart") && data.revenue_over_time.length > 0) {
                const dates = data.revenue_over_time.map(item => item.date);
                const revenues = data.revenue_over_time.map(item => parseFloat(item.revenue));
                
                var revenueOptions = {
                    series: [{ name: 'Revenue', data: revenues }],
                    chart: { type: 'area', height: 320, fontFamily: 'Inter, sans-serif', toolbar: { show: false } },
                    colors: ['#d4af37'],
                    fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.05, stops: [0, 90, 100] } },
                    dataLabels: { enabled: false },
                    stroke: { curve: 'smooth', width: 2 },
                    xaxis: { categories: dates, type: 'datetime' },
                    yaxis: { labels: { formatter: function (value) { return "QAR " + value.toFixed(0); } } },
                    tooltip: { x: { format: 'dd MMM yyyy' } }
                };
                window.chartInstances['revenue'] = new ApexCharts(document.querySelector("#revenueChart"), revenueOptions);
                window.chartInstances['revenue'].render();
            }

            // 2. Revenue By Payment Method (Donut Chart)
            if (document.querySelector("#paymentMethodChart") && data.revenue_by_payment_method.length > 0) {
                const methods = data.revenue_by_payment_method.map(item => item.payment_method || 'Unknown');
                const methodRevenues = data.revenue_by_payment_method.map(item => parseFloat(item.revenue));
                
                var methodOptions = {
                    series: methodRevenues,
                    labels: methods,
                    chart: { type: 'donut', height: 300, fontFamily: 'Inter, sans-serif' },
                    colors: ['#1e293b', '#d4af37', '#64748b', '#cbd5e1'],
                    dataLabels: { enabled: false },
                    plotOptions: { pie: { donut: { size: '70%', labels: { show: true, total: { show: true, label: 'Total', formatter: function (w) { return "QAR " + w.globals.seriesTotals.reduce((a, b) => a + b, 0).toFixed(0) } } } } } },
                    legend: { position: 'bottom' }
                };
                window.chartInstances['payment'] = new ApexCharts(document.querySelector("#paymentMethodChart"), methodOptions);
                window.chartInstances['payment'].render();
            }

            // 3. Appointments Summary (Pie Chart)
            if (document.querySelector("#appointmentsChart") && data.appointments_summary.length > 0) {
                const statuses = data.appointments_summary.map(item => item.status);
                const counts = data.appointments_summary.map(item => parseInt(item.count));
                
                var aptOptions = {
                    series: counts,
                    labels: statuses.map(s => s.charAt(0).toUpperCase() + s.slice(1)),
                    chart: { type: 'pie', height: 300, fontFamily: 'Inter, sans-serif' },
                    colors: ['#10b981', '#f59e0b', '#ef4444', '#6b7280'], // Green(paid), Yellow(pending), Red(cancelled), Gray(no-show) depending on status order. Better to map colors.
                    dataLabels: { enabled: true, formatter: function (val, opts) { return opts.w.config.series[opts.seriesIndex] } },
                    legend: { position: 'bottom' }
                };
                window.chartInstances['appointments'] = new ApexCharts(document.querySelector("#appointmentsChart"), aptOptions);
                window.chartInstances['appointments'].render();
            }

            // 4. Stylist Performance (Horizontal Bar Chart)
            if (document.querySelector("#stylistPerformanceChart") && data.stylist_performance.length > 0) {
                const stylists = data.stylist_performance.map(item => item.name);
                const revenues = data.stylist_performance.map(item => parseFloat(item.total_revenue || 0));
                
                var stylistOptions = {
                    series: [{ name: 'Revenue', data: revenues }],
                    chart: { type: 'bar', height: 300, fontFamily: 'Inter, sans-serif', toolbar: { show: false } },
                    colors: ['#d4af37'],
                    plotOptions: { bar: { horizontal: true, borderRadius: 4 } },
                    dataLabels: { enabled: false },
                    xaxis: { categories: stylists, labels: { formatter: function (value) { return "QAR " + value; } } }
                };
                window.chartInstances['stylistPerf'] = new ApexCharts(document.querySelector("#stylistPerformanceChart"), stylistOptions);
                window.chartInstances['stylistPerf'].render();
            }

            // 5. Top Services (Bar Chart)
            if (document.querySelector("#topServicesChart") && data.top_services.length > 0) {
                const services = data.top_services.map(item => item.service_name);
                const revenues = data.top_services.map(item => parseFloat(item.revenue || 0));
                
                var topServicesOptions = {
                    series: [{ name: 'Revenue', data: revenues }],
                    chart: { type: 'bar', height: 300, fontFamily: 'Inter, sans-serif', toolbar: { show: false } },
                    colors: ['#0f172a'],
                    plotOptions: { bar: { borderRadius: 4, columnWidth: '40%' } },
                    dataLabels: { enabled: false },
                    xaxis: { categories: services },
                    yaxis: { labels: { formatter: function (value) { return "QAR " + value; } } }
                };
                window.chartInstances['topServices'] = new ApexCharts(document.querySelector("#topServicesChart"), topServicesOptions);
                window.chartInstances['topServices'].render();
            }

        } catch (e) {
            console.error("Error rendering charts", e);
        }
    }
</script>
{% endblock %}
