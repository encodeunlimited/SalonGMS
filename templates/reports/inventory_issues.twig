{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Inventory Issues Report</h2>
        <p class="text-sm text-gray-500 mt-1">Review products issued from inventory over a specific period.</p>
    </div>
    <div class="flex items-center space-x-3">
        <button class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 shadow-sm transition-colors flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Export PDF
        </button>
        <button class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 shadow-sm transition-colors flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Export CSV
        </button>
    </div>
</div>

<!-- Filters -->
<div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 mb-8 flex flex-wrap gap-4 items-end">
    <form class="flex flex-wrap gap-4 items-end" 
          hx-get="/web/reports/inventory-issues" 
          hx-target="#report-data" 
          hx-swap="innerHTML"
          hx-indicator="#loading">
        <input type="hidden" name="partial" value="1">
        
        <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Start Date</label>
            <input type="date" name="start_date" value="{{ start_date }}" class="block w-full py-2 px-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm text-gray-900 bg-white">
        </div>
        
        <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">End Date</label>
            <input type="date" name="end_date" value="{{ end_date }}" class="block w-full py-2 px-3 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-salon-accent focus:border-salon-accent sm:text-sm text-gray-900 bg-white">
        </div>

        <button type="submit" class="bg-salon-dark text-white px-5 py-2 rounded-md shadow-sm text-sm font-medium hover:bg-salon-navy transition-colors h-[38px] flex items-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
            Filter
        </button>

        <div id="loading" class="htmx-indicator flex items-center text-salon-navy ml-4">
            <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-salon-navy" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="text-sm font-medium">Loading...</span>
        </div>
    </form>
</div>

<div id="report-data">
    {% include 'reports/partials/inventory_issues_data.twig' %}
</div>

{% endblock %}
