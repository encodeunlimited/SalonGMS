<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 mb-8 text-center max-w-2xl mx-auto">
    <h3 class="text-xl font-bold text-gray-900 mb-2">End of Day Balance: {{ target_date }}</h3>
    <p class="text-gray-500 mb-6">Summary of all transactions and appointments for the selected date.</p>
    
    {% set cash_total = 0 %}
    {% set card_total = 0 %}
    {% for pay in revenue_by_payment_method %}
        {% if pay.payment_method|lower == 'cash' or pay.payment_method == '' %}
            {% set cash_total = cash_total + pay.revenue %}
        {% elseif pay.payment_method|lower == 'card' %}
            {% set card_total = card_total + pay.revenue %}
        {% endif %}
    {% endfor %}

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        <div class="bg-gray-50 p-4 rounded-lg text-left">
            <span class="text-xs font-semibold text-gray-500 uppercase">Cash Collected</span>
            <p class="text-2xl font-bold text-green-600 mt-1">QAR {{ cash_total|number_format(0) }}</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg text-left">
            <span class="text-xs font-semibold text-gray-500 uppercase">Card / Other</span>
            <p class="text-2xl font-bold text-blue-600 mt-1">QAR {{ (total_revenue - cash_total)|number_format(0) }}</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg text-left">
            <span class="text-xs font-semibold text-gray-500 uppercase">Expenses</span>
            <p class="text-2xl font-bold text-red-600 mt-1">QAR {{ total_expenses|number_format(0) }}</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg text-left">
            <span class="text-xs font-semibold text-gray-500 uppercase">Commissions</span>
            <p class="text-2xl font-bold text-purple-600 mt-1">QAR {{ total_commissions|number_format(0) }}</p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg text-left">
            <span class="text-xs font-semibold text-gray-500 uppercase">Net Profit</span>
            {% set eod_net = total_revenue - total_expenses - total_commissions %}
            <p class="text-2xl font-bold {% if eod_net >= 0 %}text-green-600{% else %}text-red-600{% endif %} mt-1">QAR {{ eod_net|number_format(0) }}</p>
        </div>
    </div>
    
    <div class="mt-6 pt-6 border-t border-gray-100 text-left">
        <h4 class="text-sm font-bold text-gray-900 mb-3">Expected Cash in Drawer:</h4>
        <div class="flex justify-between items-center bg-green-50 p-4 rounded-lg">
            <span class="text-gray-700 font-medium">Cash Collected - Expenses</span>
            <span class="text-xl font-bold text-green-700">QAR {{ (cash_total - total_expenses)|number_format(0) }}</span>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex flex-col">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Payment Breakdown</h3>
        <div id="paymentMethodChart" class="flex-1 flex items-center justify-center"></div>
    </div>
    
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex flex-col">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Appointments Breakdown</h3>
        <div id="appointmentsChart" class="flex-1 flex items-center justify-center"></div>
    </div>
</div>

<script type="application/json" id="reportsDataJSON">
{{ {
    revenue_by_payment_method: revenue_by_payment_method,
    appointments_summary: appointments_summary
}|json_encode|raw }}
</script>

<script>
    if (typeof renderCharts === 'function') {
        renderCharts(document.getElementById('reportsDataJSON').innerHTML);
    }
</script>
