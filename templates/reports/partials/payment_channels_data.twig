{% set total_revenue = 0 %}
{% for pay in revenue_by_payment_method %}
    {% set total_revenue = total_revenue + pay.revenue %}
{% endfor %}

<!-- Top KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex items-center">
        <div class="rounded-full bg-blue-50 p-3 mr-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <p class="text-xs font-medium text-gray-500">Total Revenue (All Channels)</p>
            <p class="text-xl font-bold text-gray-900 mt-1">QAR {{ total_revenue|number_format(0) }}</p>
        </div>
    </div>
</div>

<!-- Table Data -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
    <div class="p-5 border-b border-gray-100 bg-gray-50">
        <h3 class="text-lg font-bold text-gray-900">Revenue Breakdown by Channel</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-white">
                <tr>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Payment Channel</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Revenue</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">% of Total</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
                {% for pay in revenue_by_payment_method %}
                <tr class="hover:bg-gray-50">
                    <td class="px-5 py-3 text-sm font-medium text-gray-900 capitalize">{{ pay.payment_method ?: 'Cash' }}</td>
                    <td class="px-5 py-3 text-sm font-semibold text-gray-900 text-right">QAR {{ pay.revenue|number_format(0) }}</td>
                    <td class="px-5 py-3 text-sm text-gray-500 text-right">
                        {% if total_revenue > 0 %}
                            {{ ((pay.revenue / total_revenue) * 100)|number_format(1) }}%
                        {% else %}
                            0%
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="3" class="px-5 py-6 text-center text-gray-500 text-sm">No data available</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script type="application/json" id="reportsDataJSON">
{{ {
    revenue_by_payment_method: revenue_by_payment_method
}|json_encode|raw }}
</script>

<script>
(function() {
    function renderPaymentChart() {
        var dataEl = document.getElementById('reportsDataJSON');
        if (!dataEl) return;
        var data;
        try { data = JSON.parse(dataEl.innerHTML); } catch(e) { return; }

        if (window.chartInstances) {
            Object.values(window.chartInstances).forEach(function(c) { if(c) c.destroy(); });
        }
        window.chartInstances = {};

        if (document.querySelector('#paymentMethodChart') && data.revenue_by_payment_method && data.revenue_by_payment_method.length > 0) {
            var methods = data.revenue_by_payment_method.map(function(i) { return i.payment_method || 'Unknown'; });
            var revenues = data.revenue_by_payment_method.map(function(i) { return parseFloat(i.revenue); });
            window.chartInstances['payment'] = new ApexCharts(document.querySelector('#paymentMethodChart'), {
                series: revenues,
                labels: methods,
                chart: { type: 'donut', height: 320, fontFamily: 'Inter, sans-serif' },
                colors: ['#1e293b', '#d4af37', '#64748b', '#cbd5e1', '#e2e8f0'],
                dataLabels: { enabled: false },
                plotOptions: { pie: { donut: { size: '70%', labels: { show: true, total: { show: true, label: 'Total', formatter: function(w) { return 'QAR ' + w.globals.seriesTotals.reduce(function(a,b){return a+b;},0).toFixed(0); } } } } } },
                legend: { position: 'bottom' }
            });
            window.chartInstances['payment'].render();
        } else if (document.querySelector('#paymentMethodChart')) {
            document.querySelector('#paymentMethodChart').innerHTML = '<p class="text-sm text-gray-400 text-center py-8">No payment data for this period.</p>';
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderPaymentChart);
    } else {
        renderPaymentChart();
    }

    document.addEventListener('htmx:afterSwap', function(e) {
        if (e.target && e.target.id === 'reports-content') renderPaymentChart();
    });
})();
</script>
