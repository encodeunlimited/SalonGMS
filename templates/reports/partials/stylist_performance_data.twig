<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex flex-col">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Revenue by Stylist</h3>
        <div id="stylistPerformanceChart" class="flex-1"></div>
    </div>
    
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex flex-col">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Appointments Breakdown</h3>
        <div id="appointmentsChart" class="flex-1 flex items-center justify-center"></div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
    <div class="p-5 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
        <h3 class="text-lg font-bold text-gray-900">Stylist Detailed Breakdown</h3>
        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ stylist_performance|length }} Stylists Active</span>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-white">
                <tr>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Stylist</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Appointments Handled</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Revenue Generated</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Estimated Commission</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
                {% for perf in stylist_performance %}
                <tr class="hover:bg-gray-50">
                    <td class="px-5 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ perf.name }}</td>
                    <td class="px-5 py-4 whitespace-nowrap text-sm text-gray-500 text-right">{{ perf.total_appointments }}</td>
                    <td class="px-5 py-4 whitespace-nowrap text-sm font-semibold text-salon-accent text-right">QAR {{ perf.total_revenue|default(0)|number_format(0) }}</td>
                    <td class="px-5 py-4 whitespace-nowrap text-sm text-green-600 font-medium text-right">QAR {{ perf.total_commission|number_format(0) }}</td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="px-5 py-8 text-center text-gray-500 text-sm">No performance data available for this period.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script type="application/json" id="reportsDataJSON">
{{ {
    stylist_performance: stylist_performance,
    appointments_summary: appointments_summary
}|json_encode|raw }}
</script>

<script>
    if (typeof renderCharts === 'function') {
        renderCharts(document.getElementById('reportsDataJSON').innerHTML);
    }
</script>
