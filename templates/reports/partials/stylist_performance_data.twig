<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex flex-col">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Revenue by Stylist</h3>
        <div id="stylistPerformanceChart" class="flex-1"></div>
    </div>
    
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex flex-col">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Appointments Breakdown</h3>
        <div id="appointmentsChart" class="flex-1 flex items-center justify-center"></div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
    <div class="p-5 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
        <h3 class="text-lg font-bold text-gray-900">Stylist Detailed Breakdown</h3>
        <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">{{ stylist_performance|length }} Stylists Active</span>
    </div>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-white">
                <tr>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Stylist</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Appointments Handled</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Revenue Generated</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Estimated Commission</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
                {% for perf in stylist_performance %}
                <tr class="hover:bg-gray-50">
                    <td class="px-5 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ perf.name }}</td>
                    <td class="px-5 py-4 whitespace-nowrap text-sm text-gray-500 text-right">{{ perf.total_appointments }}</td>
                    <td class="px-5 py-4 whitespace-nowrap text-sm font-semibold text-salon-accent text-right">QAR {{ perf.total_revenue|default(0)|number_format(0) }}</td>
                    <td class="px-5 py-4 whitespace-nowrap text-sm text-green-600 font-medium text-right">QAR {{ perf.total_commission|number_format(0) }}</td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="px-5 py-8 text-center text-gray-500 text-sm">No performance data available for this period.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script type="application/json" id="reportsDataJSON">
{{ {
    stylist_performance: stylist_performance,
    appointments_summary: appointments_summary
}|json_encode|raw }}
</script>

<script>
(function() {
    function renderStylistCharts() {
        var dataEl = document.getElementById('reportsDataJSON');
        if (!dataEl) return;
        var data;
        try { data = JSON.parse(dataEl.innerHTML); } catch(e) { console.error('Stylist chart parse error', e); return; }

        if (window.chartInstances) {
            Object.values(window.chartInstances).forEach(function(c) { if(c) c.destroy(); });
        }
        window.chartInstances = {};

        // Stylist Performance Bar Chart
        if (document.querySelector('#stylistPerformanceChart') && data.stylist_performance && data.stylist_performance.length > 0) {
            var stylists = data.stylist_performance.map(function(i) { return i.name; });
            var revenues = data.stylist_performance.map(function(i) { return parseFloat(i.total_revenue || 0); });
            window.chartInstances['stylistPerf'] = new ApexCharts(document.querySelector('#stylistPerformanceChart'), {
                series: [{ name: 'Revenue', data: revenues }],
                chart: { type: 'bar', height: 300, fontFamily: 'Inter, sans-serif', toolbar: { show: false } },
                colors: ['#d4af37'],
                plotOptions: { bar: { horizontal: true, borderRadius: 4 } },
                dataLabels: { enabled: false },
                xaxis: { categories: stylists, labels: { formatter: function(v) { return 'QAR ' + v; } } }
            });
            window.chartInstances['stylistPerf'].render();
        } else if (document.querySelector('#stylistPerformanceChart')) {
            document.querySelector('#stylistPerformanceChart').innerHTML = '<p class="text-sm text-gray-400 text-center py-8">No stylist data for this period.</p>';
        }

        // Appointments Breakdown Pie
        if (document.querySelector('#appointmentsChart') && data.appointments_summary && data.appointments_summary.length > 0) {
            var statuses = data.appointments_summary.map(function(i) { return i.status.charAt(0).toUpperCase() + i.status.slice(1); });
            var counts = data.appointments_summary.map(function(i) { return parseInt(i.count); });
            window.chartInstances['appointments'] = new ApexCharts(document.querySelector('#appointmentsChart'), {
                series: counts,
                labels: statuses,
                chart: { type: 'pie', height: 300, fontFamily: 'Inter, sans-serif' },
                colors: ['#10b981', '#f59e0b', '#ef4444', '#6b7280', '#3b82f6', '#8b5cf6'],
                dataLabels: { enabled: true, formatter: function(val, opts) { return opts.w.config.series[opts.seriesIndex]; } },
                legend: { position: 'bottom' }
            });
            window.chartInstances['appointments'].render();
        } else if (document.querySelector('#appointmentsChart')) {
            document.querySelector('#appointmentsChart').innerHTML = '<p class="text-sm text-gray-400 text-center py-8">No appointment data for this period.</p>';
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderStylistCharts);
    } else {
        renderStylistCharts();
    }

    document.addEventListener('htmx:afterSwap', function(e) {
        if (e.target && e.target.id === 'reports-content') {
            renderStylistCharts();
        }
    });
})();
</script>
