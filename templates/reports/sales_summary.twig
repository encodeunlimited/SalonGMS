{% extends "layout.twig" %}

{% block content %}
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Sales Summary</h2>
        <p class="text-sm text-slate-500 mt-1">Detailed breakdown of your salon's financial performance.</p>
    </div>
    
    <div class="bg-white p-1.5 rounded-lg shadow-sm border border-slate-200 inline-flex items-center">
        <form hx-get="/web/reports/sales" hx-target="#reports-content" hx-indicator=".loading-overlay" class="flex items-center space-x-2">
            <input type="hidden" name="partial" value="true">
            <div class="flex items-center px-2">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-2">From</span>
                <input type="date" name="start_date" value="{{ start_date }}" class="text-sm border-none bg-transparent p-0 focus:ring-0 text-slate-900 font-medium cursor-pointer w-32">
            </div>
            <div class="w-px h-6 bg-gray-200"></div>
            <div class="flex items-center px-2">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-2">To</span>
                <input type="date" name="end_date" value="{{ end_date }}" class="text-sm border-none bg-transparent p-0 focus:ring-0 text-slate-900 font-medium cursor-pointer w-32">
            </div>
            <button type="submit" class="bg-indigo-600 text-white rounded-md px-3 py-1.5 text-sm font-medium hover:bg-indigo-700 transition-colors">
                Apply
            </button>
        </form>
    </div>
</div>

<div class="relative min-h-[500px]">
    <!-- Loading Overlay -->
    <div class="loading-overlay absolute inset-0 bg-white/50 backdrop-blur-[2px] z-10 flex items-center justify-center rounded-xl" style="display:none;">
        <div class="bg-white p-4 rounded-lg shadow-lg flex items-center space-x-3">
            <svg class="animate-spin h-6 w-6 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            <span class="font-medium text-slate-700">Loading data...</span>
        </div>
    </div>

    <!-- Reports Content -->
    <div id="reports-content">
        {% include 'reports/partials/sales_summary_data.twig' %}
    </div>
</div>
{% endblock %}

{% block scripts %}
    {% include 'reports/partials/charts_script.twig' %}
{% endblock %}
