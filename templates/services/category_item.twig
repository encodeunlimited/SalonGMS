<tr id="category-item-{{ cat.id }}" class="border-b border-slate-100 hover:bg-slate-50/60 transition-colors" x-data="{ editing: false, name: '{{ cat.name|e('js') }}', arabic_name: '{{ cat.arabic_name|default('')|e('js') }}' }">
    <!-- View Mode -->
    <template x-if="!editing">
        <td class="py-3 px-4" colspan="3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xs">
                        <i data-lucide="tag" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-semibold text-slate-900">{{ cat.name }}</span>
                            {% if cat.arabic_name %}
                            <span class="text-xs text-slate-500 font-normal px-2 py-0.5 rounded bg-slate-100" dir="rtl">{{ cat.arabic_name }}</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
                        {{ cat.services_count|default(0) }} services
                    </span>

                    <div class="flex items-center gap-1">
                        <button type="button" 
                                @click="editing = true" 
                                class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" 
                                title="Edit Category">
                            <i data-lucide="pencil" class="w-4 h-4"></i>
                        </button>
                        <button type="button" 
                                hx-delete="/web/services/categories/{{ cat.id }}" 
                                hx-target="#category-item-{{ cat.id }}" 
                                hx-swap="outerHTML" 
                                hx-confirm="Are you sure you want to delete category '{{ cat.name|e('js') }}'?" 
                                class="p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors" 
                                title="Delete Category">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </td>
    </template>

    <!-- Edit Mode -->
    <template x-if="editing">
        <td class="py-3 px-4 bg-indigo-50/40" colspan="3">
            <form hx-put="/web/services/categories/{{ cat.id }}" 
                  hx-target="#category-item-{{ cat.id }}" 
                  hx-swap="outerHTML" 
                  class="flex items-center gap-2 flex-wrap sm:flex-nowrap">
                <input type="text" 
                       name="name" 
                       x-model="name" 
                       required 
                       placeholder="Category Name" 
                       class="flex-1 px-3 py-1.5 border border-indigo-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                <input type="text" 
                       name="arabic_name" 
                       x-model="arabic_name" 
                       placeholder="Arabic Name (Optional)" 
                       class="flex-1 px-3 py-1.5 border border-indigo-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" dir="rtl">
                <div class="flex items-center gap-1.5">
                    <button type="submit" 
                            class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-700 transition">
                        Save
                    </button>
                    <button type="button" 
                            @click="editing = false; name = '{{ cat.name|e('js') }}'; arabic_name = '{{ cat.arabic_name|default('')|e('js') }}'" 
                            class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-semibold hover:bg-slate-50 transition">
                        Cancel
                    </button>
                </div>
            </form>
        </td>
    </template>
</tr>
