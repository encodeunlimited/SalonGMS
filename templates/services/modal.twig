<div x-data="{ open: true }" 
     x-show="open" 
     class="fixed inset-0 z-50 overflow-y-auto" 
     aria-labelledby="modal-title" 
     role="dialog" 
     aria-modal="true">
    
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <!-- Background overlay -->
        <div x-show="open" 
             x-transition:enter="ease-out duration-300" 
             x-transition:enter-start="opacity-0" 
             x-transition:enter-end="opacity-100" 
             x-transition:leave="ease-in duration-200" 
             x-transition:leave-start="opacity-100" 
             x-transition:leave-end="opacity-0" 
             class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" 
             @click="open = false; setTimeout(() => $dispatch('close-modal'), 300)"
             aria-hidden="true"></div>

        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

        <!-- Modal panel -->
        <div x-show="open" 
             x-transition:enter="ease-out duration-300" 
             x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
             x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
             x-transition:leave="ease-in duration-200" 
             x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" 
             x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
             class="inline-block align-bottom bg-white rounded-xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">
            
            <form hx-post="{% if service.id %}/web/services/{{ service.id }}/edit{% else %}/web/services/create{% endif %}" hx-swap="none" hx-encoding="multipart/form-data" enctype="multipart/form-data">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-salon-light sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-salon-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">{% if service.id %}Edit Service{% else %}Add New Service{% endif %}</h3>
                            
                            <div class="mt-4 space-y-4">
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Service Name</label>
                                        <input type="text" name="name" value="{{ service.name }}" required class="mt-1 w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                    </div>
                                    <div x-data="{ 
                                        open: false, 
                                        search: '{{ service.category|escape('js') }}', 
                                        options: [
                                            {% for cat in categories %}
                                                '{{ cat.name|escape('js') }}'{% if not loop.last %},{% endif %}
                                            {% endfor %}
                                        ],
                                        get filteredOptions() {
                                            if (this.search === '') return this.options;
                                            return this.options.filter(i => i.toLowerCase().includes(this.search.toLowerCase()));
                                        },
                                        selectOption(option) {
                                            this.search = option;
                                            this.open = false;
                                        }
                                    }" class="relative">
                                        <label class="block text-sm font-medium text-gray-700">Category</label>
                                        <div class="relative mt-1">
                                            <input type="text" name="category" x-model="search" @focus="open = true" @click.away="open = false" autocomplete="off" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm" placeholder="e.g. Hair, Massage">
                                            <div class="absolute inset-y-0 right-0 flex items-center px-2 pointer-events-none">
                                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                            </div>
                                        </div>
                                        <div x-show="open && filteredOptions.length > 0" 
                                             class="absolute z-10 w-full mt-1 bg-white rounded-md shadow-lg max-h-60 overflow-auto border border-gray-200" 
                                             style="display: none;">
                                            <ul class="py-1 text-sm text-gray-700">
                                                <template x-for="option in filteredOptions" :key="option">
                                                    <li @click="selectOption(option)" class="cursor-pointer px-4 py-2 hover:bg-salon-light hover:text-salon-accent transition-colors" x-text="option"></li>
                                                </template>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Description</label>
                                    <textarea name="description" rows="2" class="mt-1 w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">{{ service.description }}</textarea>
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Duration (mins)</label>
                                        <input type="number" name="duration_minutes" value="{{ service.duration_minutes|default('30') }}" required class="mt-1 w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700">Price ($)</label>
                                        <input type="number" step="0.01" name="price" value="{{ service.price }}" required class="mt-1 w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700">Service Images</label>
                                    <input type="file" name="images[]" multiple accept="image/*" class="mt-1 w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-salon-accent focus:border-salon-accent sm:text-sm">
                                    <p class="text-xs text-gray-500 mt-1">You can select multiple images.</p>
                                    
                                    {% if service.images %}
                                    <div class="mt-3 flex flex-wrap gap-3">
                                        {% for img in service.images %}
                                            <div x-data="{ removed: false }" x-show="!removed" class="relative group h-20 w-20">
                                                <img src="{{ img }}" class="h-20 w-20 object-cover rounded-lg shadow-sm border border-gray-200">
                                                <input type="hidden" name="existing_images[]" value="{{ img }}" :disabled="removed">
                                                <button type="button" @click="removed = true" title="Remove Image" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full p-1 shadow-md hover:bg-red-600 focus:outline-none opacity-0 group-hover:opacity-100 transition-opacity">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                </button>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse rounded-b-xl border-t border-gray-100">
                    <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-salon-dark text-base font-medium text-white hover:bg-salon-navy focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-salon-dark sm:ml-3 sm:w-auto sm:text-sm">
                        {% if service.id %}Save Changes{% else %}Create Service{% endif %}
                        <svg class="animate-spin ml-2 h-4 w-4 text-white htmx-indicator hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </button>
                    <button type="button" @click="open = false; setTimeout(() => $dispatch('close-modal'), 300)" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
